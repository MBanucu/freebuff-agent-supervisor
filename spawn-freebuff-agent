#!/usr/bin/env bash
# Spawn and inspect parallel Freebuff agents, one git worktree per agent.
#
# What this wraps:
#   1. create a git worktree and branch from a base;
#   2. write the task brief to .task.md in the worktree;
#   3. start Freebuff in a detached tmux session at 180x55 (the TUI does not
#      enter raw input mode in smaller panes);
#   4. wait until the TUI accepts input, then send the short "read .task.md"
#      prompt;
#   5. status/list/attach/stop/send against the live session;
#   6. optionally watch for the agent's .agent-result and stop the session.
#
# The agent is told to commit, push and open the PR. This tool never commits
# and never touches the main worktree.
#
# Map. The file is one unit (Install says copy it and `chmod +x`), so this is
# the index instead of a split: one `# ---- <area> ----` banner per area, in
# file order, naming the functions it owns. No line numbers: they rot.
#
#   argv and usage:
#     usage, die, note, is_num, is_duration, valid_name
#   tmux, freebuff, stty and git discovery:
#     repo_slug, tmux_bin, freebuff_bin, stty_bin, exclude_path,
#     ensure_excludes
#   the preflight:
#     preflight_termux, preflight_pkg, preflight_hint, preflight_run,
#     preflight_die, preflight
#   the wake lock:
#     wake_lock_state, wake_lock_acquire
#   state files and refusals:
#     result_key, result_state, state_is_terminal, refusal_recorded,
#     refusal_sentence, refusal_record, clear_refusal, refusal_is_hours,
#     hours_quota, hours_panel, hours_footer, hours_source, hours_age_label,
#     hours_read, refusal_notes
#   escaping and JSON:
#     json_str, json_nullable_str, json_nullable_num, html_escape,
#     json_unescape, json_scalar, state_class, action_form, stylesheet_file,
#     pr_json_array
#   state classification and evidence:
#     sha256_hex, normalise_window, first_match, evidence_field,
#     classify_chrome, freebuff_config_dir, turn_log_path, turn_log_read,
#     turn_log_evidence, turn_log_cursor, turn_log_poll, emit_evidence,
#     classify_state, session_state, session_activity, idle_seconds
#   the brief:
#     write_task, ready_polls, ready_elapsed, ready_note, wait_ready,
#     composer_line, chat_title, composer_cleared, turn_began,
#     await_submission, brief_hash, brief_ledger_file, brief_ledger_seen,
#     brief_ledger_trim, brief_ledger_record, brief_ledger_mark_refused,
#     refuse_sent_brief, compose_brief, brief_jitter_max
#   the model picker:
#     model_norm, picker_frame, picker_entries, picker_names, picker_selected,
#     picker_price, model_hours_cost, model_state, model_footer, model_resolve,
#     picker_wait, model_choose
#   the issue mirror:
#     gh_state_color, gh_state
#   start:
#     start
#   status, list, sessions, hours and models:
#     print_explanation, launch_branch, worktree_branch, status, list_agents,
#     watcher_state, live_sessions, live_session_count, finished_live,
#     finished_live_names, sessions, hours, models
#   watch, autostop, notify, reap and gc:
#     reap, watch_run, watch, autostop, notify, gc
#   the GUI:
#     snapshot_html, gui
#   attach, send and stop:
#     attach, send, stop
#   the dispatch:
#     no functions: the --root peel, --help and the case over $cmd
set -euo pipefail

# ---- argv and usage ----
# The defaults every subcommand shares, the usage text, and the predicates
# that validate an argument before anything is created.
COLS=180
ROWS=55
PROMPT='Read the file .task.md in this directory and execute it autonomously. Do not commit .task.md, .agent-result or local.properties. Follow the PR instructions in it exactly. Do not ask questions; if blocked, open a draft PR and explain.'
RESULT_FILE='.agent-result'
# Written next to a worktree at launch: issue and slug, so a transition later
# (blocked, done, stopped) can label the right issue without asking the pane.
GH_STATE_FILE='.supervisor-gh'
# The vendor refuses a message identical to a recent one as scripted use and
# counts a strike, so every sent brief is hashed here before it is typed. The
# file lives in the repository root and the last BRIEF_LEDGER_KEEP hashes are
# kept: a brief stops counting as a duplicate once it has aged out of the
# window, so a retry next week is not blocked by today's run.
BRIEF_LEDGER='.supervisor-briefs.jsonl'
BRIEF_LEDGER_KEEP=20
# The pane is the only completion signal Freebuff offers. Markers are matched
# against the bottom lines of the visible pane only, so prose in the agent's
# scrollback cannot keep a finished session alive.
# Verified against Freebuff 0.2.38: a running turn shows `thinking...` /
# `working...` with a `■ Esc` hint in the bottom-right; `esc to interrupt` and
# the spinner glyphs are kept for other builds.
BUSY_RE='esc to interrupt|thinking\.\.\.|working\.\.\.|■ Esc|[◐◓◑◒]'
PROTECTED_RE='approval|approve|Allow once|Allow always|Run command|permission|rate limit|Can.t reach Freebuff'
# A refusal is not only the concurrent-session overlay. The vendor also
# answers a brief as a finished turn, above the resting prompt: "Freebuff did
# not send this message to the model ... the same message sent over and over
# ... counts as strike 1 today", usually with an account budget line. A
# session that shows that answer is not healthy and idle: the account was
# penalised. Keep the phrases specific enough that an agent discussing the
# policy in its own prose does not match them.
REFUSED_RE='Not enough hours|session limit|Take over to stop another session|did not send this message to the model|Scripted or automated use|sent over and over|automated account or site farming|counts as strike [0-9]+|strike [0-9]+ today|account budget|daily budget|budget (is )?(exhausted|exceeded|reached|remaining|left)|remaining budget|out of (daily )?hours|daily hours (refill|reset)'
# Only the overlay offers an Enter that takes over another live session, so
# send refuses to type into a pane carrying one of these strings.
REFUSAL_OVERLAY_RE='concurrent-session limit|session limit across CLI and Desktop|Take over to stop another session'
# The account's other refusal: no hours are left for the chosen model, so the
# brief cannot run until the daily refill or another model. Its Enter opens the
# model picker instead of submitting, and a wait for submission would sit out
# the whole --submit-timeout over a refusal that was already on screen.
HOURS_OVERLAY_RE='Not enough hours'
# A released session has no composer: its overlay offers Enter (retry with a
# model, which starts a new session) and Escape, so typed text goes into the
# overlay and is lost. send refuses it instead of typing (#121).
RELEASED_OVERLAY_RE='This session was released|Choose a model to start a new session'
# Freebuff's trust gate runs in the plain terminal before the TUI mounts: a
# worktree with .agents/ (or an mcp.json) prints this and waits. The resting
# prompt cannot appear while it is open, so the readiness wait must name it
# instead of spending --ready-timeout. It is a user decision about running
# repository-supplied code; start never answers it.
TRUST_PROMPT='Load and run these?'
# A refusal is written here as well as to .supervisor.log. The file is what
# keeps status at refused after the sentence has scrolled away; stop removes
# it, so a refusal lasts until the session is explicitly stopped.
REFUSAL_FILE='.refusal'
# Every hours=N/M observation appends one line here, so the last reading
# outlives the session that showed it (#108):
#   ts=<epoch> hours=N/M source=panel|footer session=fb-X
# A reading from the ledger is always shown with its age, never as current.
HOURS_LEDGER='.supervisor-hours'
# Scrollback read for an hours line: the overlay sits above the resting
# prompt, and the footer is the last line.
HOURS_WINDOW=40
# Set by hours_read: the value and source of the reading, its age in seconds
# (0 for a live read, the ledger age otherwise) and whether it was read from
# the pane this run. FRESH=0 means the value came from the ledger.
HOURS_VALUE=''
HOURS_AGE=''
HOURS_SOURCE=''
HOURS_FRESH=0
# Turn text sits above the visible prompt, so refusal detection reads this
# many lines of scrollback rather than the 12-line chrome window.
REFUSAL_WINDOW=40
# No rule matching a pane used to fall through to `working`, which made new
# vendor chrome indistinguishable from a live turn. It is now `unknown`, but
# only once the same normalised window has been seen twice: a boot frame or a
# mid-repaint changes between scans and is not evidence of a new state.
UNKNOWN_RESCAN_DELAY=0.4
# Readiness gate: the TUI accepts the brief only once it is in raw mode and
# draws its resting prompt. A cold first launch in a fresh worktree pays for
# the banner, the trust prompt and the session scan, which outran the old
# fixed 45s gate, so the default deadline is generous and both values are
# per-start flags. A warm pane is ready on the first check and pays no poll.
READY_TIMEOUT=120
READY_POLL=0.5
# Note the wait every this many polls, so a slow launch leaves a trace in
# .supervisor.log instead of looking like a hang.
READY_NOTE_POLLS=10
# A readiness check can fail hard instead of being "not raw yet": tmux names
# no tty for the pane, or the stty binary is missing or cannot read that tty
# (toybox stty without -F, a pty the user cannot open). Those do not clear on
# their own, so after this many consecutive failures the wait names the fault
# instead of burning every poll in --ready-timeout. A cold start that has a
# tty but is not raw yet still gets the whole deadline.
READY_FAILS=3
# Set by wait_ready: seconds spent polling, and on a hard failure why the pane
# never became ready, the exact stty command, the tty and stty's error, for
# the log and the failure line.
READY_ELAPSED=0.0
READY_REASON=''
READY_STTY=''
READY_TTY=''
READY_ERROR=''
# A ready TUI can still swallow the Enter: the brief lands in the composer and
# is never submitted, the composer clears, and the session rests at the idle
# prompt looking healthy. So the Enter is not proof. After typing, start waits
# for the input line to clear and for a turn to begin (or the chat title to
# change) with the same poll-with-deadline shape as the readiness gate. The
# brief is never retyped automatically: a swallowed send is reported as
# sent=no with the pane, not doubled.
SUBMIT_TIMEOUT=20
# Set by await_submission: the signal that proved the send and the time it took.
SUBMIT_PROOF=''
SUBMIT_ELAPSED=0.0
# The /model picker (#125). The client has no --model flag, no environment
# override and no per-worktree setting: its model is one config key that the
# TUI's `/model` picker writes, so the picker is the only per-session switch.
# Its aid line is what says the frame is open; an entry's name line carries
# `•` and the line under it carries the only per-model price the client
# prints (`2x` for a model whose hour costs two, a phrase with no multiplier
# for one that spends none). Every step is read back from the pane.
MODEL_PICKER_AID='choose model'
MODEL_PICKER_TIMEOUT=15
MODEL_PICKER_POLL=0.5
# Up to this many arrow keys before the walk is called stuck. The real list is
# a few screens long, so this is a runaway guard, not a limit on the list.
MODEL_PICKER_STEPS=40
# Set by model_resolve: the entry --model named, its price line, and why a
# name matched nothing. Set by model_choose: the seconds the switch took.
MODEL_RESOLVED=''
MODEL_PRICE=''
MODEL_ERROR=''
# Set by model_resolve: whether the name matched several entries. Ambiguity is
# not absence, so the scroll search must not walk the list over it.
MODEL_AMBIGUOUS=0
# The last pane captured by model_frame_get, which is the frame the search and
# the walk both read.
MODEL_FRAME=''
PICKER_ELAPSED=0
# Preflight: `freebuff --version` must answer inside this many seconds, or the
# start says so instead of waiting out the readiness gate. A client that exists
# but cannot execute (the glibc binary on bionic Termux, #89) is the failure
# #98 is about, so the probe runs the command rather than testing -x.
PREFLIGHT_TIMEOUT=5

usage() {
    cat <<'USAGE'
Spawn parallel Freebuff agents in isolated git worktrees.

  spawn-freebuff-agent start --issue N [options]
      Create .worktrees/<name> on a new branch, write .task.md, and launch
      Freebuff in tmux session fb-<name> at 180x55.

      --issue N          GitHub issue number (required)
      --name NAME        worktree/session name (default: issue-N)
      --branch BRANCH    new branch (default: issue/N)
      --base REF         base ref (default: main)
      --task-file FILE   use a custom brief instead of the generic one
      --title TEXT       issue title (otherwise read with gh)
      --url URL          issue URL (otherwise read with gh)
      --sdk-dir DIR      write sdk.dir into local.properties
      --auto-stop        stop fb-<name> after the agent finishes
      --idle-seconds N   idle window for --auto-stop (default: 120)
      --poll N           watcher poll interval in seconds (default: 5)
      --ready-timeout N  seconds to wait for the TUI to take raw input
                         (default: 120); a cold first launch can need more
                         than the old fixed 45s
      --ready-poll N     seconds between readiness checks (default: 0.5)
      --trust-agents     pass --trust-agents to Freebuff, which loads this
                         worktree's .agents files and mcp.json without
                         asking. It trusts repository-supplied code with
                         your permissions, so it is opt-in and never a
                         default; the vendor's own help describes it as
                         "for CI", not a general answer to every prompt.
                         Without it, a launch that stops at the trust
                         prompt fails at once and names the directory.
      --submit-timeout N seconds after the Enter to see the turn begin or the
                         chat title change (default: 20); a brief that never
                         proves submission is reported as sent=no and the
                         session is stopped, never retyped
      --max-sessions N   refuse to start while N fb-* sessions are live
      --wait-slot [N]    wait up to N seconds (default: 300) for a free slot
                         instead of failing; requires --max-sessions
                         With N > 1, each send is jittered by a random delay
                         so a burst does not reach the TUI in one second.
      --no-start         create the worktree and brief, do not launch
      --prompt TEXT      send this message instead of the default brief
      --model NAME       choose this model in the TUI before the brief is
                         typed: an exact picker name, or a unique
                         case-insensitive substring of one (`fast` is
                         `DeepSeek V4.1 Flash Fast`). The client has no flag
                         for it, so its /model picker is driven and the
                         footer is read back before a key of the brief is
                         sent. The run prints model=<name>
                         price=<free|Nx|paid|daily>; `free` means the picker
                         printed no hour multiplier under that entry, so the
                         session spends none of the daily budget, while
                         `paid` and `daily` are a Paid plan and a per-day
                         session cap. A name the frame does not draw is
                         found by scrolling the list. An ambiguous or
                         unknown name fails before anything is sent.
      --no-gh            do not label or comment on the issue
      --no-check         skip the preflight that names a missing tmux,
                         freebuff, stty or git before anything is created
                         (FREEBUFF_SKIP_PREFLIGHT=1 does the same)
      --wake-lock        ask Termux for a partial wake lock before tmux starts,
                         so a run can outlive the screen; optional and never
                         fatal, recorded in .supervisor.log and never released
                         (FREEBUFF_WAKE_LOCK=1 does the same)
      --dry-run          print the plan, change nothing
      --help             this text

  spawn-freebuff-agent status NAME [--lines N] [--no-gh] [--json] [--explain]
                              [--source pane|log|auto] [--window N]
      Show the session, input mode, result state, pane tail, branch, last
      commit and PR. model=<name> hours=<free|Nx|paid|daily> is the model
      the run was launched with, absent when it chose none. hours=N/M is
      this run's reading of the account usage;
      when the pane carries none, the last ledger line is shown with its age
      (hours=N/M age=47m), and no history at all is hours=-.
      --lines N   pane lines to show (default: 25)
      --no-gh     do not ask gh for the PR
      --json      emit the same fields as one JSON object, plus an evidence
                  object naming the source, the rule, the matched line and
                  the window, and turn_state/turn_outcome from the turn log
      --explain   print the classification decision line by line: every
                  marker checked and the pane or turn log the rule looked at
      --source S  where the state comes from: pane (default) reads the
                  terminal, log reads the client's per-chat turn log and
                  reports turn_state=working|finished|failed with
                  turn_outcome=lastMessage|error, auto prefers the log and
                  falls back to the pane when it has no verdict
      --window N  pane lines the classifier reads (default: 40)

  spawn-freebuff-agent list
      List worktrees with session state, running flag and idle time.

  spawn-freebuff-agent sessions [--no-gh] [--json]
      One table over every fb-* session and every worktree: live state, idle
      time, attached autostop watcher, whether a worktree exists, the result
      state, the branch, the open PR, the model the run was launched with
      (`Name (free)`, `Name (2x)` or -), the wake lock recorded at start and
      the last account hours reading (N/M for a live read, N/M age=47m for
      the .supervisor-hours ledger, - when there is neither).
      Sessions with no worktree are listed here instead of only being
      reapable by plain gc. --json emits the same rows as an array of
      objects, with the model as its own object ({name, hours}).

  spawn-freebuff-agent hours [NAME] [--json]
      Read the remaining Freebuff hour budget from a live pane: the welcome
      panel's `N/M hours remaining` first, then the fraction in the footer
      next to the model (`DeepSeek V4.1 Flash 10/17 • high`). NAME defaults
      to any live fb-* session. The value is an observation with an age (the
      seconds since the pane last changed), never an estimate.
      --json      emit the same fields as one JSON object
      Prints hours=unknown and exits 2 when no live pane can be read.

  spawn-freebuff-agent models [NAME] [--free] [--json]
      List the models the client offers, read from a live session's /model
      picker: one `model=<name> hours=<free|2x|paid|daily>` line each, where
      `free` means the entry carries no hour multiplier, so a session on it
      spends none of the daily budget. The client has no catalog command, so
      the picker is the catalog: it is opened with /model, walked to the end
      of the list (the frame draws one page and the arrow keys scroll it) and
      closed with Escape, leaving the session as it was. Nothing is
      submitted, so listing spends no hours. NAME defaults to any live fb-*
      session. Prints model=none and exits 1 when there is no live session,
      and refuses to type into a working or refused one.
      --free      only the entries that carry no hour multiplier: the list a
                  launch should pick from when the account's hours are short
      --json      emit the same rows as one JSON object

  spawn-freebuff-agent gui --snapshot FILE [--watch N] [--no-gh]
      Write one self-contained HTML page from `sessions --json`: one card
      per session with done-versus-working visible at a glance and the model
      it was launched with, with its cost class, beside the hours reading.
      No server, no script, no external assets, so it opens from file://
      offline.
      --watch N   rewrite the file every N seconds (adds a meta refresh)
      --no-gh     do not ask gh for the PR

  spawn-freebuff-agent gui --serve [--port N] [--host H] [--token T] [--read-only]
                              [--allow-host NAME] [--ttyd [--interactive]]
      Serve the dashboard and JSON API from python3's standard library:
      GET / is the --snapshot page, GET /api/sessions is `sessions --json`
      verbatim and GET /api/session/<name>/pane is `status --json`. POST
      /api/session/<name>/stop[?graceful=1], /api/session/<name>/send (JSON
      {"text": ...}) and /api/gc[?dry=1] run the matching CLI command and
      answer 202 with its key=value output. The served page carries Stop and
      gc forms that post to those routes; a form submission is
      cookie-authenticated, so it must carry the page nonce, passes an Origin
      check, and a successful stop answers 303 See Other to / (gc to the
      report). Binds 127.0.0.1:7788 by default;
      a non-loopback host is refused unless --token is given. Without --token
      one is generated and printed once. Every POST needs the token even on
      loopback; --read-only answers them 403. Only loopback Host names (and
      --host) are served; a foreign Host is 421, so a rebinding name gets
      nothing. --allow-host adds a name a proxy keeps, repeatable. No TLS:
      put a reverse proxy in front for LAN or Tailscale access.
      --ttyd          add a terminal link per session; GET /tty/<name> starts
                      one loopback ttyd of `tmux attach -t fb-<name>` on
                      demand and redirects to it. Read-only unless
                      --interactive, which adds ttyd's -W.
      --interactive   let the browser type into the agent; refused with
                      --read-only

  spawn-freebuff-agent attach NAME
      Attach to the tmux session (detach with Ctrl-b d).

  spawn-freebuff-agent send NAME TEXT
      Send a follow-up message to a running agent. `send NAME -- TEXT` passes
      text that starts with a dash. It refuses a pane on the
      concurrent-session, hours or released-session overlay instead of typing
      into it.

  spawn-freebuff-agent watch NAME [--idle-seconds N] [--poll N] [--timeout N]
      Report working/idle/done/blocked/failed/refused/unknown/missing
      transitions. Exits 0 when the agent is done or the pane has been idle
      past the window, 1 on timeout, 2 when the session is gone, 3 when the
      agent reported blocked and 4 when it reported failed. Never stops
      anything.

  spawn-freebuff-agent autostop NAME [--idle-seconds N] [--poll N] [--timeout N]
      Watch, then stop fb-<name> and record the run evidence. This is what
      start --auto-stop runs detached. A done, blocked or failed result stops
      the session; the exit status is watch's (0, 3 or 4).

  spawn-freebuff-agent notify NAME
      Report the next turn end from the client's per-chat log.jsonl: a
      turn end is an earlier signal than .agent-result, not a replacement for
      it. Each call reads from a cursor in the worktree and advances it, so a
      turn fires once; the first call arms the cursor at the end of the log
      and reports nothing, so history is not replayed. A complete start/end
      pair prints event=turn-end with turn_state=finished|failed and
      turn_outcome=lastMessage|error; otherwise event=none with a reason.
      Missing chat directory or log.jsonl prints reason=no-turn-log and
      exits 2. It never sends, stops or waits.

  spawn-freebuff-agent stop NAME [--graceful [--wait N]]
      Kill the tmux session; the worktree and branch are left in place.
      --graceful sends Escape, waits up to N seconds (default: 20) for the turn
      to end, then stops, recording the pane state. It refuses to kill a
      session that is still working when the wait expires.

  spawn-freebuff-agent gc [--idle-hours N] [--prune-worktrees] [--dry-run]
      Stop finished sessions, sessions idle past N hours (default: 12),
      sessions stuck on the concurrent-session overlay, and fb-* sessions
      whose worktree no longer exists. Busy and approval panes are skipped.
      --prune-worktrees also prints the git worktree remove / git branch -d
      command for each stopped session except a refused one; it never runs
      the command. Worktrees and branches are never removed. --all is still
      accepted, but a worktree-less session is stopped by plain gc now.

Environment:
  FREEBUFF_BIN        freebuff executable (default: freebuff on PATH)
  FREEBUFF_TMUX       tmux executable (default: tmux on PATH, then nix-shell)
  FREEBUFF_STTY       stty executable for the raw-mode check (default: stty on
                      PATH); point it at GNU stty if the PATH one has no -F
  FREEBUFF_START_JITTER  upper bound in seconds for the random delay before a
                         send when --max-sessions allows several (default:
                         2N; 0 disables the wait)
  FREEBUFF_TTYD       ttyd executable for gui --ttyd (default: ttyd on PATH)
  FREEBUFF_WAKE_LOCK  1 acquires the Termux wake lock for every start, like
                      --wake-lock
  FREEBUFF_SUPERVISOR_ROOT  repository root override (tests)
  GH_BIN              gh executable (default: gh on PATH)

Notes:
  - The TUI needs a 180x55 pane. Smaller panes stay in canonical mode and
    silently ignore the prompt; this tool waits for -icanon before sending,
    re-checking every --ready-poll seconds for up to --ready-timeout.
  - A worktree that carries .agents/ (or an mcp.json) makes Freebuff print
    `Load and run these? [y/N]` before the TUI mounts. start stops at once,
    types nothing and names the directory: answer `y` once in an interactive
    launch there to record the trust, or rerun start with --trust-agents.
  - A wait that gives up names the timeout it used, prints the last pane
    lines and records elapsed seconds in .supervisor.log, so a slow cold
    launch is distinguishable from a hung TUI.
  - --model drives the client's own /model picker. There is no client flag,
    environment override or per-worktree setting for the model, so start
    types /model, moves the `›` marker with the arrow keys the frame prints,
    and presses Enter only once that marker sits on the chosen name. The
    footer must then name the model, or the launch fails with no brief sent
    and the session stopped. The choice and its cost class are recorded in
    .supervisor.log, and status, sessions and the GUI card report them. The
    switch writes the client's global model setting, so two launches that
    want different models must not run at the same moment.
  - A ready pane can still swallow the Enter. After typing, start waits for
    the input line to clear and for the turn to begin (or the chat title to
    change) and prints sent=yes with the signal that proved it. A send that
    never proves submission prints sent=no with the pane, stops the session
    and exits non-zero; the brief is not retyped.
  - A running agent runs shell commands with its normal approvals. Do not
    attach and type while it is working.
  - Every hours=N/M observation is appended to .supervisor-hours, one line
    per read, so status and sessions can still show the last account usage
    after the session that showed it is gone. A ledger reading is always
    labelled with its age; a number without an age came from this run.
  - A brief is hashed into .supervisor-briefs.jsonl (last 20 kept) before it
    is typed; a repeat inside that window is a hard error and sends nothing,
    because Freebuff treats a repeated message as scripted use and counts a
    strike against the account. A brief the vendor refused is marked in the
    same ledger, kept past the window and never sent again.
  - A refusal (the concurrent-session or hours overlay, or the vendor's
    anti-automation answer in the turn text) is recorded in
    .worktrees/<name>/.refusal and .supervisor.log. start prints refused=yes,
    or refused=hours with hours=N/M when the panel shows the account's usage,
    plus a hint naming the next step, and exits non-zero; an overlay gets no
    keys at all, and status keeps refused until stop clears it.
  - --wake-lock runs termux-wake-lock once, after the preflight and before
    tmux new-session, and records wake_lock=acquired|unavailable|failed in
    .supervisor.log. It is never fatal: without the binary the run starts
    unprotected and says so. The tool never releases the lock, because it is
    service-scoped: stop on one session would unlock every session and the
    GUI. It dies with the Termux app, keeps the CPU awake while held and costs
    battery; release it yourself with termux-wake-unlock. status and sessions
    report the value recorded at start, not a claim that it is still held.
  - Completion is either the agent's .agent-result file (stock brief) or an
    idle pane after the window; the pane heuristic is tied to the TUI.
  - The tool never deletes a worktree or branch. Use git worktree remove and
    git branch -D explicitly when the PR is done.
USAGE
}

die() {
    printf 'spawn-freebuff-agent: %s\n' "$*" >&2
    exit 1
}

note() {
    printf '%s\n' "$*"
}

is_num() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

is_duration() {
    # is_duration VALUE -> 0 for a positive number of seconds. Decimals are
    # allowed because --ready-poll defaults to 0.5 and sleep accepts fractions
    # on every target; zero is refused so a poll cannot busy-loop.
    case "${1:-}" in
        ''|*[!0-9.]*|*.*.*) return 1 ;;
        *[1-9]*) return 0 ;;
        *) return 1 ;;
    esac
}

valid_name() {
    case "${1:-}" in
        ''|*[!A-Za-z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

# ---- tmux, freebuff and git discovery ----
# Where tmux, freebuff, the repository slug and the worktree excludes come
# from: the only places that look outside this file for the environment.
repo_slug() {
    local url
    url=$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)
    [ -n "$url" ] || return 0
    printf '%s' "$url" |
        sed -E 's#^git@github\.com:##; s#^https://github\.com/##; s#\.git$##'
}

tmux_bin() {
    local cache path
    if [ -n "${FREEBUFF_TMUX:-}" ]; then
        printf '%s' "$FREEBUFF_TMUX"
        return 0
    fi
    if command -v tmux >/dev/null 2>&1; then
        command -v tmux
        return 0
    fi
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/wireless-adb-keeper/tmux.path"
    if [ -x "$cache" ]; then
        cat "$cache"
        return 0
    fi
    if command -v nix-shell >/dev/null 2>&1; then
        path=$(nix-shell -p tmux --run 'command -v tmux' 2>/dev/null | tail -n 1 || true)
        if [ -n "$path" ] && [ -x "$path" ]; then
            mkdir -p "$(dirname "$cache")" 2>/dev/null || true
            printf '%s' "$path" >"$cache" 2>/dev/null || true
            printf '%s' "$path"
            return 0
        fi
    fi
    return 1
}

freebuff_bin() {
    if [ -n "${FREEBUFF_BIN:-}" ]; then
        printf '%s' "$FREEBUFF_BIN"
        return 0
    fi
    if command -v freebuff >/dev/null 2>&1; then
        command -v freebuff
        return 0
    fi
    if [ -x "$HOME/.local/bin/freebuff" ]; then
        printf '%s' "$HOME/.local/bin/freebuff"
        return 0
    fi
    return 1
}

stty_bin() {
    # The raw-mode check uses GNU stty's -F. Termux ships it in coreutils, but
    # a PATH that prefers /system/bin gives toybox instead, so the binary is
    # overridable like tmux and freebuff rather than assumed.
    if [ -n "${FREEBUFF_STTY:-}" ]; then
        printf '%s' "$FREEBUFF_STTY"
        return 0
    fi
    command -v stty 2>/dev/null
}

exclude_path() {
    local common
    common=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null || true)
    [ -n "$common" ] || common="$ROOT/.git"
    case "$common" in
        /*) ;;
        *) common="$ROOT/$common" ;;
    esac
    printf '%s/info/exclude' "$common"
}

ensure_excludes() {
    local file entry
    file=$(exclude_path)
    mkdir -p "$(dirname "$file")"
    for entry in '.worktrees/' '.task.md' 'local.properties' "$RESULT_FILE" \
        '.supervisor.log' "$GH_STATE_FILE" "$BRIEF_LEDGER" "$HOURS_LEDGER"; do
        grep -qxF "$entry" "$file" 2>/dev/null || printf '%s\n' "$entry" >>"$file"
    done
}

# ---- the preflight ----
# What start needs before it spends a worktree. A missing command used to be
# found late: freebuff after the worktree was created, and a client that exists
# but cannot execute (the glibc binary on bionic Termux) as a 120-second
# wait_ready timeout instead of the loader error that caused it (#98). One
# `preflight=<command>` line per check names the missing command and the line
# that installs it, before anything is created.
preflight_termux() {
    # Termux detection for the hint only: PREFIX is set by the app's shell and
    # termux-wake-lock is a Termux package, so either identifies the phone.
    if [ -n "${PREFIX:-}" ]; then
        return 0
    fi
    command -v termux-wake-lock >/dev/null 2>&1
}

preflight_pkg() {
    # preflight_pkg COMMAND -> the Termux package that provides it. Only the
    # names that differ need a case: `pkg install python` is python3 and stty
    # ships inside coreutils (docs/termux.md section 3).
    case "${1:-}" in
        python3) printf 'python' ;;
        stty) printf 'coreutils' ;;
        *) printf '%s' "${1:-}" ;;
    esac
}

preflight_hint() {
    # preflight_hint COMMAND -> the install line a user can act on. On Termux
    # that is a package, except for freebuff, which is not a Termux package at
    # all (docs/termux.md section 6), so it always names the override. Elsewhere
    # tmux names FREEBUFF_TMUX and the rest name the plain install.
    local cmd=${1:-} var=''
    case "$cmd" in
        tmux) var=FREEBUFF_TMUX ;;
        freebuff) var=FREEBUFF_BIN ;;
    esac
    if [ "$cmd" != freebuff ] && preflight_termux; then
        printf 'pkg install %s' "$(preflight_pkg "$cmd")"
        return 0
    fi
    if [ -n "$var" ]; then
        printf 'install %s or set %s' "$cmd" "$var"
    else
        printf 'install %s' "$cmd"
    fi
}

preflight_run() {
    # preflight_run SECONDS CMD... -> CMD's status, or 124 when it outlives
    # SECONDS. `timeout` is not on every target (macOS ships it as gtimeout)
    # and the tool may not gain a dependency, so this is the poll-with-a-
    # deadline shape of wait_ready in tenths of a second.
    local secs=$1 pid rc=0 ticks i=0
    shift
    "$@" </dev/null >/dev/null 2>&1 &
    pid=$!
    ticks=$((secs * 10))
    while kill -0 "$pid" 2>/dev/null; do
        if [ "$i" -ge "$ticks" ]; then
            kill "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            return 124
        fi
        i=$((i + 1))
        sleep 0.1
    done
    wait "$pid" || rc=$?
    return "$rc"
}

preflight_die() {
    # preflight_die NAME -> the instruction the late failure used, so a caller
    # sees the same wording it did before and the preflight line above it says
    # which check failed and how to install it.
    case "${1:-}" in
        tmux) die 'start: tmux not found; install tmux or set FREEBUFF_TMUX' ;;
        freebuff) die 'start: freebuff not found; set FREEBUFF_BIN' ;;
        stty) die 'start: stty not found; install stty' ;;
        git) die 'start: git not found; install git' ;;
        *) die "start: ${1:-} not found" ;;
    esac
}

preflight() {
    # preflight COMMAND... -> one `preflight=<command> ...` line per check and
    # a final `preflight=ok`. tmux, freebuff, stty and git are fatal when
    # missing; gh, python3 and ttyd are only needed by the mode that names
    # them, so their miss is reported with optional=yes and the run goes on.
    # freebuff is probed by running --version, so a file that exists but cannot
    # execute is an error with its exit status, not a timeout later. Every
    # check runs before the caller is told to stop, so one run shows the whole
    # environment instead of one missing command per attempt.
    local name path rc optional hint timeout
    local missing='' fb_path='' fb_rc='' fb_timeout=''
    timeout=${FREEBUFF_PREFLIGHT_TIMEOUT:-$PREFLIGHT_TIMEOUT}
    is_num "$timeout" || timeout=$PREFLIGHT_TIMEOUT
    for name in "$@"; do
        optional=0
        case "$name" in
            gh|python3|ttyd) optional=1 ;;
        esac
        case "$name" in
            tmux) path=$(tmux_bin 2>/dev/null || true) ;;
            freebuff) path=$(freebuff_bin 2>/dev/null || true) ;;
            gh) path=$(command -v "${GH_BIN:-gh}" 2>/dev/null || true) ;;
            *) path=$(command -v "$name" 2>/dev/null || true) ;;
        esac
        if [ -z "$path" ]; then
            hint=$(preflight_hint "$name")
            if [ "$optional" = 1 ]; then
                note "preflight=$name missing=$name hint=$hint optional=yes"
            else
                note "preflight=$name missing=$name hint=$hint"
                missing="${missing:+$missing }$name"
            fi
            continue
        fi
        if [ "$name" = freebuff ]; then
            rc=0
            preflight_run "$timeout" "$path" --version || rc=$?
            if [ "$rc" -eq 124 ]; then
                fb_path=$path
                fb_timeout=$timeout
                note "preflight=freebuff error=timeout path=$path timeout=${timeout}s"
                continue
            fi
            if [ "$rc" -ne 0 ]; then
                fb_path=$path
                fb_rc=$rc
                note "preflight=freebuff error=exit_$rc path=$path"
                continue
            fi
        fi
        note "preflight=$name ok path=$path"
    done
    if [ -n "$missing" ] || [ -n "$fb_path" ]; then
        note 'preflight=failed'
        if [ -n "$missing" ]; then
            preflight_die "${missing%% *}"
        fi
        if [ -n "$fb_timeout" ]; then
            die "start: freebuff at $fb_path did not answer --version in ${fb_timeout}s; set FREEBUFF_BIN to a client that runs (see docs/termux.md)"
        fi
        die "start: freebuff at $fb_path exits $fb_rc, so it cannot run (a glibc binary on bionic Termux reports its missing loader this way); set FREEBUFF_BIN to a runnable client (see docs/termux.md)"
    fi
    note 'preflight=ok'
}

# ---- the wake lock ----
# The opt-in Termux partial wake lock (#99). With the screen off, Doze can
# suspend the CPU and Android can reap the app, which takes the detached tmux
# server, the autostop watcher and `gui --serve` with it; a wake lock is the
# operator's mitigation, and the tool can ask for one. It only asks and
# records the answer: termux-wake-lock has no status query, so nothing here
# can claim the lock is still held.
wake_lock_state() {
    # wake_lock_state WORKTREE -> the last value start recorded, empty when no
    # start asked for a lock. This is evidence of what was acquired at launch,
    # not a live status.
    local wt=$1 value
    value=$(grep -o 'wake_lock=[a-z]*' "$wt/.supervisor.log" 2>/dev/null |
        tail -n 1 | cut -d= -f2 || true)
    printf '%s' "$value"
}

wake_lock_acquire() {
    # wake_lock_acquire WORKTREE -> 0 when termux-wake-lock ran, 1 when it is
    # missing or failed. Never fatal: a phone without the binary still runs,
    # unprotected, and one line says which part is missing. The tool never
    # releases the lock: it is service-scoped, so `stop` on one session would
    # unlock every session and the GUI.
    local wt=$1 bin rc=0
    if bin=$(command -v termux-wake-lock 2>/dev/null); then
        "$bin" >/dev/null 2>&1 || rc=$?
        if [ "$rc" -eq 0 ]; then
            ready_note "$wt" 'wake_lock=acquired'
            return 0
        fi
        ready_note "$wt" 'wake_lock=failed'
        note "wake_lock=failed: $bin exited $rc; the session is not protected from Doze"
        return 1
    fi
    ready_note "$wt" 'wake_lock=unavailable'
    note 'wake_lock=unavailable: termux-wake-lock is not installed; the session is not protected from Doze (pkg install termux-tools)'
    return 1
}

# ---- state files and refusals ----
# The result file, the recorded refusal and the terminal states: what a run
# says about itself without reading the pane.
result_key() {
    # result_key FILE KEY -> value, empty when absent
    local value
    value=$(grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2- || true)
    printf '%s' "${value%$'\r'}"
}

result_state() {
    # result_state WORKTREE -> done|blocked|failed|unknown, empty without a file
    local file="$1/$RESULT_FILE" state
    [ -f "$file" ] || return 0
    state=$(result_key "$file" state)
    case "$state" in
        done|blocked|failed) printf '%s' "$state" ;;
        *) printf 'unknown' ;;
    esac
}

state_is_terminal() {
    # state_is_terminal STATE -> 0 when the run is over and the session can no
    # longer take a turn. Idle time is meaningless there: a done card reading
    # `idle 5495s` is a contradiction, not a clock (#57). `refused` is not in
    # this set: stop clears the refusal and the pane is still live.
    case "${1:-}" in
        done|blocked|failed|stopped) return 0 ;;
    esac
    return 1
}

refusal_recorded() {
    # refusal_recorded WORKTREE -> the recorded refusal sentence, empty when
    # the session has not been refused. This survives the pane: the vendor's
    # answer scrolls away while the account stays penalised.
    local file="$1/$REFUSAL_FILE"
    [ -f "$file" ] || return 0
    head -n 1 "$file" 2>/dev/null | tr -d '\r' || true
}

refusal_sentence() {
    # refusal_sentence TEXT -> every line of TEXT that matches a refusal,
    # joined into one line. The anti-automation answer is wrapped prose, so
    # matching lines are what names the refusal without recording the pane.
    local text=${1-} line out=''
    while IFS= read -r line; do
        printf '%s' "$line" | grep -qiE "$REFUSED_RE" || continue
        line=$(printf '%s' "$line" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')
        [ -n "$line" ] || continue
        out+="${out:+ }$line"
    done <<<"$text"
    printf '%s' "$out"
}

refusal_record() {
    # refusal_record WORKTREE SENTENCE -> persist the state and the evidence.
    # The sentence goes to .supervisor.log (not the pane), and .refusal is
    # what keeps status at refused until stop clears it.
    local wt="$1" sentence="$2"
    [ -d "$wt" ] || return 0
    printf '%s\n' "$sentence" >"$wt/$REFUSAL_FILE"
    printf 'refused at=%s sentence=%s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$sentence" >>"$wt/.supervisor.log"
}

clear_refusal() {
    # clear_refusal WORKTREE -> stop is the only thing that clears a refusal
    local wt="$1"
    [ -d "$wt" ] || return 0
    rm -f "$wt/$REFUSAL_FILE"
}

refusal_is_hours() {
    # refusal_is_hours SENTENCE -> 0 for the hours overlay, which is a refusal
    # with its own next step instead of the concurrent-session one.
    printf '%s\n' "${1-}" | grep -qiE "$HOURS_OVERLAY_RE"
}

hours_quota() {
    # hours_quota PANE -> the `N/M` usage the hours panel draws when it shows
    # one, empty otherwise. Only a fraction on a line that mentions hours
    # counts: the model line already carries a date-like `10/17`.
    printf '%s\n' "${1-}" | grep -i 'hour' |
        grep -oE '[0-9]+(\.[0-9]+)?/[0-9]+' | tail -n 1 || true
}

hours_panel() {
    # hours_panel PANE -> the `N/M` from the welcome panel's
    # `N/M hours remaining` line, empty otherwise. The phrase is required, so
    # a fraction in a sentence about hours is not read as the budget.
    printf '%s\n' "${1-}" |
        grep -iE '[0-9]+(\.[0-9]+)?/[0-9]+[[:space:]]+hours?[[:space:]]+remaining' |
        grep -oE '[0-9]+(\.[0-9]+)?/[0-9]+' | tail -n 1 || true
}

hours_footer() {
    # hours_footer PANE -> the `N/M` the footer draws next to the model, such
    # as `DeepSeek V4.1 Flash 10/17 • high`; empty otherwise. The fraction has
    # to sit next to the `•` separator, so the date-like fraction elsewhere in
    # the footer's chat title is not read as a budget.
    printf '%s\n' "${1-}" |
        grep -E '[0-9]+(\.[0-9]+)?/[0-9]+[[:space:]]+•' |
        grep -oE '[0-9]+(\.[0-9]+)?/[0-9]+' | tail -n 1 || true
}

hours_source() {
    # hours_source PANE -> `panel` when the reading sits in the hours overlay,
    # `footer` when the TUI drew the usage in its resting chrome instead.
    if printf '%s\n' "${1-}" | grep -qiE "$HOURS_OVERLAY_RE"; then
        printf 'panel'
    else
        printf 'footer'
    fi
}

hours_age_label() {
    # hours_age_label SECONDS -> a compact age for a cached reading: 47s, 47m,
    # 3h, 2d. A cached number is only ever shown with this beside it.
    local secs=${1:-0}
    if [ "$secs" -lt 60 ]; then
        printf '%ss' "$secs"
    elif [ "$secs" -lt 3600 ]; then
        printf '%sm' "$((secs / 60))"
    elif [ "$secs" -lt 86400 ]; then
        printf '%sh' "$((secs / 3600))"
    else
        printf '%sd' "$((secs / 86400))"
    fi
}

hours_read() {
    # hours_read SESSION PANE -> 0 when there is an hours reading to show, 1
    # when neither the pane nor the ledger has one. A fraction in the pane is
    # the reading: it is appended to the ledger and HOURS_FRESH=1 marks it as
    # current, so the caller does not have to print an age for it. Otherwise
    # the ledger's last line is used with its age, which is what keeps a
    # stale value from being read as current. HOURS_VALUE/AGE/SOURCE carry
    # the result; AGE is 0 for a live read and empty when nothing was found.
    local session=${1-} pane=${2-} line ts
    HOURS_VALUE=''
    HOURS_AGE=''
    HOURS_SOURCE=''
    HOURS_FRESH=0
    HOURS_VALUE=$(hours_quota "$pane")
    if [ -n "$HOURS_VALUE" ]; then
        HOURS_SOURCE=$(hours_source "$pane")
        ts=$(date +%s)
        printf 'ts=%s hours=%s source=%s session=%s\n' \
            "$ts" "$HOURS_VALUE" "$HOURS_SOURCE" "$session" \
            >>"$ROOT/$HOURS_LEDGER" 2>/dev/null || true
        HOURS_AGE=0
        HOURS_FRESH=1
        return 0
    fi
    line=$(grep '^ts=[0-9][0-9]* hours=[^ ]* source=[^ ]*' \
        "$ROOT/$HOURS_LEDGER" 2>/dev/null | tail -n 1 || true)
    [ -n "$line" ] || return 1
    ts=$(printf '%s\n' "$line" | sed -n 's/^ts=\([0-9][0-9]*\) .*/\1/p')
    HOURS_VALUE=$(printf '%s\n' "$line" |
        sed -n 's/^ts=[0-9][0-9]* hours=\([^ ]*\) .*/\1/p')
    HOURS_SOURCE=$(printf '%s\n' "$line" |
        sed -n 's/^ts=[0-9][0-9]* hours=[^ ]* source=\([^ ]*\) .*/\1/p')
    if [ -z "$ts" ] || [ -z "$HOURS_VALUE" ]; then
        HOURS_VALUE=''
        HOURS_SOURCE=''
        return 1
    fi
    HOURS_AGE=$(($(date +%s) - ts))
    [ "$HOURS_AGE" -ge 0 ] || HOURS_AGE=0
    return 0
}

refusal_notes() {
    # refusal_notes SENTENCE PANE TMUX SESSION -> the refusal lines start
    # prints. Every refusal is `refused=` plus the sentence. The overlays also
    # name the next step: the hours overlay is `refused=hours` with the
    # account's N/M usage when the panel draws it and a hint naming both ways
    # out; the observed usage is also appended to the hours ledger (#108). The
    # concurrent-session overlay names the finished sessions still holding a
    # slot, because their run is already over and stopping them loses nothing.
    local refusal=${1-} pane=${2-} tmux=${3:-} session=${4-} held
    if refusal_is_hours "$refusal"; then
        note 'refused=hours'
        if [ -n "$session" ]; then
            hours_read "$session" "$pane" || true
        fi
        [ -z "$HOURS_VALUE" ] || note "hours=$HOURS_VALUE"
        held=$(finished_live_names "$tmux")
        [ -z "$held" ] || note "holding_slot=$held"
        note "hint=stop finished sessions with: $(basename "$0") gc, or wait for the daily hours to refill"
        return 0
    fi
    note 'refused=yes'
    if printf '%s\n' "$refusal" | grep -qiE "$REFUSAL_OVERLAY_RE"; then
        held=$(finished_live_names "$tmux")
        if [ -n "$held" ]; then
            note "holding_slot=$held"
            note "hint=free them with: $(basename "$0") gc"
        fi
    fi
}

# ---- escaping and JSON ----
# The escapers and emitters: JSON strings and numbers, HTML text, page
# classes, action forms and the JSON PR array.
json_str() {
    # json_str STRING -> a quoted JSON string. Session names are already
    # restricted by valid_name, so only values need escaping: a pane carries
    # tabs, newlines and CR from tmux, and prose may carry quotes and
    # backslashes. This is not a general JSON writer, only a string escaper for
    # values this tool produces. Byte-wise in the C locale so a multibyte glyph
    # is re-emitted unchanged instead of being split.
    local s=${1-} out='' c i
    local LC_ALL=C
    for ((i = 0; i < ${#s}; i++)); do
        c=${s:i:1}
        case "$c" in
            '\') out+='\\' ;;
            '"') out+='\"' ;;
            $'\n') out+='\n' ;;
            $'\r') out+='\r' ;;
            $'\t') out+='\t' ;;
            $'\b') out+='\b' ;;
            $'\f') out+='\f' ;;
            [[:cntrl:]])
                printf -v c '\\u%04x' "'$c"
                out+=$c
                ;;
            *) out+=$c ;;
        esac
    done
    printf '"%s"' "$out"
}

json_nullable_str() {
    # json_nullable_str VALUE -> "value", or null for empty and for the `-`
    # placeholder the human views print for "not applicable"
    if [ -n "${1:-}" ] && [ "$1" != '-' ]; then
        json_str "$1"
    else
        printf 'null'
    fi
}

json_nullable_num() {
    # json_nullable_num VALUE -> a bare number, or null when it is not one
    if is_num "${1:-}"; then
        printf '%s' "$1"
    else
        printf 'null'
    fi
}

html_escape() {
    # html_escape STRING -> text that cannot leave its element. Branch names,
    # PR URLs, commit subjects and result text are arbitrary, so every value
    # in the snapshot goes through here; session names are constrained but
    # are escaped too so no value is trusted.
    local s=${1-}
    # The ampersands are backslash-quoted: bash 5.2 replaces an unquoted `&`
    # in a substitution's replacement with the matched text.
    s=${s//&/\&amp;}
    s=${s//</\&lt;}
    s=${s//>/\&gt;}
    s=${s//\"/\&quot;}
    s=${s//\'/\&#39;}
    printf '%s' "$s"
}

json_unescape() {
    # json_unescape STRING -> the decoded content of a JSON string, for
    # display. Only the escapes json_str emits are decoded; a \uXXXX sequence
    # is left as written, which is safe because html_escape runs afterwards.
    local s=${1-} out='' c i
    for ((i = 0; i < ${#s}; i++)); do
        c=${s:i:1}
        if [ "$c" = '\' ] && [ $((i + 1)) -lt ${#s} ]; then
            i=$((i + 1))
            c=${s:i:1}
            case "$c" in
                n|r|t) c=' ' ;;
                b|f) c='' ;;
                '"'|'\'|'/') ;;
                *) c='\'$c ;;
            esac
        fi
        out+=$c
    done
    printf '%s' "$out"
}

json_scalar() {
    # json_scalar VALUE -> a decoded value, empty for null
    local v=${1-}
    [ "$v" != null ] || return 0
    case "$v" in
        \"*\")
            v=${v:1:${#v}-2}
            json_unescape "$v"
            return 0
            ;;
    esac
    printf '%s' "$v"
}

state_class() {
    # state_class STATE -> a CSS class, so only known words reach the markup
    case "${1:-}" in
        done) printf 'done' ;;
        working) printf 'working' ;;
        idle|stopped) printf 'idle' ;;
        refused) printf 'refused' ;;
        blocked|failed) printf 'failed' ;;
        *) printf 'other' ;;
    esac
}

action_form() {
    # action_form NONCE ACTION LABEL -> one server-rendered POST form.
    # The nonce is the server's CSRF secret: a cookie-authenticated POST has
    # no other way to prove the form came from this page. No script, so a
    # stray click is the only risk left, and the stop routes answer with a
    # confirmation page before they act.
    local nonce=$1 action=$2 label=$3
    printf '<form method="post" action="%s">' "$(html_escape "$action")"
    printf '<input type="hidden" name="nonce" value="%s">' \
        "$(html_escape "$nonce")"
    printf '<button type="submit">%s</button></form>' "$(html_escape "$label")"
}

stylesheet_file() {
    # stylesheet_file -> gui/page.css next to the tool. It is the one
    # stylesheet: this renderer inlines it into the snapshot, and
    # gui/server.py inlines the same file into the stop confirmation and the
    # action-result page. Resolved from $0, not ROOT, because the asset ships
    # with the tool rather than with the repository it inspects.
    local dir
    case "$0" in
        */*) dir=$(cd -- "$(dirname -- "$0")" && pwd) ;;
        *) dir=$(cd -- "$(dirname -- "$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")")" && pwd) ;;
    esac
    printf '%s/gui/page.css' "$dir"
}

pr_json_array() {
    # pr_json_array "pr=#N URL TITLE" lines -> [{number,url,title}, ...]
    # The human `pr=` lines already carry all three, so nesting them loses
    # nothing. Empty input is [] rather than null: null means gh was not asked.
    local line number url title first=1
    printf '['
    while IFS=$'\t' read -r number url title; do
        case "$number" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$first" = 1 ] || printf ', '
        first=0
        printf '{"number": %s, "url": %s, "title": %s}' \
            "$number" "$(json_str "$url")" "$(json_str "${title:-}")"
    done <<<"$(printf '%s\n' "${1:-}" |
        sed -E 's/^pr=#([0-9]+) ([^ ]+)( (.*))?$/\1\t\2\t\4/')"
    printf ']'
}

# ---- state classification and evidence ----
# The pane rules, the evidence block they produce, and the read-only activity
# clock that says how long a session has been quiet.
sha256_hex() {
    # sha256_hex -> a hex digest of stdin, from the first tool present. Only
    # stability matters (the same window must hash the same twice), so cksum
    # is a last resort on a machine with none of the hash tools.
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | cut -d' ' -f1
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 | sed 's/^.*= //'
    else
        cksum | cut -d' ' -f1
    fi
}

normalise_window() {
    # normalise_window (stdin) -> text a repaint cannot change: no ANSI, no
    # padding, no clocks. Box-drawing rules are dropped because a redraw can
    # reflow them; their content lines stay. Two captures of one unclassified
    # pane hash the same even when the spacing or the elapsed time differs.
    local LC_ALL=C
    sed -E \
        -e $'s/\x1b\\][^\x07]*\x07//g' \
        -e $'s/\x1b\\[[0-9;?]*[A-Za-z]//g' \
        -e 's/\r$//' \
        -e 's/[[:space:]]+/ /g' \
        -e 's/^ //' -e 's/ $//' \
        -e 's/[0-9]+(\.[0-9]+)?(ms|s|m|h)([^0-9A-Za-z]|$)/<time>\3/g' \
        -e 's/(^|[^0-9])[0-9][0-9]?:[0-9][0-9](:[0-9][0-9])?/\1<time>/g' \
        | sed -E '/^[─━═╭╮╰╯│┃├┤┬┴┼╔╗╚╝║╠╣╦╩╬ ]*$/d'
}

first_match() {
    # first_match REGEX TEXT -> the first matching line, trimmed; empty on none
    local line
    line=$(printf '%s\n' "$2" | grep -m1 -iE -- "$1" 2>/dev/null || true)
    line=${line%$'\r'}
    line=$(printf '%s' "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
    printf '%s' "$line"
}

evidence_field() {
    # evidence_field BLOCK KEY -> the first KEY= value in an evidence block
    local block="$1" key="$2" line
    while IFS= read -r line; do
        case "$line" in
            "$key"=*) printf '%s' "${line#"$key"=}"; return 0 ;;
        esac
    done <<<"$block"
}

# classify_chrome fills these, so a rescan can reuse one rule table.
PANE_STATE=''
PANE_RULE=''
PANE_MATCHED=''
PANE_CHECKS=''

classify_chrome() {
    # classify_chrome PANE CHROME -> sets PANE_STATE (empty when nothing
    # matched), PANE_RULE, PANE_MATCHED and the checks that were run. The
    # order is the tool's existing precedence; only the terminal fallback
    # changed.
    local pane="$1" chrome="$2" matched
    PANE_STATE=''
    PANE_RULE=''
    PANE_MATCHED=''
    PANE_CHECKS=''

    # The refusal can be the turn text above the resting prompt, not just the
    # 12-line chrome window, so scan enough scrollback to see the answer.
    matched=$(first_match "$REFUSED_RE" "$pane")
    PANE_CHECKS+="check: refusal-prose: $([ -n "$matched" ] && printf yes || printf no)"
    if [ -n "$matched" ]; then
        PANE_STATE=refused
        PANE_RULE=refusal-prose
        PANE_MATCHED=$matched
        return 0
    fi

    matched=$(first_match "$BUSY_RE" "$chrome")
    PANE_CHECKS+=$'\n'"check: busy-marker pattern=\"$BUSY_RE\": $([ -n "$matched" ] && printf yes || printf no)"
    if [ -n "$matched" ]; then
        PANE_STATE=working
        PANE_RULE=busy-marker
        PANE_MATCHED=$matched
        return 0
    fi

    # The resting prompt means no turn is running, so it outranks the
    # protected strings: the startup `Can't reach Freebuff` banner lands in the
    # same 12-line window and would otherwise pin a finished session at
    # `working` forever, which is the leak this tool exists to prevent.
    matched=$(first_match 'Enter a coding task' "$chrome")
    PANE_CHECKS+=$'\n'"check: resting-prompt pattern=\"Enter a coding task\": $([ -n "$matched" ] && printf yes || printf no)"
    if [ -n "$matched" ]; then
        PANE_STATE=idle
        PANE_RULE=resting-prompt
        PANE_MATCHED=$matched
        return 0
    fi

    matched=$(first_match "$PROTECTED_RE" "$chrome")
    PANE_CHECKS+=$'\n'"check: protected-window pattern=\"$PROTECTED_RE\": $([ -n "$matched" ] && printf yes || printf no)"
    if [ -n "$matched" ]; then
        PANE_STATE=working
        PANE_RULE=protected-window
        PANE_MATCHED=$matched
        return 0
    fi
}

freebuff_config_dir() {
    # freebuff_config_dir -> the client's config root. FREEBUFF_CONFIG_DIR
    # wins, as it does in the client; otherwise the client's own default.
    printf '%s' "${FREEBUFF_CONFIG_DIR:-${HOME:-}/.config/manicode}"
}

turn_log_path() {
    # turn_log_path NAME -> the newest chat's log.jsonl, or nothing. The
    # client names the project directory basename(cwd), so the worktree name
    # is the project name; worktree names here are unique, which is what keeps
    # two checkouts from sharing one project directory. The newest chat is the
    # one whose run-state.json or chat-messages.json was written last, because
    # the client rewrites those at every message boundary.
    local name="$1" chats newest
    chats="$(freebuff_config_dir)/projects/$(basename -- "$ROOT/.worktrees/$name")/chats"
    [ -d "$chats" ] || return 0
    newest=$(ls -1t "$chats"/*/run-state.json "$chats"/*/chat-messages.json \
        2>/dev/null | head -n 1 || true)
    if [ -n "$newest" ]; then
        newest=$(dirname -- "$newest")
    else
        newest=$(ls -1dt "$chats"/*/ 2>/dev/null | head -n 1 || true)
        newest=${newest%/}
    fi
    [ -n "$newest" ] || return 0
    [ -f "$newest/log.jsonl" ] || return 0
    printf '%s' "$newest/log.jsonl"
}

turn_log_read() {
    # turn_log_read LOG -> tab-separated "start end outcome startline endline".
    # A turn starts at `Sending message with sdk run config` and ends at
    # `Main prompt finished`, whose data.outputType is the outcome. Only a
    # complete JSON line counts, so a half-written final line is ignored and
    # picked up on the next read instead of being guessed at.
    awk '
        /\}[[:space:]]*$/ && index($0, "Main prompt finished") {
            end = NR; endline = $0
            outcome = $0
            sub(/.*"outputType"[[:space:]]*:[[:space:]]*"/, "", outcome)
            if (outcome != $0) { sub(/".*/, "", outcome) } else { outcome = "" }
        }
        /\}[[:space:]]*$/ && index($0, "Sending message with sdk run config") {
            start = NR; startline = $0
        }
        END {
            printf "%d\t%d\t%s\t%s\t%s\n", start + 0, end + 0, outcome, startline, endline
        }
    ' "$1" 2>/dev/null || true
}

turn_log_evidence() {
    # turn_log_evidence NAME [CHECKS] -> the evidence block from the turn log.
    # `turn_state` is the start/end pair's verdict and `turn_outcome` the end's
    # outputType. `state` maps a finished turn to `idle`, because the pane
    # would rest at its prompt; `done` stays the result file's word, so the
    # log cannot claim a run succeeded. A missing chat directory is
    # `unknown`/`no-turn-log`, never an error.
    local name="$1" checks="${2:-}"
    local chats log parsed start end outcome startline endline
    local state rule matched mapped log_checks
    chats="$(freebuff_config_dir)/projects/$(basename -- "$ROOT/.worktrees/$name")/chats"
    log=$(turn_log_path "$name")
    if [ -z "$log" ]; then
        log_checks="check: turn-log ($chats): no"
        [ -z "$checks" ] || log_checks="$checks"$'\n'"$log_checks"
        printf 'state=unknown\nsource=log\nrule=no-turn-log\nmatched=\nturn_state=unknown\nturn_outcome=\nturn_log=no\nwindow_lines=0\nwindow_sha256=\nstable_scans=0\n%s\npane_begin\npane_end\n' \
            "$log_checks"
        return 0
    fi
    parsed=$(turn_log_read "$log")
    IFS=$'\t' read -r start end outcome startline endline <<<"$parsed" || true
    is_num "$start" || start=0
    is_num "$end" || end=0
    if [ "$start" -eq 0 ] && [ "$end" -eq 0 ]; then
        state=unknown
        rule=no-turn-events
        matched=''
    elif [ "$start" -gt "$end" ]; then
        state=working
        rule=turn-started
        matched=$startline
        outcome=''
    elif [ "$outcome" = error ]; then
        state=failed
        rule=turn-failed
        matched=$endline
    else
        state=finished
        rule=turn-finished
        matched=$endline
    fi
    mapped=$state
    [ "$state" != finished ] || mapped=idle
    log_checks="check: turn-log ($log): yes"
    log_checks+=$'\n'"check: turn-start (line $start): $([ "$start" -gt 0 ] && printf yes || printf no)"
    log_checks+=$'\n'"check: turn-end (line $end): $([ "$end" -gt 0 ] && printf yes || printf no)"
    [ -z "$checks" ] || log_checks="$checks"$'\n'"$log_checks"
    printf 'state=%s\nsource=log\nrule=%s\nmatched=%s\nturn_state=%s\nturn_outcome=%s\nturn_log=yes\nwindow_lines=0\nwindow_sha256=\nstable_scans=0\n%s\npane_begin\npane_end\n' \
        "$mapped" "$rule" "${matched:0:200}" "$state" "$outcome" "$log_checks"
}

turn_log_cursor() {
    # turn_log_cursor NAME -> the per-worktree cursor for the turn log. It
    # lives inside .worktrees/, which is ignored and removed with the run
    # evidence, so it is never committed and never outlives its worktree.
    printf '%s' "$ROOT/.worktrees/$1/.turn-log-cursor"
}

turn_log_poll() {
    # turn_log_poll NAME -> one turn-end event since the saved cursor, as
    # key=value lines, and advances that cursor. A turn is a complete
    # `Sending message with sdk run config` line followed by a complete
    # `Main prompt finished` line; outputType picks finished (lastMessage) or
    # failed (error), so the two outcomes stay distinct (#74).
    #
    # The first poll of a log arms the cursor at its current end instead of
    # replaying turns already on disk, so a watcher started mid-session does
    # not report history as news. Only complete lines are read: a half-written
    # final line stays in the file and is picked up once the writer finishes
    # it. There is no chat directory or no log.jsonl -> event=none with
    # reason=no-turn-log and exit 2, never a stack trace and never a hang.
    local name="$1" wt chats log cursor saved_log saved_offset size offset=0
    local ends_nl=1 line i start_idx=-1 end_idx=-1 outcome='' state=''
    local advance=0
    local -a raw=()
    local LC_ALL=C
    wt="$ROOT/.worktrees/$name"
    chats="$(freebuff_config_dir)/projects/$(basename -- "$wt")/chats"
    log=$(turn_log_path "$name")
    if [ -z "$log" ]; then
        printf 'event=none\nreason=no-turn-log\nchats=%s\n' "$chats"
        return 2
    fi
    cursor=$(turn_log_cursor "$name")
    size=$(wc -c <"$log" 2>/dev/null | tr -d ' ' || true)
    is_num "$size" || size=0

    if [ -f "$cursor" ]; then
        saved_log=$(sed -n 's/^log=//p' "$cursor" | tail -n 1)
        saved_offset=$(sed -n 's/^offset=//p' "$cursor" | tail -n 1)
        # A cursor from another chat directory, or one older than the file,
        # says nothing about this log: arm again rather than guess.
        if [ "$saved_log" = "$log" ] && is_num "$saved_offset" &&
            [ "$saved_offset" -le "$size" ]; then
            offset=$saved_offset
        else
            offset=-1
        fi
    else
        offset=-1
    fi
    if [ "$offset" -lt 0 ]; then
        printf 'log=%s\noffset=%s\n' "$log" "$size" >"$cursor"
        printf 'event=none\nreason=armed\nlog=%s\noffset=%s\n' "$log" "$size"
        return 0
    fi

    if [ "$size" -gt "$offset" ]; then
        # wc -l on the last byte says whether the writer finished the line.
        [ "$(tail -c 1 "$log" | wc -l)" -eq 1 ] || ends_nl=0
        # `read` stops before a final line the writer has not terminated, so
        # a half-written record never enters raw at all.
        while IFS= read -r line; do
            raw+=("$line")
        done < <(tail -c +"$((offset + 1))" "$log" 2>/dev/null)
    fi

    for i in "${!raw[@]}"; do
        line=${raw[$i]}
        if [ "$start_idx" -lt 0 ]; then
            case "$line" in
                *"Sending message with sdk run config"*)
                    if [[ $line == *'}' ]]; then
                        start_idx=$i
                    fi
                    ;;
            esac
            continue
        fi
        case "$line" in
            *"Main prompt finished"*)
                [[ $line == *'}' ]] || continue
                end_idx=$i
                if [[ $line =~ \"outputType\"[[:space:]]*:[[:space:]]*\"([^\"]*)\" ]]; then
                    outcome=${BASH_REMATCH[1]}
                fi
                break
                ;;
        esac
    done

    # Consume through the end of the fired turn. An unfinished turn keeps its
    # start line for the next poll; lines before any start are noise to drop.
    if [ "$end_idx" -ge 0 ]; then
        for ((i = 0; i <= end_idx; i++)); do
            advance=$((advance + ${#raw[$i]} + 1))
        done
    elif [ "$start_idx" -gt 0 ]; then
        for ((i = 0; i < start_idx; i++)); do
            advance=$((advance + ${#raw[$i]} + 1))
        done
    elif [ "$start_idx" -lt 0 ]; then
        for ((i = 0; i < ${#raw[@]}; i++)); do
            advance=$((advance + ${#raw[$i]} + 1))
        done
    fi
    if [ "$advance" -gt 0 ]; then
        printf 'log=%s\noffset=%s\n' "$log" "$((offset + advance))" >"$cursor"
    fi

    if [ "$end_idx" -ge 0 ]; then
        case "$outcome" in
            error) state=failed ;;
            lastMessage) state=finished ;;
            *) state=unknown ;;
        esac
        printf 'event=turn-end\nturn_state=%s\nturn_outcome=%s\nlog=%s\n' \
            "$state" "$outcome" "$log"
        return 0
    fi
    if [ "$start_idx" -ge 0 ]; then
        printf 'event=none\nreason=turn-running\nlog=%s\n' "$log"
        return 0
    fi
    if [ "$ends_nl" = 0 ]; then
        printf 'event=none\nreason=partial-line\nlog=%s\n' "$log"
        return 0
    fi
    printf 'event=none\nreason=no-new-turn\nlog=%s\n' "$log"
}

# The classifier's window, shared by emit_evidence and the status view.
EV_PANE=''
EV_LINES=0
EV_SHA=''

emit_evidence() {
    # emit_evidence STATE RULE MATCHED SCANS CHECKS [SOURCE] -> the evidence
    # block. The first line is `state=...` because session_state reads only
    # that; everything after it is what --explain shows line by line. `source`
    # names what produced the verdict (pane, log, result-file or refusal) and
    # is additive: the keys that were already there keep their meaning.
    local state="$1" rule="$2" matched="$3" scans="$4" checks="$5" source="${6:-pane}"
    printf 'state=%s\nsource=%s\nrule=%s\nmatched=%s\nwindow_lines=%s\nwindow_sha256=%s\nstable_scans=%s\n' \
        "$state" "$source" "$rule" "${matched:0:200}" "$EV_LINES" "$EV_SHA" "$scans"
    [ -z "$checks" ] || printf '%s\n' "$checks"
    printf 'pane_begin\n%s\npane_end\n' "$EV_PANE"
}

classify_state() {
    # classify_state NAME [WINDOW] [SOURCE] -> evidence block; line one is
    # `state=done|refused|working|idle|unknown|missing`. SOURCE is pane (the
    # default), log or auto. Read-only: captures and reads only, never sends,
    # stops or writes. A first pane scan that no rule claims is captured again
    # after a pause, and only the same normalised window twice becomes
    # `unknown`.
    local name="$1" window="${2:-$REFUSAL_WINDOW}" source="${3:-pane}"
    local session="fb-$name" wt="$ROOT/.worktrees/$name" tmux
    local sentence result pane chrome norm norm2 base_checks checks
    local has_session=0 logblock logstate
    tmux=$(tmux_bin 2>/dev/null || true)

    EV_PANE=''
    EV_LINES=0
    EV_SHA=''

    if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
        has_session=1
        checks="check: session (fb-$name): yes"
    else
        checks="check: session (fb-$name): no"
    fi

    # The pane and auto sources start from a live session. The log is a file,
    # so it still answers after the TUI is gone.
    if [ "$source" = pane ] && [ "$has_session" = 0 ]; then
        emit_evidence missing no-session '' 0 "$checks"
        return 0
    fi

    # A refusal recorded by start outranks every source: the turn ends, the
    # sentence scrolls away and the prompt comes back, but the account is
    # still penalised. stop removes the file.
    sentence=$(refusal_recorded "$wt")
    checks+=$'\n'"check: recorded-refusal ($REFUSAL_FILE): $([ -n "$sentence" ] && printf yes || printf no)"
    if [ -n "$sentence" ]; then
        emit_evidence refused recorded-refusal "$sentence" 0 "$checks" refusal
        return 0
    fi
    base_checks=$checks

    result=$(result_state "$wt")
    base_checks+=$'\n'"check: result-file ($RESULT_FILE): ${result:-no}"
    case "$result" in
        done|blocked|failed)
            # The result file names the outcome and stays the authority, so a
            # blocked or failed run must not be reported as done: a wait
            # contract built on `done` would otherwise call failure success.
            emit_evidence "$result" result-file "$result" 0 "$base_checks" result-file
            return 0
            ;;
    esac

    if [ "$source" = log ]; then
        turn_log_evidence "$name" "$base_checks"
        return 0
    fi
    if [ "$source" = auto ]; then
        logblock=$(turn_log_evidence "$name" "$base_checks")
        logstate=$(evidence_field "$logblock" turn_state)
        if [ -n "$logstate" ] && [ "$logstate" != unknown ]; then
            printf '%s\n' "$logblock"
            return 0
        fi
        # No usable turn log: fall back to the pane, naming the loser so the
        # disagreement is visible instead of silent.
        base_checks+=$'\n'"check: log-verdict: ${logstate:-unknown}"
        if [ "$has_session" = 0 ]; then
            emit_evidence missing no-session '' 0 "$base_checks"
            return 0
        fi
    fi

    EV_PANE=$("$tmux" capture-pane -p -t "$session" -S "-$window" 2>/dev/null || true)
    EV_LINES=$(printf '%s' "$EV_PANE" | awk 'END { print NR }')
    chrome=$(printf '%s\n' "$EV_PANE" | tail -n 12)
    classify_chrome "$EV_PANE" "$chrome"
    if [ -n "$PANE_STATE" ]; then
        EV_SHA=$(printf '%s\n' "$EV_PANE" | normalise_window | sha256_hex)
        emit_evidence "$PANE_STATE" "$PANE_RULE" "$PANE_MATCHED" 1 \
            "$base_checks"$'\n'"$PANE_CHECKS"
        return 0
    fi

    # Nothing claimed the first scan. A boot frame or a mid-repaint must not
    # raise `unknown`: capture again, and let a pane that settled into a known
    # state be classified by that state.
    norm=$(printf '%s\n' "$EV_PANE" | normalise_window)
    sleep "$UNKNOWN_RESCAN_DELAY"
    EV_PANE=$("$tmux" capture-pane -p -t "$session" -S "-$window" 2>/dev/null || true)
    EV_LINES=$(printf '%s' "$EV_PANE" | awk 'END { print NR }')
    chrome=$(printf '%s\n' "$EV_PANE" | tail -n 12)
    norm2=$(printf '%s\n' "$EV_PANE" | normalise_window)
    EV_SHA=$(printf '%s\n' "$norm2" | sha256_hex)
    classify_chrome "$EV_PANE" "$chrome"
    checks="$base_checks"$'\n'"$PANE_CHECKS"$'\n'"check: stable-window: $([ "$norm" = "$norm2" ] && printf yes || printf no)"
    if [ -n "$PANE_STATE" ]; then
        emit_evidence "$PANE_STATE" "$PANE_RULE" "$PANE_MATCHED" 2 "$checks"
    elif [ "$norm" = "$norm2" ]; then
        emit_evidence unknown no-rule-matched '' 2 "$checks"
    else
        # Changing but unrecognised: not enough evidence to call it unknown.
        # Keep the old safe failure mode for this scan and look again next poll.
        emit_evidence working unstable-window '' 2 "$checks"
    fi
}

session_state() {
    # session_state NAME -> done|blocked|failed|refused|working|idle|unknown|missing
    local block first
    block=$(classify_state "$1")
    first=${block%%$'\n'*}
    printf '%s' "${first#state=}"
}

session_activity() {
    # session_activity NAME -> epoch of last tmux activity; fails when unknown
    local tmux activity
    tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$tmux" ] || return 1
    activity=$("$tmux" display-message -p -t "fb-$1" '#{session_activity}' 2>/dev/null || true)
    is_num "$activity" || return 1
    printf '%s' "$activity"
}

idle_seconds() {
    # idle_seconds NAME -> non-negative seconds since tmux activity, or empty
    local activity
    activity=$(session_activity "$1" 2>/dev/null || true)
    is_num "$activity" || return 0
    local now elapsed
    now=$(date +%s)
    elapsed=$((now - activity))
    [ "$elapsed" -ge 0 ] || elapsed=0
    printf '%s' "$elapsed"
}

# ---- the brief ----
# Composing it, waiting for a ready pane, proving the send, and the hash
# ledger that refuses to type a repeat.
write_task() {
    local file="$1" slug="${2:-}" issue="$3" title="$4" url="$5" branch="$6" base="$7"
    cat >"$file" <<EOF
# Task: issue #$issue — $title

Repo: ${slug:-this repository}. Branch: \`$branch\` (based on \`$base\`).
Issue: $url
Read it with: \`gh issue view $issue${slug:+ -R $slug}\`.

## Deliverable

Implement the issue end to end in this worktree. Follow the repository's
existing conventions. Add or update the tests the change needs. Run the
relevant checks and report exactly what was run.

## Constraints

- Work only in this worktree. Do not modify the main worktree or another
  worktree.
- Do not commit \`.task.md\`, \`.agent-result\` or \`local.properties\`.
- Do not touch unrelated files.
- If you need the phone, do not reboot or lock it; read-only adb checks only.
- If blocked, commit what works and open a draft PR explaining the blocker.

## Finish

Commit with a conventional message, push \`$branch\`, and open a PR against
\`$base\` with \`gh pr create\`. The PR body must link #$issue and list what
was tested. Report the PR URL, branch, commit and tests in your final message.

As your last action, write \`.agent-result\` in this worktree root. Use one
\`key=value\` per line, no JSON:

    state=done          # done, blocked or failed
    pr=<PR URL, or none>
    commit=<short sha, or none>
    tests=<one line: what you ran>

Use \`state=blocked\` when you opened a draft PR because of a blocker and
\`state=failed\` when the branch is not usable. Write the file even when
blocked, and do not commit it.
EOF
}

ready_polls() {
    # ready_polls TIMEOUT POLL -> poll intervals that fit in TIMEOUT, rounded
    # up, so the deadline follows --ready-timeout instead of a fixed count.
    awk -v t="$1" -v p="$2" 'BEGIN {
        n = t / p; c = int(n); if (n > c) c++; if (c < 1) c = 1
        printf "%d", c
    }'
}

ready_elapsed() {
    # ready_elapsed POLLS POLL -> seconds spent polling, with one decimal so a
    # sub-second interval is visible. awk is already used for the brief ledger.
    awk -v n="$1" -v p="$2" 'BEGIN { printf "%.1f", n * p }'
}

ready_note() {
    # ready_note WORKTREE MESSAGE -> a readiness line on stdout and in
    # .supervisor.log, so a slow launch is evidence instead of silence after
    # the terminal is gone.
    local wt="$1"
    shift
    note "$*"
    [ -d "$wt" ] || return 0
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >>"$wt/.supervisor.log"
}

wait_ready() {
    # wait_ready TMUX SESSION WORKTREE TIMEOUT POLL -> 0 ready, 2 refused,
    # 3 trust prompt, 1 did not become ready. A refusal is checked first: the
    # overlay never draws the resting prompt, and typing into it would take
    # over another live session instead of starting this one. The trust prompt
    # is next: it also never reaches the resting prompt, and it is the user's
    # decision to answer. The wait is a predicate with a deadline, not a fixed
    # sleep count: it re-checks every POLL seconds until TIMEOUT has passed, so
    # a warm pane returns on the first check and a cold launch gets the whole
    # --ready-timeout budget.
    #
    # "Not raw yet" is not the only way a check can fail. If tmux names no tty,
    # or stty cannot run on the tty it named, the predicate can never become
    # true, and waiting out the deadline only hides the fault. After
    # READY_FAILS consecutive such failures the wait returns with the reason
    # in READY_REASON and the evidence in READY_ELAPSED/READY_TTY/READY_STTY/
    # READY_ERROR. A cool-down is not a hard failure: a tty that reports
    # canonical mode, or a raw pane without the resting prompt, keeps polling.
    local tmux="$1" session="$2" wt="$3" timeout="$4" poll="$5"
    local polls i=0 tty pane stty out rc fails=0 no_tty=0
    polls=$(ready_polls "$timeout" "$poll")
    # Resolved once, before the first check, so the happy path pays no lookup.
    stty=$(stty_bin 2>/dev/null || true)
    READY_REASON=''
    READY_STTY=''
    READY_TTY=''
    READY_ERROR=''
    while :; do
        if ! "$tmux" has-session -t "$session" 2>/dev/null; then
            READY_ELAPSED=$(ready_elapsed "$i" "$poll")
            READY_REASON=no-session
            return 1
        fi
        tty=$("$tmux" display-message -p -t "$session" '#{pane_tty}' 2>/dev/null || true)
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        if printf '%s\n' "$pane" | grep -qiE "$REFUSED_RE"; then
            READY_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 2
        fi
        if printf '%s\n' "$pane" | grep -qF "$TRUST_PROMPT"; then
            # The prompt is open and nothing else will be drawn. Return on the
            # first check; start names the directory and both ways to proceed.
            READY_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 3
        fi
        if [ -z "$tty" ]; then
            no_tty=$((no_tty + 1))
            fails=0
            if [ "$no_tty" -ge "$READY_FAILS" ]; then
                READY_ELAPSED=$(ready_elapsed "$i" "$poll")
                READY_REASON=no-tty
                return 1
            fi
        else
            no_tty=0
            # stdout and stderr share one capture: on failure stty writes the
            # error and nothing else, and on success the settings are what
            # the -icanon check needs. Newlines are flattened so one log line
            # stays one line.
            if [ -n "$stty" ]; then
                out=$("$stty" -a -F "$tty" 2>&1) && rc=0 || rc=$?
            else
                out='stty not found on PATH (set FREEBUFF_STTY)'
                rc=127
            fi
            if [ "$rc" -ne 0 ]; then
                fails=$((fails + 1))
                READY_STTY=${stty:-stty}
                READY_TTY=$tty
                READY_ERROR=${out//$'\n'/ }
                if [ "$fails" -ge "$READY_FAILS" ]; then
                    READY_ELAPSED=$(ready_elapsed "$i" "$poll")
                    READY_REASON=stty
                    return 1
                fi
            else
                fails=0
                if printf '%s' "$out" | grep -q -- '-icanon' &&
                    printf '%s' "$pane" | grep -q 'Enter a coding task'; then
                    READY_ELAPSED=$(ready_elapsed "$i" "$poll")
                    ready_note "$wt" "ready=yes elapsed=${READY_ELAPSED}s timeout=${timeout}s poll=${poll}s"
                    return 0
                fi
            fi
        fi
        i=$((i + 1))
        if [ "$i" -ge "$polls" ]; then
            READY_ELAPSED=$(ready_elapsed "$i" "$poll")
            READY_REASON=timeout
            return 1
        fi
        if [ $((i % READY_NOTE_POLLS)) -eq 0 ]; then
            ready_note "$wt" "waiting-for-ready=yes elapsed=$(ready_elapsed "$i" "$poll")s timeout=${timeout}s poll=${poll}s"
        fi
        sleep "$poll"
    done
}

composer_line() {
    # composer_line PANE -> the TUI's input line, the one carrying the `▍`
    # glyph. A brief that was never submitted is still drawn there; an empty
    # composer shows the resting or the mid-turn prompt instead.
    printf '%s\n' "$1" | grep -F '▍' | tail -n 1 || true
}

chat_title() {
    # chat_title PANE -> the `Chat: ...` label the chrome draws. A brief the
    # client accepted names the chat after the task instead of `New chat`.
    printf '%s\n' "$1" | sed -n 's/.*Chat: //p' | tail -n 1 || true
}

composer_cleared() {
    # composer_cleared PANE -> 0 when the input line is empty again. Both the
    # resting prompt and the mid-turn prompt are empty-composer chrome; the
    # typed brief still sitting in the line is not, whether the Enter was
    # swallowed or never arrived.
    local line
    line=$(composer_line "$1")
    case "$line" in
        *'Enter a coding task'*|*'Add to the current task'*) return 0 ;;
    esac
    return 1
}

turn_began() {
    # turn_began PANE -> 0 when a turn is in flight. The mid-turn composer
    # carries no busy marker but it is not a brief waiting for Enter either:
    # the README already treats `Add to the current task` as busy while a turn
    # is in flight, so it is proof that the input was submitted.
    local chrome
    chrome=$(printf '%s\n' "$1" | tail -n 12)
    if printf '%s\n' "$chrome" | grep -qiE "$BUSY_RE"; then
        return 0
    fi
    printf '%s\n' "$chrome" | grep -qF 'Add to the current task'
}

await_submission() {
    # await_submission TMUX SESSION BEFORE_TITLE TIMEOUT POLL ->
    # 0 submitted, 2 refused, 1 no proof inside TIMEOUT. The brief has already
    # been typed and Entered; this reads the pane until it can prove the send
    # was taken. Proof is the input line clearing plus either a turn in flight
    # or a changed chat title. A refusal is checked first, because its answer
    # arrives as a finished turn above the resting prompt. Nothing is retyped
    # here: a deadline that passes returns 1 and the caller reports sent=no.
    local tmux="$1" session="$2" before_title="$3" timeout="$4" poll="$5"
    local polls i=0 pane chrome title
    polls=$(ready_polls "$timeout" "$poll")
    SUBMIT_PROOF=''
    SUBMIT_ELAPSED=0.0
    while :; do
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        if printf '%s\n' "$pane" | grep -qiE "$REFUSED_RE"; then
            SUBMIT_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 2
        fi
        chrome=$(printf '%s\n' "$pane" | tail -n 12)
        if composer_cleared "$pane"; then
            if turn_began "$pane"; then
                SUBMIT_PROOF=turn-began
                SUBMIT_ELAPSED=$(ready_elapsed "$i" "$poll")
                return 0
            fi
            title=$(chat_title "$chrome")
            if [ -n "$title" ] && [ "$title" != "$before_title" ]; then
                SUBMIT_PROOF=chat-title
                SUBMIT_ELAPSED=$(ready_elapsed "$i" "$poll")
                return 0
            fi
        fi
        i=$((i + 1))
        if [ "$i" -ge "$polls" ]; then
            SUBMIT_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 1
        fi
        sleep "$poll"
    done
}

brief_hash() {
    # brief_hash TEXT -> a stable digest of the text about to be typed.
    # sha256sum is coreutils, shasum ships with macOS and cksum is the POSIX
    # last resort; the ledger is only ever read by this same tool, so a
    # weaker digest on a bare phone is enough to notice a repeat.
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "${1-}" | sha256sum | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        printf '%s' "${1-}" | shasum -a 256 | cut -d' ' -f1
    else
        printf '%s' "${1-}" | cksum | tr ' ' '-'
    fi
}

brief_ledger_file() {
    printf '%s/%s' "$ROOT" "$BRIEF_LEDGER"
}

brief_ledger_seen() {
    # brief_ledger_seen HASH -> the last ledger line carrying that hash, empty
    # when the brief was not sent inside the retained window.
    local file
    file=$(brief_ledger_file)
    [ -f "$file" ] || return 0
    grep -F "\"hash\": \"$1\"" "$file" 2>/dev/null | tail -n 1 || true
}

brief_ledger_trim() {
    # Keep the last BRIEF_LEDGER_KEEP entries, plus every entry marked refused.
    # A refused brief is never resent, so its hash has to outlive the window
    # instead of ageing out and being typed again next week.
    local file tmp
    file=$(brief_ledger_file)
    [ -f "$file" ] || return 0
    tmp="$file.tmp.$$"
    awk -v keep="$BRIEF_LEDGER_KEEP" '
        { line[NR] = $0; if ($0 ~ /"refused": true/) keepit[NR] = 1 }
        END {
            first = NR - keep + 1
            if (first < 1) first = 1
            for (i = 1; i <= NR; i++) {
                if (keepit[i] || i >= first) print line[i]
            }
        }
    ' "$file" >"$tmp"
    mv "$tmp" "$file"
}

brief_ledger_record() {
    # brief_ledger_record HASH NAME BRANCH [REFUSED] -> one JSON line, then
    # trim. REFUSED marks the text as one the vendor rejected, which the
    # ledger keeps past the window.
    local file line refused=${4:-}
    file=$(brief_ledger_file)
    mkdir -p "$(dirname "$file")"
    if [ -n "$refused" ]; then
        line=$(printf '{"at": %s, "name": %s, "branch": %s, "hash": %s, "refused": true}' \
            "$(json_str "$(date -u '+%Y-%m-%dT%H:%M:%SZ')")" \
            "$(json_str "${2:-}")" "$(json_str "${3:-}")" "$(json_str "${1:-}")")
    else
        line=$(printf '{"at": %s, "name": %s, "branch": %s, "hash": %s}' \
            "$(json_str "$(date -u '+%Y-%m-%dT%H:%M:%SZ')")" \
            "$(json_str "${2:-}")" "$(json_str "${3:-}")" "$(json_str "${1:-}")")
    fi
    printf '%s\n' "$line" >>"$file"
    brief_ledger_trim
}

brief_ledger_mark_refused() {
    # brief_ledger_mark_refused HASH NAME BRANCH -> mark the send that the
    # vendor refused. This is the same ledger as #48, not a second one: the
    # hash that was typed is the hash that must never be typed again.
    local file hash=$1 name=${2:-} branch=${3:-} tmp
    file=$(brief_ledger_file)
    mkdir -p "$(dirname "$file")"
    if [ -f "$file" ] && grep -qF "\"hash\": \"$hash\"" "$file"; then
        tmp="$file.tmp.$$"
        awk -v h="\"hash\": \"$hash\"" '
            index($0, h) && index($0, "\"refused\": true") == 0 {
                sub(/\}$/, ", \"refused\": true}")
            }
            { print }
        ' "$file" >"$tmp"
        mv "$tmp" "$file"
    else
        brief_ledger_record "$hash" "$name" "$branch" refused
    fi
    brief_ledger_trim
}

refuse_sent_brief() {
    # refuse_sent_brief HASH -> die when that text was already sent recently
    # or was refused by the vendor at any time. This runs before the worktree
    # is created, so a refusal costs no worktree and no keystroke; the earlier
    # send is named so the caller can change the brief instead of retrying.
    local seen at prev
    seen=$(brief_ledger_seen "$1")
    [ -n "$seen" ] || return 0
    at=$(printf '%s' "$seen" | sed -n 's/.*"at": "\([^"]*\)".*/\1/p')
    prev=$(printf '%s' "$seen" | sed -n 's/.*"name": "\([^"]*\)".*/\1/p')
    if printf '%s' "$seen" | grep -q '"refused": true'; then
        die "start: refusing a brief Freebuff already refused: its text was sent to ${prev:-another session} at ${at:-an earlier run} (hash $1) and rejected as scripted or automated use. A refused brief is never resent, so nothing was sent and nothing was created. Give this session different text (a different issue, name or --prompt)."
    fi
    die "start: refusing a duplicate brief: its text was already sent to ${prev:-another session} at ${at:-an earlier run} (hash $1). Freebuff refuses a repeated identical message as scripted or automated use and counts a strike, so nothing was sent and nothing was created. Give this session a different brief, name or issue, or pass a different --prompt."
}

compose_brief() {
    # compose_brief NAME BRANCH WORKTREE ISSUE PROMPT -> the text typed into
    # the TUI. It names real content (session, branch, worktree, issue) so the
    # stock brief cannot repeat; PROMPT replaces it entirely, and is then the
    # caller's job to keep unique (the ledger catches it otherwise).
    local name=$1 branch=$2 wt=$3 issue=$4 prompt=${5:-}
    if [ -n "$prompt" ]; then
        printf '%s' "$prompt"
        return 0
    fi
    local text="$PROMPT Session $name, branch $branch, worktree $wt."
    [ -z "$issue" ] || text="$text Issue #$issue."
    printf '%s' "$text"
}

# ---- the model picker ----
# `start --model` switches the model before the brief is typed. The client
# exposes no flag for it, so the picker is driven with the keys it prints and
# every step is read back: the frame, the `›` marker walking to the chosen
# name, and the footer naming that name afterwards.
model_norm() {
    # model_norm TEXT -> lower case with runs of whitespace collapsed, so
    # `--model fast` and `--model "DeepSeek V4.1 Flash Fast"` compare the same
    # way regardless of case or spacing.
    printf '%s' "${1-}" | tr '[:upper:]' '[:lower:]' |
        sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//'
}

picker_frame() {
    # picker_frame PANE -> 0 when the /model picker is on screen. No other
    # frame draws its aid line, and the hours overlay's `choose another model`
    # does not contain this phrase.
    printf '%s\n' "${1-}" | grep -qF -- "$MODEL_PICKER_AID"
}

picker_entries() {
    # picker_entries PANE -> one `yes|no<TAB>name<TAB>price` line per entry, in
    # the order the list draws them. Inside a box, the line carrying `•` is the
    # model's name and the line under it is its price; `›` marks the
    # selection. The hours panel and the section headings are drawn in boxes
    # too, so an entry with no name is skipped.
    printf '%s\n' "${1-}" | awk '
        function trim(s) { gsub(/^[[:space:]]+/, "", s); gsub(/[[:space:]]+$/, "", s); return s }
        /^[[:space:]]*┌/ { inbox = 1; name = ""; price = ""; sel = "no"; next }
        /^[[:space:]]*└/ {
            if (inbox && name != "") printf "%s\t%s\t%s\n", sel, name, price
            inbox = 0; name = ""; price = ""
            next
        }
        inbox {
            body = $0
            sub(/^[[:space:]]*│/, "", body)
            sub(/[[:space:]]*│[[:space:]]*$/, "", body)
            body = trim(body)
            if (body == "") next
            if (body ~ /^›/) { sel = "yes"; sub(/^›[[:space:]]*/, "", body) }
            if (index(body, "•") > 0) {
                n = body
                sub(/[[:space:]]*•.*$/, "", n)
                name = trim(n)
            } else if (name != "") {
                price = trim(body)
            }
        }'
}

picker_names() {
    # picker_names PANE -> the entry names, one per line, in picker order
    picker_entries "${1-}" | cut -f2
}

picker_selected() {
    # picker_selected PANE -> the name the `›` marker sits on, empty when the
    # frame carries none (a repaint, or a list that has not drawn yet)
    picker_entries "${1-}" | awk -F'\t' '$1 == "yes" { print $2; exit }'
}

picker_price() {
    # picker_price PANE NAME -> the line the picker draws under NAME, empty
    # when it draws none. It is the only per-model price the client shows.
    picker_entries "${1-}" | awk -F'\t' -v n="$2" '$2 == n { print $3; exit }'
}

model_hours_cost() {
    # model_hours_cost PRICE -> what the picker says that model costs: `2x`
    # when an hour on it costs two, `paid` for a Paid plan, `daily` for a
    # per-day session cap, and `free` when its line carries none of those, in
    # which case the session spends none of the hour budget. The line is the
    # client's own words, so the answer is read, not assumed: `2x` and `Paid
    # plan` are different costs and must not both print as free.
    local line=${1-} mult
    mult=$(printf '%s\n' "$line" | grep -oE '[0-9]+(\.[0-9]+)?x' | head -n 1 || true)
    if [ -n "$mult" ]; then
        printf '%s' "$mult"
        return 0
    fi
    if printf '%s\n' "$line" | grep -qi 'paid plan'; then
        printf 'paid'
        return 0
    fi
    if printf '%s\n' "$line" | grep -qiE 'sessions? a day|per day'; then
        printf 'daily'
        return 0
    fi
    printf 'free'
}

model_state() {
    # model_state WORKTREE -> `NAME<TAB>HOURS` for the model start recorded in
    # .supervisor.log, empty when the run chose none. The line is the one
    # `--model` writes once the footer named the choice,
    # `model=<name> price=<free|Nx|paid|daily>`; a `model=no want=...` line is
    # a launch that sent no brief, not a choice, so it is not read here. The
    # name itself carries spaces, which is why the two values are separated
    # by a tab instead of by the line's own spaces.
    local wt=$1 line name hours
    line=$(grep -E ' model=.+ price=[^ ]+' "$wt/.supervisor.log" 2>/dev/null |
        tail -n 1 || true)
    [ -n "$line" ] || return 0
    name=$(printf '%s\n' "$line" | sed -E 's/^.* model=(.*) price=[^ ]+.*$/\1/')
    hours=$(printf '%s\n' "$line" | sed -E 's/^.* price=([^ ]+).*$/\1/')
    [ -n "$name" ] || return 0
    printf '%s\t%s' "$name" "$hours"
}

model_footer() {
    # model_footer PANE -> the model name the resting footer draws, such as
    # `DeepSeek V4.1 Flash Fast` in `... • high · /model to change`. The line
    # naming the hint is the footer; the picker's own entries also say
    # `• high`, so the hint is what tells the two apart.
    local line
    line=$(printf '%s\n' "${1-}" | grep -F -- '/model to change' |
        tail -n 1 || true)
    printf '%s' "$line" | sed -E 's/^[[:space:]]*//; s/[[:space:]]*•.*$//'
}

model_resolve() {
    # model_resolve PANE WANT -> 0 with MODEL_RESOLVED and MODEL_PRICE set to
    # the entry WANT names, 1 with MODEL_ERROR saying why not. An exact name
    # wins; after that a unique case-insensitive substring is enough (`fast`).
    # Two candidates is an error that lists them: choosing one of two would
    # spend the account's hours on a guess.
    local pane=${1-} want names exact partial count
    want=$(model_norm "${2-}")
    MODEL_RESOLVED=''
    MODEL_PRICE=''
    MODEL_ERROR=''
    MODEL_AMBIGUOUS=0
    if [ -z "$want" ]; then
        MODEL_ERROR='--model is empty'
        return 1
    fi
    names=$(picker_names "$pane")
    if [ -z "$names" ]; then
        MODEL_ERROR='the picker drew no model names'
        return 1
    fi
    exact=$(printf '%s\n' "$names" | while IFS= read -r n; do
        if [ "$(model_norm "$n")" = "$want" ]; then printf '%s\n' "$n"; fi
    done)
    if [ -n "$exact" ]; then
        MODEL_RESOLVED=$exact
    else
        partial=$(printf '%s\n' "$names" | while IFS= read -r n; do
            case "$(model_norm "$n")" in
                *"$want"*) printf '%s\n' "$n" ;;
            esac
        done)
        if [ -z "$partial" ]; then
            MODEL_ERROR="no model matches '${2-}' (the picker lists: $(printf '%s' "$names" | tr '\n' ' ' | sed -E 's/ $//'))"
            return 1
        fi
        count=$(printf '%s\n' "$partial" | awk 'END { print NR }')
        if [ "$count" -gt 1 ]; then
            MODEL_AMBIGUOUS=1
            MODEL_ERROR="'${2-}' matches $count models: $(printf '%s' "$partial" | tr '\n' ' ' | sed -E 's/ $//')"
            return 1
        fi
        MODEL_RESOLVED=$partial
    fi
    MODEL_PRICE=$(picker_price "$pane" "$MODEL_RESOLVED")
    return 0
}

model_frame_get() {
    # model_frame_get TMUX SESSION -> the pane, kept in MODEL_FRAME so the
    # search and the walk read the same capture without a second one.
    MODEL_FRAME=$("$1" capture-pane -p -t "$2" 2>/dev/null || true)
}

model_search() {
    # model_search TMUX SESSION WANT -> 0 with MODEL_RESOLVED/MODEL_PRICE set
    # and the matching frame in MODEL_FRAME, 1 with MODEL_ERROR set. The frame
    # draws only what fits 55 rows, so a name that is not on screen is not
    # absent: the arrow keys scroll the list, the marker moving is what
    # reveals the entries below the fold, so the search walks down to the end
    # of the list and then back up before calling the name missing. An
    # ambiguous name is not searched for: scrolling cannot tell two apart.
    local tmux=$1 session=$2 want=$3 last='' step=0 dir=Down
    model_frame_get "$tmux" "$session"
    model_resolve "$MODEL_FRAME" "$want" && return 0
    [ "$MODEL_AMBIGUOUS" = 0 ] || return 1
    while [ "$step" -lt "$MODEL_PICKER_STEPS" ]; do
        last=$(picker_selected "$MODEL_FRAME")
        "$tmux" send-keys -t "$session" "$dir" 2>/dev/null || true
        step=$((step + 1))
        sleep "$MODEL_PICKER_POLL"
        model_frame_get "$tmux" "$session"
        model_resolve "$MODEL_FRAME" "$want" && return 0
        [ "$MODEL_AMBIGUOUS" = 0 ] || return 1
        if [ "$(picker_selected "$MODEL_FRAME")" = "$last" ]; then
            # This end of the list is reached, so the rest is above it: walk
            # back up once, then stop.
            if [ "$dir" = Down ]; then
                dir=Up
            else
                break
            fi
        fi
    done
    # Leave MODEL_ERROR naming the entries the last frame drew, so the caller
    # can print what the list did offer.
    model_resolve "$MODEL_FRAME" "$want" || true
    return 1
}

picker_wait() {
    # picker_wait TMUX SESSION TIMEOUT POLL -> 0 when the picker frame is on
    # screen, 1 when it never drew inside TIMEOUT. PICKER_ELAPSED carries the
    # seconds spent, in tenths, for the log either way.
    local tmux=$1 session=$2 timeout=$3 poll=$4 frame='' i=0 polls
    polls=$(ready_polls "$timeout" "$poll")
    while [ "$i" -lt "$polls" ]; do
        frame=$("$tmux" capture-pane -p -t "$session" 2>/dev/null || true)
        if picker_frame "$frame"; then
            PICKER_ELAPSED=$(ready_elapsed "$((i + 1))" "$poll")
            return 0
        fi
        i=$((i + 1))
        sleep "$poll"
    done
    PICKER_ELAPSED=$(ready_elapsed "$i" "$poll")
    return 1
}

model_choose() {
    # model_choose TMUX SESSION WORKTREE WANT -> 0 when the footer names the
    # chosen model, 1 when it does not, with MODEL_ERROR saying why. The keys
    # are the picker's own: `/model`, the arrow keys its aid line prints, and
    # Enter. The selection is read back after every press, so a list that
    # moved, or one that does not wrap, is followed instead of counted, and
    # Enter is pressed only once the `›` marker sits on the wanted name.
    local tmux=$1 session=$2 wt=$3 want=$4
    local frame='' selected target names cur tgt key dir='' step=0 footer
    local moved polls i norm_target
    "$tmux" send-keys -t "$session" -l '/model' 2>/dev/null || true
    sleep "$MODEL_PICKER_POLL"
    "$tmux" send-keys -t "$session" C-m 2>/dev/null || true
    if ! picker_wait "$tmux" "$session" "$MODEL_PICKER_TIMEOUT" "$MODEL_PICKER_POLL"; then
        MODEL_ERROR='/model did not open the picker'
        ready_note "$wt" "model=no want=$want reason=picker-timeout elapsed=${PICKER_ELAPSED}s session=$session"
        return 1
    fi
    # The frame draws only part of the catalog, so the search scrolls the list
    # before it calls a name absent.
    if ! model_search "$tmux" "$session" "$want"; then
        ready_note "$wt" "model=no want=$want reason=resolve elapsed=${PICKER_ELAPSED}s session=$session"
        "$tmux" send-keys -t "$session" Escape 2>/dev/null || true
        return 1
    fi
    target=$MODEL_RESOLVED
    frame=$MODEL_FRAME
    while :; do
        selected=$(picker_selected "$frame")
        [ "$(model_norm "$selected")" != "$(model_norm "$target")" ] || break
        if [ "$step" -ge "$MODEL_PICKER_STEPS" ]; then
            MODEL_ERROR="the picker never moved the selection to '$target' (it stayed on '${selected:-none}' after $MODEL_PICKER_STEPS keys)"
            ready_note "$wt" "model=no want=$want reason=selection-stuck steps=$step session=$session"
            "$tmux" send-keys -t "$session" Escape 2>/dev/null || true
            return 1
        fi
        names=$(picker_names "$frame")
        cur=$(printf '%s\n' "$names" | grep -nxF -- "${selected:-}" |
            head -n 1 | cut -d: -f1 || true)
        tgt=$(printf '%s\n' "$names" | grep -nxF -- "$target" |
            head -n 1 | cut -d: -f1 || true)
        if [ -z "$dir" ]; then
            if is_num "$cur" && is_num "$tgt" && [ "$tgt" -lt "$cur" ]; then
                dir=Up
            else
                dir=Down
            fi
        fi
        key=$dir
        "$tmux" send-keys -t "$session" "$key" 2>/dev/null || true
        step=$((step + 1))
        sleep "$MODEL_PICKER_POLL"
        frame=$("$tmux" capture-pane -p -t "$session" 2>/dev/null || true)
        moved=$(picker_selected "$frame")
        if [ "$moved" = "$selected" ]; then
            # At an end of the list: it does not wrap, so walk back instead of
            # pressing into the edge until the step guard gives up.
            case "$key" in
                Up) dir=Down ;;
                *) dir=Up ;;
            esac
        fi
    done
    "$tmux" send-keys -t "$session" C-m 2>/dev/null || true
    # The Enter is not proof: the footer is. Read it back until it names the
    # chosen model and the picker frame is gone, bounded like every other wait.
    norm_target=$(model_norm "${target%% · *}")
    polls=$(ready_polls "$MODEL_PICKER_TIMEOUT" "$MODEL_PICKER_POLL")
    i=0
    while [ "$i" -lt "$polls" ]; do
        frame=$("$tmux" capture-pane -p -t "$session" 2>/dev/null || true)
        footer=$(model_footer "$frame")
        if ! picker_frame "$frame" &&
            [ "$(model_norm "${footer%% · *}")" = "$norm_target" ]; then
            PICKER_ELAPSED=$(ready_elapsed "$((i + 1))" "$MODEL_PICKER_POLL")
            return 0
        fi
        i=$((i + 1))
        sleep "$MODEL_PICKER_POLL"
    done
    PICKER_ELAPSED=$(ready_elapsed "$i" "$MODEL_PICKER_POLL")
    MODEL_ERROR="the footer still shows '${footer:-nothing}' after Enter, not '$target'"
    ready_note "$wt" "model=no want=$want reason=footer elapsed=${PICKER_ELAPSED}s session=$session"
    return 1
}

brief_jitter_max() {
    # brief_jitter_max MAX_SESSIONS -> upper bound for the random delay before
    # a send. Only a pool of several slots is paced: one slot cannot fire two
    # starts at once. FREEBUFF_START_JITTER overrides it, 0 disables the wait.
    local max=$1 bound
    [ "${max:-0}" -gt 1 ] || {
        printf '0'
        return 0
    }
    bound=${FREEBUFF_START_JITTER:-$((max * 2))}
    is_num "$bound" || bound=0
    printf '%s' "$bound"
}

# ---- the issue mirror ----
# Moving the status:* label and leaving the one comment on the issue; every
# failure here is swallowed, so a flaky API cannot cost a run.
gh_state_color() {
    # gh_state_color STATE -> label colour, so the four states look different
    # on the issues page instead of one grey label moving around.
    case "$1" in
        working) printf 'fbca04' ;;
        blocked) printf 'd93f0b' ;;
        done) printf '0e8a16' ;;
        failed) printf 'b60205' ;;
        *) printf 'ededed' ;;
    esac
}

gh_state() {
    # gh_state WORKTREE STATE [SUMMARY] -> move the issue's status:* label to
    # STATE and, when SUMMARY is given, leave it as a comment. The session is
    # the authority; GitHub is a mirror of it, so every failure here is
    # swallowed: a flaky API must never cost a vendor slot or a worktree.
    local wt=$1 state=$2 summary=${3:-} f issue slug cur lab
    local -a args=()
    f="$wt/$GH_STATE_FILE"
    [ -f "$f" ] || return 0
    [ "${FREEBUFF_GH_SYNC:-1}" = 0 ] && return 0
    command -v "${GH_BIN:-gh}" >/dev/null 2>&1 || return 0
    issue=$(sed -n 's/^issue=//p' "$f" 2>/dev/null | head -n 1)
    slug=$(sed -n 's/^slug=//p' "$f" 2>/dev/null | head -n 1)
    [ -n "$issue" ] && [ -n "$slug" ] || return 0
    lab="status:$state"
    "${GH_BIN:-gh}" label create "$lab" -R "$slug" --force \
        --color "$(gh_state_color "$state")" --description "subagent $state" \
        >/dev/null 2>&1 || true
    # One status label at a time: the current set is read first so the others
    # can be removed without guessing whether they exist.
    cur=$("${GH_BIN:-gh}" issue view "$issue" -R "$slug" --json labels \
        --jq '[.labels[].name|select(startswith("status:"))]|join(" ")' \
        2>/dev/null || true)
    local l
    for l in $cur; do
        [ "$l" = "$lab" ] || args+=(--remove-label "$l")
    done
    "${GH_BIN:-gh}" issue edit "$issue" -R "$slug" ${args[@]+"${args[@]}"} \
        --add-label "$lab" >/dev/null 2>&1 || true
    [ -z "$summary" ] || "${GH_BIN:-gh}" issue comment "$issue" -R "$slug" \
        --body "$summary" >/dev/null 2>&1 || true
    return 0
}

# ---- start ----
# The launch: flags, worktree, brief, tmux, readiness and submission.
start() {
    local issue="" name="" branch="" base="main" title="" url="" task_file=""
    local sdk_dir="" dry=0 nostart=0 autostop=0 idle=120 poll=5 no_gh=0 no_check=0
    local wake_lock=0
    local idle_set=0 poll_set=0 max_sessions=0 wait_slot=0 slot_wait=300
    local ready_timeout="$READY_TIMEOUT" ready_poll="$READY_POLL"
    local submit_timeout="$SUBMIT_TIMEOUT" trust_agents=0
    local prompt_text="" sent brief_hash_value jitter_max jitter=0
    local model_want=""
    local ready_rc=0 submit_rc=0 pane refusal="" title_before trust_dir
    while [ $# -gt 0 ]; do
        case "$1" in
            --issue) issue=${2:-}; shift 2 ;;
            --name) name=${2:-}; shift 2 ;;
            --branch) branch=${2:-}; shift 2 ;;
            --base) base=${2:-}; shift 2 ;;
            --task-file) task_file=${2:-}; shift 2 ;;
            --title) title=${2:-}; shift 2 ;;
            --url) url=${2:-}; shift 2 ;;
            --sdk-dir) sdk_dir=${2:-}; shift 2 ;;
            --auto-stop) autostop=1; shift ;;
            --no-gh) no_gh=1; shift ;;
            --no-check) no_check=1; shift ;;
            --wake-lock) wake_lock=1; shift ;;
            --idle-seconds) idle=${2:-}; idle_set=1; shift 2 ;;
            --poll) poll=${2:-}; poll_set=1; shift 2 ;;
            --ready-timeout) ready_timeout=${2:-}; shift 2 ;;
            --ready-poll) ready_poll=${2:-}; shift 2 ;;
            --trust-agents) trust_agents=1; shift ;;
            --submit-timeout) submit_timeout=${2:-}; shift 2 ;;
            --max-sessions) max_sessions=${2:-}; shift 2 ;;
            --wait-slot)
                wait_slot=1
                case "${2:-}" in
                    ''|*[!0-9]*) shift ;;
                    *) slot_wait=$2; shift 2 ;;
                esac
                ;;
            --dry-run) dry=1; shift ;;
            --no-start) nostart=1; shift ;;
            --prompt) prompt_text=${2:-}; shift 2 ;;
            --model)
                model_want=${2:-}
                [ -n "$model_want" ] || die "start: --model must name a model"
                shift 2
                ;;
            -h|--help) usage; exit 0 ;;
            *) die "start: unsupported argument: $1" ;;
        esac
    done

    case "$issue" in
        ''|*[!0-9]*) die "start: --issue must be a number" ;;
    esac
    name=${name:-"issue-$issue"}
    branch=${branch:-"issue/$issue"}
    valid_name "$name" || die "start: name may only contain letters, digits, _ and -"
    [ -n "$branch" ] || die "start: branch is empty"
    is_num "$idle" || die "start: --idle-seconds must be a number"
    is_num "$poll" || die "start: --poll must be a number"
    is_num "$ready_timeout" || die "start: --ready-timeout must be a number of seconds"
    [ "$ready_timeout" -ge 1 ] || die "start: --ready-timeout must be at least 1 second"
    is_duration "$ready_poll" || die "start: --ready-poll must be a positive number of seconds"
    is_num "$submit_timeout" || die "start: --submit-timeout must be a number of seconds"
    [ "$submit_timeout" -ge 1 ] || die "start: --submit-timeout must be at least 1 second"
    case "$model_want" in
        *$'\n'*|*$'\t'*) die "start: --model must be one line" ;;
    esac
    if [ "$autostop" = 0 ] && { [ "$idle_set" = 1 ] || [ "$poll_set" = 1 ]; }; then
        die "start: --idle-seconds and --poll require --auto-stop"
    fi
    is_num "$max_sessions" || die "start: --max-sessions must be a number"
    if [ "$max_sessions" = 0 ] && [ "$wait_slot" = 1 ]; then
        die "start: --wait-slot needs --max-sessions N (nothing to wait for otherwise)"
    fi
    # The environment switch is for a shell that always wants the lock on a
    # phone, so every launch does not have to repeat the flag.
    [ "${FREEBUFF_WAKE_LOCK:-}" != 1 ] || wake_lock=1

    # A missing command has to be named before a worktree is spent on it, and a
    # client that exists but cannot execute must not look like a slow launch
    # (#98). The check runs for --dry-run too, so the plan is not printed for a
    # start that cannot work; --no-check and FREEBUFF_SKIP_PREFLIGHT=1 keep the
    # old late discovery for a caller that knows its environment. freebuff is
    # only needed by a launch, gh only when this run mirrors the issue.
    if [ "$no_check" = 0 ] && [ "${FREEBUFF_SKIP_PREFLIGHT:-}" != 1 ]; then
        local -a checks=(tmux stty git)
        [ "$nostart" = 1 ] || checks=(tmux freebuff stty git)
        [ "$no_gh" = 1 ] || checks+=(gh)
        preflight "${checks[@]}"
    fi

    local slug wt session result
    slug=$(repo_slug || true)
    wt="$ROOT/.worktrees/$name"
    session="fb-$name"
    result="$wt/$RESULT_FILE"
    # The brief and its identity are known before anything is created, so a
    # duplicate is a hard error rather than a spent worktree and a strike.
    sent=$(compose_brief "$name" "$branch" "$wt" "$issue" "$prompt_text")
    brief_hash_value=$(brief_hash "$sent")
    jitter_max=$(brief_jitter_max "$max_sessions")

    if [ -z "$title" ] || [ -z "$url" ]; then
        if [ -n "$slug" ] && command -v "${GH_BIN:-gh}" >/dev/null 2>&1; then
            local meta
            meta=$("${GH_BIN:-gh}" issue view "$issue" -R "$slug" \
                --json title,url --jq '[.title,.url]|@tsv' 2>/dev/null || true)
            if [ -n "$meta" ]; then
                title=${title:-${meta%%$'\t'*}}
                url=${url:-${meta#*$'\t'}}
            fi
        fi
        title=${title:-"issue #$issue"}
        url=${url:-"https://github.com/${slug:-owner/repo}/issues/$issue"}
    fi

    if [ "$dry" = 1 ]; then
        note "worktree=$wt"
        note "branch=$branch"
        note "base=$base"
        note "session=$session"
        note "task=$wt/.task.md"
        note "result=$result"
        note "brief_hash=$brief_hash_value"
        note "brief_chars=${#sent}"
        [ "$jitter_max" = 0 ] || note "jitter_max=${jitter_max}s"
        note "ready_timeout=${ready_timeout}s ready_poll=${ready_poll}s"
        note "trust_agents=$([ "$trust_agents" = 1 ] && printf yes || printf no)"
        [ -z "$model_want" ] || note "model=$model_want"
        note "submit_timeout=${submit_timeout}s"
        [ "$wake_lock" = 0 ] || note 'wake_lock=requested'
        note "tmux=${FREEBUFF_TMUX:-tmux} -x $COLS -y $ROWS -c $wt"
        if [ "$autostop" = 1 ]; then
            note "autostop=yes idle_seconds=$idle poll=$poll"
        fi
        if [ "$max_sessions" -gt 0 ]; then
            note "max_sessions=$max_sessions live=$(live_session_count) wait_slot=$wait_slot"
        fi
        return 0
    fi

    # Every session shares one account, so a launch is pointless while the
    # limit is reached: the pane stops on the overlay and never takes input.
    # Check before spending a worktree, and wait for a slot if asked.
    if [ "$max_sessions" -gt 0 ]; then
        local live deadline
        live=$(live_session_count)
        if [ "$live" -ge "$max_sessions" ]; then
            if [ "$wait_slot" = 0 ]; then
                die "start: $live fb-* session(s) already live (--max-sessions $max_sessions); stop one or pass --wait-slot"
            fi
            deadline=$(( $(date +%s) + slot_wait ))
            note "waiting-for-slot=yes live=$live max=$max_sessions timeout=${slot_wait}s"
            while [ "$live" -ge "$max_sessions" ]; do
                if [ "$(date +%s)" -ge "$deadline" ]; then
                    die "start: still $live fb-* session(s) after ${slot_wait}s; nothing was created"
                fi
                sleep 5
                live=$(live_session_count)
                note "waiting-for-slot=yes live=$live"
            done
            note "slot-free=yes live=$live"
        fi
    fi

    if [ -e "$wt" ]; then
        die "start: worktree already exists: $wt (try status $name)"
    fi
    if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
        die "start: branch already exists: $branch"
    fi
    if ! git -C "$ROOT" rev-parse --verify "$base^{commit}" >/dev/null 2>&1; then
        die "start: base ref not found: $base"
    fi

    # A brief already sent inside the ledger window is a hard error: the
    # vendor reads it as scripted use and answers with a strike. --no-start
    # sends nothing, so it has nothing to refuse.
    [ "$nostart" = 1 ] || refuse_sent_brief "$brief_hash_value"

    ensure_excludes
    mkdir -p "$ROOT/.worktrees"
    git -C "$ROOT" worktree add -b "$branch" "$wt" "$base" >/dev/null

    if [ -n "$sdk_dir" ]; then
        printf 'sdk.dir=%s\n' "$sdk_dir" >"$wt/local.properties"
    elif [ -f "$ROOT/local.properties" ]; then
        cp "$ROOT/local.properties" "$wt/local.properties"
    fi

    if [ -n "$task_file" ]; then
        [ -f "$task_file" ] || die "start: task file not found: $task_file"
        cp "$task_file" "$wt/.task.md"
    else
        write_task "$wt/.task.md" "$slug" "$issue" "$title" "$url" "$branch" "$base"
    fi

    note "created=$wt"
    note "branch=$branch"
    note "task=$wt/.task.md"
    note "result=$result"

    if [ "$nostart" = 1 ]; then
        [ -z "$model_want" ] ||
            note "model=$model_want applied=no (--no-start launches no session)"
        return 0
    fi

    local tmux fb cmd
    tmux=$(tmux_bin) || die "start: tmux not found; install tmux or set FREEBUFF_TMUX"
    fb=$(freebuff_bin) || die "start: freebuff not found; set FREEBUFF_BIN"
    # The lock is asked for after the preflight and before tmux starts, so the
    # server it is meant to protect is never launched without it. The result is
    # recorded for status and sessions; it is never fatal and never released.
    if [ "$wake_lock" = 1 ]; then
        wake_lock_acquire "$wt" || true
    fi
    # Never pass --trust-agents unless asked: it loads repository-supplied
    # agent files and mcp.json with the user's permissions. A worktree that
    # needs it says so through the trust prompt, which start reports below.
    if [ "$trust_agents" = 1 ]; then
        printf -v cmd 'TERM=xterm-256color %q --cwd %q --trust-agents' "$fb" "$wt"
    else
        printf -v cmd 'TERM=xterm-256color %q --cwd %q' "$fb" "$wt"
    fi
    "$tmux" new-session -d -s "$session" -x "$COLS" -y "$ROWS" -c "$wt" "$cmd"

    wait_ready "$tmux" "$session" "$wt" "$ready_timeout" "$ready_poll" || ready_rc=$?
    if [ "$ready_rc" -eq 2 ]; then
        # The overlay is a refusal, not a slow start. Its Enter key takes over
        # another live session, so no keys are typed at all; the worktree and
        # the sentence are kept so status reports refused until stop.
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        refusal=$(refusal_sentence "$pane")
        [ -n "$refusal" ] || refusal='Freebuff refused the launch'
        refusal_record "$wt" "$refusal"
        "$tmux" kill-session -t "$session" 2>/dev/null || true
        note "session=$session"
        refusal_notes "$refusal" "$pane" "$tmux" "$session"
        note "refusal=$refusal"
        note 'sent=no'
        die "start: Freebuff refused the launch before the brief was sent: $refusal (no keys typed; worktree kept at $wt)"
    fi
    if [ "$ready_rc" -eq 3 ]; then
        # The trust gate is a user decision about repository-supplied code.
        # Nothing is answered: name the directory and both ways to proceed,
        # then stop the session so it cannot sit on the prompt forever.
        pane=$("$tmux" capture-pane -p -t "$session" -S -15 2>/dev/null || true)
        trust_dir="$wt/.agents"
        if [ ! -d "$trust_dir" ] && [ -d "$ROOT/.worktrees/.agents" ]; then
            trust_dir="$ROOT/.worktrees/.agents"
        fi
        "$tmux" kill-session -t "$session" 2>/dev/null || true
        ready_note "$wt" "ready=trust-prompt elapsed=${READY_ELAPSED}s timeout=${ready_timeout}s poll=${ready_poll}s session=$session dir=$trust_dir"
        note "session=$session"
        note 'trust_prompt=yes'
        note "trust_dir=$trust_dir"
        note 'sent=no'
        printf '%s\n' '--- pane lines the check read ---'
        printf '%s\n' "$pane"
        if [ "$trust_agents" = 1 ]; then
            die "start: Freebuff stopped at its trust prompt for $trust_dir in $session even though --trust-agents was passed; it did not load repository-supplied agent files. No key was typed; stopped it, worktree kept ($wt)."
        fi
        die "start: Freebuff stopped at its trust prompt for $trust_dir in $session: it loads repository-supplied .agents files and mcp.json only after that directory is trusted. Answer y once in an interactive launch in $wt (freebuff --cwd $wt), or rerun start with --trust-agents to load it without asking. No key was typed; stopped it, worktree kept ($wt)."
    fi
    if [ "$ready_rc" -ne 0 ]; then
        printf '%s\n' '--- last pane lines ---'
        "$tmux" capture-pane -p -t "$session" -S -15 2>/dev/null || true
        # A pane that never reached raw input can never accept the brief, so it
        # is dead weight. Kill only the session; the worktree and branch stay.
        "$tmux" kill-session -t "$session" 2>/dev/null || true
        case "$READY_REASON" in
            stty)
                # Name the binary, the tty and its own error: a toybox stty
                # without -F, or a pty this user cannot open, is not a slow
                # cold start and must not read as one.
                ready_note "$wt" "ready=no reason=stty elapsed=${READY_ELAPSED}s timeout=${ready_timeout}s poll=${ready_poll}s session=$session tty=$READY_TTY command=$READY_STTY error=$READY_ERROR"
                die "start: raw-mode check failed in $session after ${READY_ELAPSED}s: tty=$READY_TTY command=$READY_STTY -a -F $READY_TTY error=$READY_ERROR; stopped it, worktree kept ($wt). Set FREEBUFF_STTY to a GNU stty if this one does not support -F."
                ;;
            no-tty)
                ready_note "$wt" "ready=no reason=no-tty elapsed=${READY_ELAPSED}s timeout=${ready_timeout}s poll=${ready_poll}s session=$session"
                die "start: tmux reported no pane tty for $session after ${READY_ELAPSED}s (tmux display-message -p '#{pane_tty}'); stopped it, worktree kept ($wt)."
                ;;
            no-session)
                ready_note "$wt" "ready=no reason=no-session elapsed=${READY_ELAPSED}s timeout=${ready_timeout}s poll=${ready_poll}s session=$session"
                die "start: session $session disappeared before it reached raw input after ${READY_ELAPSED}s; stopped it, worktree kept ($wt)."
                ;;
            *)
                ready_note "$wt" "ready=timeout elapsed=${READY_ELAPSED}s timeout=${ready_timeout}s poll=${ready_poll}s session=$session"
                die "start: TUI did not reach raw input in $session after ${READY_ELAPSED}s (--ready-timeout $ready_timeout, --ready-poll $ready_poll); stopped it, worktree kept ($wt). A cold first launch can need a larger --ready-timeout."
                ;;
        esac
    fi

    # The model is chosen before the brief is typed. A launch that lands on a
    # model whose hour costs two is exactly what #125 exists to stop, and the
    # picker is the only switch the client offers. A choice that cannot be
    # made or confirmed sends no brief: the session is stopped and the
    # worktree kept, like every other failed launch.
    if [ -n "$model_want" ]; then
        if ! model_choose "$tmux" "$session" "$wt" "$model_want"; then
            pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
            "$tmux" send-keys -t "$session" Escape 2>/dev/null || true
            "$tmux" kill-session -t "$session" 2>/dev/null || true
            note "session=$session"
            note "model_want=$model_want"
            note "model_error=$MODEL_ERROR"
            note 'sent=no'
            printf '%s\n' '--- pane lines the check read ---'
            printf '%s\n' "$pane"
            die "start: could not choose model '$model_want' in $session: $MODEL_ERROR. No brief was sent; stopped it, worktree kept ($wt)."
        fi
        # The picker's own price line is the answer to whether this run spends
        # hours: `free` means it printed no multiplier under the entry.
        ready_note "$wt" "model=$MODEL_RESOLVED price=$(model_hours_cost "$MODEL_PRICE") elapsed=${PICKER_ELAPSED}s session=$session"
    fi

    # A brief that is byte-identical across sessions reads as scripted use to
    # the vendor, which refuses the message and counts a strike. `sent` was
    # composed from the session, branch, worktree and issue, and its hash
    # cleared the ledger above, so this exact text has not been sent recently.
    if [ "$jitter_max" -gt 0 ]; then
        jitter=$((RANDOM % (jitter_max + 1)))
        note "jitter=${jitter}s max=${jitter_max}s"
        sleep "$jitter"
    fi
    # The chat title before the send is the baseline the proof compares
    # against; `Chat: New chat` becoming the task's name is one of the two
    # ways a swallowed Enter is told apart from an accepted one.
    title_before=$(chat_title "$("$tmux" capture-pane -p -t "$session" -S -12 2>/dev/null || true)")
    "$tmux" send-keys -t "$session" -l "$sent"
    sleep 0.5
    "$tmux" send-keys -t "$session" C-m

    # The Enter is not proof. A pane that is ready can still swallow it: the
    # composer clears and the session sits at the idle prompt with no turn,
    # which used to print started=yes. Wait for the input line to clear and
    # for the turn to begin (or the title to change), bounded by
    # --submit-timeout. Nothing is retyped: a brief that cannot be proven is
    # reported, not doubled.
    await_submission "$tmux" "$session" "$title_before" \
        "$submit_timeout" "$ready_poll" || submit_rc=$?
    if [ "$submit_rc" -eq 2 ]; then
        # The vendor's anti-automation answer arrives as a finished turn, not
        # as chrome: the sentence is above the resting prompt and the session
        # looks idle. Check the turn text before claiming the launch succeeded.
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        refusal=$(refusal_sentence "$pane")
        [ -n "$refusal" ] || refusal='Freebuff refused the brief'
        refusal_record "$wt" "$refusal"
        # Reuse the #48 ledger: this exact text was refused, so it must never
        # be typed again, even after it would have aged out of the window.
        brief_ledger_mark_refused "$brief_hash_value" "$name" "$branch"
        note "session=$session"
        refusal_notes "$refusal" "$pane" "$tmux" "$session"
        note "refusal=$refusal"
        # The overlay was already on screen at the first poll, so the window
        # was not spent: name the elapsed time that proved it.
        note "submit_elapsed=${SUBMIT_ELAPSED}s"
        note 'resent=no'
        die "start: Freebuff refused the brief: $refusal (not resent; worktree kept at $wt)"
    fi
    if [ "$submit_rc" -ne 0 ]; then
        # The brief was typed but never submitted. A session that looks alive
        # and does nothing is the failure this tool exists to prevent, so say
        # sent=no, show the pane the check read, stop the session and fail.
        # The worktree and branch stay, like every other failed launch.
        pane=$("$tmux" capture-pane -p -t "$session" -S -15 2>/dev/null || true)
        ready_note "$wt" "submit=no elapsed=${SUBMIT_ELAPSED}s timeout=${submit_timeout}s poll=${ready_poll}s session=$session"
        "$tmux" kill-session -t "$session" 2>/dev/null || true
        note "session=$session"
        note 'sent=no'
        note 'submit_proof=none'
        note "submit_elapsed=${SUBMIT_ELAPSED}s timeout=${submit_timeout}s"
        note 'resent=no'
        printf '%s\n' '--- pane lines the check read ---'
        printf '%s\n' "$pane"
        die "start: the brief did not prove submission in $session after ${SUBMIT_ELAPSED}s (--submit-timeout $submit_timeout, --ready-poll $ready_poll): the turn never began and the chat title did not change. No keys were retyped, stopped it, worktree kept ($wt)."
    fi

    # Recorded only once the send is proven, so a launch that was swallowed
    # (text nobody saw) never blocks a deliberate retry with that text.
    brief_ledger_record "$brief_hash_value" "$name" "$branch"
    ready_note "$wt" "submit=yes proof=${SUBMIT_PROOF} elapsed=${SUBMIT_ELAPSED}s timeout=${submit_timeout}s poll=${ready_poll}s session=$session"
    note "session=$session"
    note 'sent=yes'
    note "submit_proof=${SUBMIT_PROOF} elapsed=${SUBMIT_ELAPSED}s"
    note "started=yes"
    "$tmux" capture-pane -p -t "$session" -S -8 2>/dev/null || true

    # The issue number is not recoverable from a live session later (the pane
    # shows a prompt, not flags), so it is written next to the worktree here
    # and every later transition reuses it.
    if [ "$no_gh" != 1 ] && [ -n "$issue" ]; then
        printf 'issue=%s\nslug=%s\nbranch=%s\nsession=%s\n' \
            "$issue" "$slug" "$branch" "$session" >"$wt/$GH_STATE_FILE"
        gh_state "$wt" working "🤖 **subagent working** — session \`$session\`, branch \`$branch\`, worktree \`.worktrees/$name\`. The label moves to \`status:blocked\` / \`status:done\` as it runs; \`spawn-freebuff-agent status $name\` is the local view."
    fi

    if [ "$autostop" = 1 ]; then
        local script log watcher_pid
        case "$0" in
            */*) script=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
            *) script=$(command -v "$0" 2>/dev/null || printf '%s' "$0") ;;
        esac
        log="$wt/.supervisor.log"
        # setsid puts the watcher in its own session, so tearing down the
        # caller's process group (a closed terminal, a finished CI step) no
        # longer takes the watcher with it. It is optional; without it nohup
        # still ignores SIGHUP, but the watcher stays in the caller's group.
        if command -v setsid >/dev/null 2>&1; then
            setsid "$script" --root "$ROOT" autostop "$name" \
                --idle-seconds "$idle" --poll "$poll" </dev/null >>"$log" 2>&1 &
        else
            nohup "$script" --root "$ROOT" autostop "$name" \
                --idle-seconds "$idle" --poll "$poll" </dev/null >>"$log" 2>&1 &
        fi
        watcher_pid=$!
        # watcher_state greps .supervisor.log; a note on stdout would never be
        # seen by sessions or status.
        printf 'autostop=pid:%s\n' "$watcher_pid" >>"$log"
        note "autostop=pid:$watcher_pid"
        note "log=$log"
    fi
}

# ---- status, list and sessions ----
# The three read views and the inventory helpers they share.
launch_branch() {
    # launch_branch WORKTREE -> the branch the launch recorded, or empty.
    # `.supervisor-gh` is written by start when gh sync is on; `.task.md`
    # always names the branch the worktree was created on. A worktree whose
    # HEAD is detached cannot answer from git, so this is the record that keeps
    # `HEAD` out of the inventory after a retry (#121).
    local wt="$1" file branch=''
    file="$wt/$GH_STATE_FILE"
    if [ -f "$file" ]; then
        branch=$(sed -n 's/^branch=//p' "$file" | head -n 1 || true)
    fi
    file="$wt/.task.md"
    if [ -z "$branch" ] && [ -f "$file" ]; then
        branch=$(sed -n 's/^Repo: .*Branch: `\([^`]*\)`.*$/\1/p' "$file" |
            head -n 1 || true)
    fi
    printf '%s' "$branch"
}

worktree_branch() {
    # worktree_branch WORKTREE -> the branch to report. The worktree's HEAD
    # wins; a detached HEAD (rev-parse answers `HEAD`) or an unreadable one
    # falls back to the launch record, so a retry does not turn the column
    # into `HEAD` while the branch is still the one the work belongs to.
    local branch
    branch=$(git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    case "$branch" in
        ''|HEAD) branch=$(launch_branch "$1") ;;
    esac
    printf '%s' "${branch:-?}"
}

print_explanation() {
    # print_explanation BLOCK -> the classifier's decision as `explain:` lines,
    # including every marker that was checked and the pane it looked at.
    local block="$1" line win='' in_pane=0 rule
    while IFS= read -r line; do
        case "$line" in
            state=*) ;;
            source=*) printf 'explain: source=%s\n' "${line#source=}" ;;
            turn_state=*) printf 'explain: turn_state=%s\n' "${line#turn_state=}" ;;
            turn_outcome=*)
                [ -z "${line#turn_outcome=}" ] ||
                    printf 'explain: turn_outcome=%s\n' "${line#turn_outcome=}"
                ;;
            turn_log=*) printf 'explain: turn_log=%s\n' "${line#turn_log=}" ;;
            rule=*)
                rule=${line#rule=}
                printf 'explain: rule=%s\n' "$rule"
                [ "$rule" != no-rule-matched ] ||
                    printf 'explain: no rule matched the window\n'
                ;;
            matched=*)
                [ -z "${line#matched=}" ] ||
                    printf 'explain: matched=%s\n' "${line#matched=}"
                ;;
            window_lines=*) win=${line#window_lines=} ;;
            window_sha256=*)
                [ -z "${line#window_sha256=}" ] ||
                    printf 'explain: window=%s lines sha256=%s\n' \
                        "$win" "${line#window_sha256=}"
                ;;
            stable_scans=*) printf 'explain: stable_scans=%s\n' "${line#stable_scans=}" ;;
            check:*) printf 'explain: %s\n' "$line" ;;
            pane_begin) in_pane=1; printf 'explain: pane:\n' ;;
            pane_end) in_pane=0 ;;
            *) [ "$in_pane" = 0 ] || printf '  | %s\n' "$line" ;;
        esac
    done <<<"$block"
}

status() {
    # status NAME -> key=value lines by default, one JSON object with --json.
    # Both views come from the same fields: the JSON is a serialization of the
    # human output, not a second detection path. --explain adds the classifier's
    # decision line by line, from the same evidence block as --json.
    local name="" lines=25 no_gh=0 json=0 explain=0 window="$REFUSAL_WINDOW" source=pane
    while [ $# -gt 0 ]; do
        case "$1" in
            --lines) lines=${2:-}; shift 2 ;;
            --window) window=${2:-}; shift 2 ;;
            --source) source=${2:-}; shift 2 ;;
            --no-gh) no_gh=1; shift ;;
            --json) json=1; shift ;;
            --explain) explain=1; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "status: unsupported argument: $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "status: NAME is required"
    valid_name "$name" || die "status: invalid name"
    case "$lines" in
        ''|*[!0-9]*) die "status: --lines must be a number" ;;
    esac
    is_num "$window" || die "status: --window must be a number"
    case "$source" in
        pane|log|auto) ;;
        *) die "status: --source must be pane, log or auto" ;;
    esac

    local wt="$ROOT/.worktrees/$name" branch session tmux running=0 tty mode=unknown stty out
    local state rstate="" pane="" idle="" sstate="" last_commit dirty=no watcher=""
    local wake_lock="" hours="" model model_name="" model_hours=""
    local result_pr="" result_commit="" result_tests="" prs="" pr_json=null
    local evidence="" ev_rule="" ev_matched="" ev_lines="" ev_sha="" ev_scans="" ev_source=""
    local turn_evidence="" tstate="" tout="" turn_log=""
    [ -d "$wt" ] || die "status: no worktree at $wt"
    branch=$(worktree_branch "$wt")
    session="fb-$name"
    tmux=$(tmux_bin 2>/dev/null || true)

    # The turn log is a file, so it can be read with or without a session. The
    # human view shows its fields only when a source asks for it; --json always
    # carries the keys, null when there is no chat directory.
    if [ "$source" != pane ] || [ "$json" = 1 ]; then
        turn_evidence=$(turn_log_evidence "$name")
        tstate=$(evidence_field "$turn_evidence" turn_state)
        tout=$(evidence_field "$turn_evidence" turn_outcome)
        turn_log=$(evidence_field "$turn_evidence" turn_log)
        if [ "$json" = 1 ] && [ "$turn_log" != yes ]; then
            tstate=''
            tout=''
        fi
    fi

    if [ "$json" = 0 ]; then
        printf 'name=%s\nbranch=%s\nworktree=%s\nsession=%s\n' \
            "$name" "$branch" "$wt" "$session"
    fi

    state=$(result_state "$wt")
    [ -n "$state" ] || state=unknown
    watcher=$(watcher_state "$wt")
    wake_lock=$(wake_lock_state "$wt")
    # The model is what start recorded at launch, the same evidence the wake
    # lock is: a run that chose none has no line and prints no field (#136).
    model=$(model_state "$wt")
    model_name=${model%%$'\t'*}
    model_hours=${model#*$'\t'}
    if [ "$json" = 0 ]; then
        printf 'state=%s\n' "$state"
        printf 'watcher=%s\n' "$watcher"
        [ -z "$wake_lock" ] || printf 'wake_lock=%s\n' "$wake_lock"
        [ -z "$model_name" ] ||
            printf 'model=%s hours=%s\n' "$model_name" "$model_hours"
    fi
    if [ -f "$wt/$RESULT_FILE" ]; then
        rstate=$state
        result_pr=$(result_key "$wt/$RESULT_FILE" pr)
        result_commit=$(result_key "$wt/$RESULT_FILE" commit)
        result_tests=$(result_key "$wt/$RESULT_FILE" tests)
        if [ "$json" = 0 ]; then
            [ -z "$result_pr" ] || printf 'result_pr=%s\n' "$result_pr"
            [ -z "$result_commit" ] || printf 'result_commit=%s\n' "$result_commit"
            [ -z "$result_tests" ] || printf 'result_tests=%s\n' "$result_tests"
        fi
    fi

    if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
        running=1
        tty=$("$tmux" display-message -p -t "$session" '#{pane_tty}' 2>/dev/null || true)
        # raw/canonical are known only when stty can read the tty. A missing
        # tty, a missing stty or a tty stty cannot open stays unknown instead
        # of claiming canonical input the tool never observed.
        if [ -n "$tty" ]; then
            stty=$(stty_bin 2>/dev/null || true)
            if [ -n "$stty" ] && out=$("$stty" -a -F "$tty" 2>/dev/null); then
                if printf '%s' "$out" | grep -q -- '-icanon'; then
                    mode=raw
                else
                    mode=canonical
                fi
            fi
        fi
        evidence=$(classify_state "$name" "$window" "$source")
        sstate=$(evidence_field "$evidence" state)
        # Only a session that can still be idle has an idle time. The result
        # file outranks the pane, so `state` is the terminal answer even while
        # the TUI process stays alive; `session_state` carries the same verdict
        # on a branch that reports blocked and failed distinctly (#32).
        if ! state_is_terminal "$state" && ! state_is_terminal "$sstate"; then
            idle=$(idle_seconds "$name" || true)
        fi
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$lines" 2>/dev/null || true)
        if [ "$json" = 0 ]; then
            printf 'running=yes\ninput=%s\n' "$mode"
            printf 'session_state=%s\n' "$sstate"
            if [ "$source" != pane ]; then
                printf 'turn_state=%s\nturn_outcome=%s\n' "$tstate" "$tout"
            fi
            [ "$explain" = 0 ] || print_explanation "$evidence"
            [ -z "$idle" ] || printf 'idle_seconds=%s\n' "$idle"
        fi
    else
        local sentence
        if [ "$source" != pane ]; then
            # The log outlives the TUI, so a stopped session can still name
            # its last turn; auto falls back to `missing` when there is none.
            evidence=$(classify_state "$name" "$window" "$source")
            sstate=$(evidence_field "$evidence" state)
        else
            sstate=missing
            sentence=$(refusal_recorded "$wt")
            # A recorded refusal outlives the session: start stops a refused
            # launch, but status must keep saying refused until stop clears it.
            if [ -n "$sentence" ]; then
                sstate=refused
                printf -v evidence 'state=%s\nsource=refusal\nrule=recorded-refusal\nmatched=%s\nwindow_lines=0\nwindow_sha256=\nstable_scans=0\ncheck: session (fb-%s): no\ncheck: recorded-refusal (%s): yes\npane_begin\npane_end\n' \
                    "$sstate" "$sentence" "$name" "$REFUSAL_FILE"
            else
                printf -v evidence 'state=missing\nsource=pane\nrule=no-session\nmatched=\nwindow_lines=0\nwindow_sha256=\nstable_scans=0\ncheck: session (fb-%s): no\npane_begin\npane_end\n' \
                    "$name"
            fi
        fi
        if [ "$json" = 0 ]; then
            printf 'running=no\nsession_state=%s\n' "$sstate"
            if [ "$source" != pane ]; then
                printf 'turn_state=%s\nturn_outcome=%s\n' "$tstate" "$tout"
            fi
            [ "$explain" = 0 ] || print_explanation "$evidence"
        fi
    fi

    # The hours reading is the live pane when it carries one, otherwise the
    # ledger's last line with its age. A live read is what this run observed;
    # a cached one is never printed without that age (#108).
    if hours_read "$session" "$pane"; then
        if [ "$HOURS_FRESH" = 1 ]; then
            hours="hours=$HOURS_VALUE"
        else
            hours="hours=$HOURS_VALUE age=$(hours_age_label "$HOURS_AGE")"
        fi
    else
        hours='hours=-'
    fi
    if [ "$json" = 0 ]; then
        printf '%s\n' "$hours"
    fi

    last_commit=$(git -C "$wt" log -1 --oneline 2>/dev/null || true)
    if [ -n "$(git -C "$wt" status --short 2>/dev/null || true)" ]; then
        dirty=yes
    else
        dirty=no
    fi
    if [ "$json" = 0 ]; then
        printf 'commit=%s\n' "$last_commit"
        printf 'dirty=%s\n' "$dirty"
    fi

    if [ "$no_gh" = 0 ]; then
        local slug
        slug=$(repo_slug || true)
        if [ -n "$slug" ] && command -v "${GH_BIN:-gh}" >/dev/null 2>&1; then
            prs=$("${GH_BIN:-gh}" pr list -R "$slug" --head "$branch" --state open \
                --json number,url,title \
                --jq '.[] | "pr=#\(.number) \(.url) \(.title)"' 2>/dev/null || true)
            if [ -n "$prs" ]; then
                if [ "$json" = 0 ]; then
                    printf '%s\n' "$prs"
                else
                    pr_json=$(pr_json_array "$prs")
                fi
            else
                if [ "$json" = 0 ]; then
                    printf 'pr=none\n'
                else
                    pr_json='[]'
                fi
            fi
        fi
    fi

    if [ "$json" = 0 ]; then
        # --explain already dumped the classified window, so the tail is not
        # repeated; without it the human view is unchanged.
        [ "$explain" = 1 ] || [ -z "$pane" ] || printf '%s\n' "$pane"
        return 0
    fi

    # The evidence object is additive: `rule` names the decision, `matched`
    # the line behind it, and the hash names the window, so an unknown pane can
    # be compared across scans. `unknown` remains the `state` placeholder for
    # "no result file" as before; the pane classifier's unknown is
    # `session_state`.
    ev_source=$(evidence_field "$evidence" source)
    ev_rule=$(evidence_field "$evidence" rule)
    ev_matched=$(evidence_field "$evidence" matched)
    ev_lines=$(evidence_field "$evidence" window_lines)
    ev_sha=$(evidence_field "$evidence" window_sha256)
    ev_scans=$(evidence_field "$evidence" stable_scans)

    # `state` mirrors the human `state=` line, including its `unknown`
    # placeholder; `result_state` is null when there is no result file at all,
    # so a consumer can tell "nothing written yet" from "unusable state".
    printf '{\n'
    printf '  "name": %s,\n' "$(json_str "$name")"
    printf '  "branch": %s,\n' "$(json_str "$branch")"
    printf '  "worktree": %s,\n' "$(json_str "$wt")"
    printf '  "session": %s,\n' "$(json_str "$session")"
    printf '  "state": %s,\n' "$(json_str "$state")"
    printf '  "result_state": %s,\n' "$(json_nullable_str "$rstate")"
    printf '  "result_pr": %s,\n' "$(json_nullable_str "$result_pr")"
    printf '  "result_commit": %s,\n' "$(json_nullable_str "$result_commit")"
    printf '  "result_tests": %s,\n' "$(json_nullable_str "$result_tests")"
    printf '  "running": %s,\n' "$([ "$running" = 1 ] && printf true || printf false)"
    printf '  "input": %s,\n' "$(json_str "$mode")"
    printf '  "session_state": %s,\n' "$(json_str "$sstate")"
    printf '  "turn_state": %s,\n' "$(json_nullable_str "$tstate")"
    printf '  "turn_outcome": %s,\n' "$(json_nullable_str "$tout")"
    printf '  "idle_seconds": %s,\n' "$(json_nullable_num "$idle")"
    printf '  "watcher": %s,\n' "$(json_nullable_str "$watcher")"
    printf '  "wake_lock": %s,\n' "$(json_nullable_str "$wake_lock")"
    printf '  "model": {\n'
    printf '    "name": %s,\n' "$(json_nullable_str "$model_name")"
    printf '    "hours": %s\n' "$(json_nullable_str "$model_hours")"
    printf '  },\n'
    printf '  "hours": {\n'
    printf '    "value": %s,\n' "$(json_nullable_str "$HOURS_VALUE")"
    printf '    "age_seconds": %s,\n' "$(json_nullable_num "$HOURS_AGE")"
    printf '    "source": %s\n' "$(json_nullable_str "$HOURS_SOURCE")"
    printf '  },\n'
    printf '  "commit": %s,\n' "$(json_nullable_str "$last_commit")"
    printf '  "dirty": %s,\n' "$([ "$dirty" = yes ] && printf true || printf false)"
    printf '  "pr": %s,\n' "$pr_json"
    printf '  "evidence": {\n'
    printf '    "source": %s,\n' "$(json_nullable_str "$ev_source")"
    printf '    "rule": %s,\n' "$(json_nullable_str "$ev_rule")"
    printf '    "matched": %s,\n' "$(json_nullable_str "$ev_matched")"
    printf '    "window_lines": %s,\n' "$(json_nullable_num "$ev_lines")"
    printf '    "window_sha256": %s,\n' "$(json_nullable_str "$ev_sha")"
    printf '    "stable_scans": %s\n' "$(json_nullable_num "$ev_scans")"
    printf '  },\n'
    printf '  "pane": %s\n' "$(json_nullable_str "$pane")"
    printf '}\n'
}

list_agents() {
    local wt name branch session tmux running state idle activity now idle_secs
    local orphans="" orphan
    # Sessions with no worktree are not in the table below; name them so they
    # cannot be reaped by gc without ever having been seen.
    while IFS= read -r orphan; do
        [ -n "$orphan" ] || continue
        orphan=${orphan#fb-}
        [ -d "$ROOT/.worktrees/$orphan" ] ||
            orphans="${orphans:+$orphans }$orphan"
    done <<<"$(live_sessions)"

    if [ ! -d "$ROOT/.worktrees" ]; then
        note "no worktrees"
        [ -z "$orphans" ] || note "orphans=$orphans (no worktree; see sessions)"
        return 0
    fi
    tmux=$(tmux_bin 2>/dev/null || true)
    now=$(date +%s)
    printf '%-22s %-30s %-26s %-8s %-10s %s\n' \
        NAME BRANCH SESSION RUNNING STATE IDLE
    for wt in "$ROOT"/.worktrees/*; do
        [ -d "$wt" ] || continue
        name=$(basename "$wt")
        branch=$(worktree_branch "$wt")
        session="fb-$name"
        running=no
        state=unknown
        idle=-
        if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
            running=yes
            state=$(session_state "$name")
            if ! state_is_terminal "$state"; then
                activity=$(session_activity "$name" 2>/dev/null || true)
                if is_num "$activity"; then
                    idle_secs=$((now - activity))
                    [ "$idle_secs" -ge 0 ] || idle_secs=0
                    idle="${idle_secs}s"
                fi
            fi
        else
            state=$(result_state "$wt")
            [ -n "$state" ] || state=unknown
            [ -z "$(refusal_recorded "$wt")" ] || state=refused
        fi
        printf '%-22s %-30s %-26s %-8s %-10s %s\n' \
            "$name" "$branch" "$session" "$running" "$state" "$idle"
    done

    [ -z "$orphans" ] || note "orphans=$orphans (no worktree; see sessions)"
}

watcher_state() {
    # watcher_state WORKTREE -> pid:N when the recorded autostop is alive,
    # dead when it was recorded but has gone, - when no watcher ever started
    local wt="$1" pid
    pid=$(grep -o 'autostop=pid:[0-9]*' "$wt/.supervisor.log" 2>/dev/null |
        tail -n 1 | cut -d: -f2 || true)
    [ -n "$pid" ] || {
        printf '%s' '-'
        return 0
    }
    if kill -0 "$pid" 2>/dev/null; then
        printf 'pid:%s' "$pid"
    else
        printf 'dead'
    fi
}

live_sessions() {
    # live_sessions -> fb-* session names, one per line, none when tmux is gone
    local tmux
    tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$tmux" ] || return 0
    "$tmux" list-sessions -F '#{session_name}' 2>/dev/null | grep '^fb-' || true
}

live_session_count() {
    # live_session_count -> number of live fb-* sessions (0 when none)
    local count
    count=$(live_sessions | grep -c . || true)
    printf '%s' "${count:-0}"
}

finished_live() {
    # finished_live NAME [TMUX] -> 0 when the TUI is alive but its run is over.
    # The vendor counts live sessions against the concurrent-session limit, not
    # runs, so a done, blocked or failed session holds a slot that buys nothing.
    # `refused` is not in that set: stop is what clears a refusal, and the pane
    # may still be live under it.
    local name=$1 tmux=${2:-} state
    [ -n "$tmux" ] || tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$tmux" ] || return 1
    "$tmux" has-session -t "fb-$name" 2>/dev/null || return 1
    state=$(session_state "$name")
    state_is_terminal "$state"
}

finished_live_names() {
    # finished_live_names [TMUX] -> the names of live sessions that hold a
    # vendor slot for nothing, comma-separated, empty when none. That is a
    # session whose run is terminal, plus any session whose worktree is gone:
    # it has no result file left to read, and only a slot to lose. `sessions`
    # counts them and a refused `start` names them, so the next step is `gc`
    # rather than guessing which session to stop.
    local tmux=${1:-} name out=''
    [ -n "$tmux" ] || tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$tmux" ] || return 0
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        name=${name#fb-}
        if [ -d "$ROOT/.worktrees/$name" ]; then
            finished_live "$name" "$tmux" || continue
        fi
        out="${out:+$out,}$name"
    done <<<"$(live_sessions)"
    printf '%s' "$out"
}

sessions() {
    # sessions -> one table over every fb-* session and every worktree, so a
    # session with no worktree is visible before gc reaps it. --json is a
    # serialization of the same rows: one array of objects, `[]` when empty.
    local no_gh=0 json=0 name wt worktree running state idle activity now idle_secs
    local watcher wake_lock result branch pr prs="" slug="" tmux total=0 live=0 trees=0
    local pane hours model model_name model_hours model_show
    local finished=no finished_count=0
    local names=() x first=1
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=1; shift ;;
            --no-gh) no_gh=1; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "sessions: unsupported argument: $1" ;;
        esac
    done
    tmux=$(tmux_bin 2>/dev/null || true)
    now=$(date +%s)

    while IFS= read -r name; do
        [ -n "$name" ] || continue
        names+=("$name")
    done <<<"$(live_sessions | sed 's/^fb-//')"

    for wt in "$ROOT"/.worktrees/*; do
        [ -d "$wt" ] || continue
        name=$(basename "$wt")
        for x in ${names[@]+"${names[@]}"}; do
            [ "$x" = "$name" ] && continue 2
        done
        names+=("$name")
    done

    if [ ${#names[@]} -eq 0 ]; then
        if [ "$json" = 1 ]; then
            printf '[]\n'
        else
            note 'no sessions'
        fi
        return 0
    fi
    mapfile -t names < <(printf '%s\n' "${names[@]}" | LC_ALL=C sort)

    # One gh call for every branch, instead of one per row.
    if [ "$no_gh" = 0 ]; then
        slug=$(repo_slug || true)
        if [ -n "$slug" ] && command -v "${GH_BIN:-gh}" >/dev/null 2>&1; then
            prs=$("${GH_BIN:-gh}" pr list -R "$slug" --state open \
                --json headRefName,url --jq '.[] | "\(.headRefName) \(.url)"' \
                2>/dev/null || true)
        fi
    fi

    if [ "$json" = 1 ]; then
        printf '[\n'
    elif [ -n "$prs" ]; then
        printf '%-22s %-9s %-8s %-9s %-9s %-9s %-24s %-40s %-32s %s %s\n' \
            NAME STATE IDLE WATCHER WORKTREE RESULT BRANCH PR MODEL WAKE HOURS
    else
        printf '%-22s %-9s %-8s %-9s %-9s %-9s %-40s %-32s %s %s\n' \
            NAME STATE IDLE WATCHER WORKTREE RESULT BRANCH MODEL WAKE HOURS
    fi

    for name in "${names[@]}"; do
        wt="$ROOT/.worktrees/$name"
        total=$((total + 1))
        idle_secs=""
        pr=""
        wake_lock=""
        pane=""
        hours=""
        model_name=""
        model_hours=""
        model_show=-
        if [ -d "$wt" ]; then
            worktree=yes
            trees=$((trees + 1))
            branch=$(worktree_branch "$wt")
            result=$(result_state "$wt")
            [ -n "$result" ] || result=-
            watcher=$(watcher_state "$wt")
            wake_lock=$(wake_lock_state "$wt")
            # The model start recorded, with its cost class, so a mixed pool
            # can be read straight from the table (#136).
            model=$(model_state "$wt")
            model_name=${model%%$'\t'*}
            model_hours=${model#*$'\t'}
            [ -z "$model_name" ] || model_show="$model_name ($model_hours)"
        else
            worktree=missing
            branch=-
            result=-
            watcher=-
        fi
        running=no
        idle=-
        finished=no
        if [ -n "$tmux" ] && "$tmux" has-session -t "fb-$name" 2>/dev/null; then
            running=yes
            live=$((live + 1))
            state=$(session_state "$name")
            # A finished run whose TUI is still alive holds a vendor slot. The
            # count is what a refused start points at; `gc` is what frees it.
            if state_is_terminal "$state"; then
                finished=yes
                finished_count=$((finished_count + 1))
            fi
            # A finished run has no idle time, even while its TUI process is
            # still alive: null in JSON, `-` in the table, no idle on the card.
            if ! state_is_terminal "$state"; then
                activity=$(session_activity "$name" 2>/dev/null || true)
                if is_num "$activity"; then
                    idle_secs=$((now - activity))
                    [ "$idle_secs" -ge 0 ] || idle_secs=0
                    idle="${idle_secs}s"
                fi
            fi
            # The live pane is read for an hours line; a row whose session is
            # not running, or whose pane carries none, falls back to the
            # ledger and says how old that reading is (#108).
            pane=$("$tmux" capture-pane -p -t "fb-$name" -S "-$HOURS_WINDOW" 2>/dev/null || true)
        elif [ "$worktree" = yes ]; then
            state=$(result_state "$wt")
            [ -n "$state" ] || state=stopped
            [ -z "$(refusal_recorded "$wt")" ] || state=refused
        else
            state=-
        fi

        if hours_read "fb-$name" "$pane"; then
            if [ "$HOURS_FRESH" = 1 ]; then
                hours=$HOURS_VALUE
            else
                hours="$HOURS_VALUE age=$(hours_age_label "$HOURS_AGE")"
            fi
        else
            hours=-
        fi

        if [ -n "$prs" ] && [ "$branch" != '-' ]; then
            pr=$(printf '%s\n' "$prs" |
                awk -v b="$branch" '$1 == b { print $2; exit }')
        fi

        if [ "$json" = 1 ]; then
            [ "$first" = 1 ] || printf ',\n'
            first=0
            printf '  {\n'
            printf '    "name": %s,\n' "$(json_str "$name")"
            printf '    "state": %s,\n' "$(json_nullable_str "$state")"
            printf '    "idle_seconds": %s,\n' "$(json_nullable_num "$idle_secs")"
            if [ "$finished" = yes ]; then
                printf '    "finished": true,\n'
            else
                printf '    "finished": false,\n'
            fi
            printf '    "watcher": %s,\n' "$(json_nullable_str "$watcher")"
            printf '    "wake_lock": %s,\n' "$(json_nullable_str "$wake_lock")"
            printf '    "model": {\n'
            printf '      "name": %s,\n' "$(json_nullable_str "$model_name")"
            printf '      "hours": %s\n' "$(json_nullable_str "$model_hours")"
            printf '    },\n'
            printf '    "worktree": %s,\n' "$(json_str "$worktree")"
            printf '    "result": %s,\n' "$(json_nullable_str "$result")"
            printf '    "branch": %s,\n' "$(json_nullable_str "$branch")"
            printf '    "pr": %s,\n' "$(json_nullable_str "$pr")"
            printf '    "hours": {\n'
            printf '      "value": %s,\n' "$(json_nullable_str "$HOURS_VALUE")"
            printf '      "age_seconds": %s,\n' "$(json_nullable_num "$HOURS_AGE")"
            printf '      "source": %s\n' "$(json_nullable_str "$HOURS_SOURCE")"
            printf '    }\n'
            printf '  }'
        elif [ -n "$prs" ] && [ "$branch" != '-' ]; then
            [ -n "$pr" ] || pr=-
            printf '%-22s %-9s %-8s %-9s %-9s %-9s %-24s %-40s %-32s %s %s\n' \
                "$name" "$state" "$idle" "$watcher" "$worktree" "$result" \
                "$branch" "$pr" "$model_show" "${wake_lock:--}" "$hours"
        else
            printf '%-22s %-9s %-8s %-9s %-9s %-9s %-40s %-32s %s %s\n' \
                "$name" "$state" "$idle" "$watcher" "$worktree" "$result" \
                "$branch" "$model_show" "${wake_lock:--}" "$hours"
        fi
    done

    if [ "$json" = 1 ]; then
        printf '\n]\n'
    else
        printf 'sessions=%s running=%s worktrees=%s orphans=%s finished=%s\n' \
            "$total" "$live" "$trees" "$((total - trees))" "$finished_count"
    fi
}

hours() {
    # hours [NAME] [--json] -> the remaining hour budget, read from a live
    # pane. It is an observation with an age, never an estimate: the welcome
    # panel's `N/M hours remaining` wins over the footer fraction next to the
    # model, and a pane that shows neither (or no live session at all) is
    # unknown with exit 2.
    local name="" json=0 tmux="" session="" pane="" value="" source='' age='' agedisp='-'
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=1; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "hours: unsupported argument: $1" ;;
            *)
                [ -z "$name" ] || die "hours: at most one NAME"
                name=$1; shift
                ;;
        esac
    done
    if [ -n "$name" ]; then
        valid_name "$name" || die "hours: invalid name"
        session="fb-$name"
    fi
    tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$session" ] || session=$(live_sessions | head -n 1)

    if [ -n "$tmux" ] && [ -n "$session" ] &&
        "$tmux" has-session -t "$session" 2>/dev/null; then
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        value=$(hours_panel "$pane")
        if [ -n "$value" ]; then
            source=panel
        else
            value=$(hours_footer "$pane")
            [ -z "$value" ] || source=footer
        fi
        # The age is the time since tmux last saw activity, the last moment
        # the pane could have changed: the reading is at least that old. A
        # session that cannot report its activity has no age, not a zero.
        age=$(idle_seconds "${session#fb-}" 2>/dev/null || true)
        [ -z "$age" ] || agedisp="${age}s"
        if [ -z "$value" ]; then
            if [ "$json" = 1 ]; then
                printf '{"hours":null,"session":%s,"age":%s,"source":null}\n' \
                    "$(json_nullable_str "$session")" "$(json_nullable_num "$age")"
            else
                note "hours=unknown session=$session age=$agedisp source=none"
            fi
            exit 2
        fi
        if [ "$json" = 1 ]; then
            printf '{"hours":%s,"session":%s,"age":%s,"source":%s}\n' \
                "$(json_str "$value")" "$(json_str "$session")" \
                "$(json_nullable_num "$age")" "$(json_str "$source")"
        else
            note "hours=$value session=$session age=$agedisp source=$source"
        fi
        return 0
    fi

    # No live pane: the tool cannot invent a number it has not read.
    if [ "$json" = 1 ]; then
        printf '{"hours":null,"session":null,"age":null,"source":null}\n'
    else
        note 'hours=unknown'
    fi
    exit 2
}

models() {
    # models [NAME] [--json] -> the models the client's /model picker offers,
    # read from a live session. The client has no catalog command and no
    # --model flag, so the picker is the catalog: it is opened with /model,
    # walked to the end of the list (the frame draws one page and the arrow
    # keys scroll the rest into view), and closed with Escape, which leaves
    # the session as it was. Nothing is submitted, so the walk spends no
    # hours. Only a resting session is touched: a turn in flight or a refused
    # session gets no keys at all.
    local name="" json=0 tmux="" session="" wt="" pane="" opened=0 free_only=0
    local listed="" rows="" n pr sel step=0 count=0 first=1
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=1; shift ;;
            --free) free_only=1; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "models: unsupported argument: $1" ;;
            *)
                [ -z "$name" ] || die "models: at most one NAME"
                name=$1; shift
                ;;
        esac
    done
    tmux=$(tmux_bin 2>/dev/null || true)
    if [ -n "$name" ]; then
        valid_name "$name" || die "models: invalid name"
        session="fb-$name"
    fi
    if [ -z "$session" ]; then
        session=$(live_sessions | head -n 1)
    fi
    if [ -z "$session" ]; then
        note 'model=none'
        die "models: no live fb-* session to read the picker from; start one first"
    fi
    [ -n "$tmux" ] || die 'models: tmux not found; the picker can only be read from a live pane'
    "$tmux" has-session -t "$session" 2>/dev/null ||
        die "models: session $session is not live"
    [ -n "$name" ] || name=${session#fb-}
    wt="$ROOT/.worktrees/$name"
    pane=$("$tmux" capture-pane -p -t "$session" 2>/dev/null || true)
    if picker_frame "$pane"; then
        opened=0
    else
        if [ -n "$(refusal_recorded "$wt")" ]; then
            die "models: $session is refused; stop it first (no keys were sent)"
        fi
        if printf '%s\n' "$pane" | grep -qiE "$BUSY_RE"; then
            die "models: $session is working; the picker is only read from a resting session (no keys were sent)"
        fi
        "$tmux" send-keys -t "$session" -l '/model' 2>/dev/null || true
        sleep "$MODEL_PICKER_POLL"
        "$tmux" send-keys -t "$session" C-m 2>/dev/null || true
        if ! picker_wait "$tmux" "$session" "$MODEL_PICKER_TIMEOUT" "$MODEL_PICKER_POLL"; then
            die "models: /model did not open the picker in $session after ${PICKER_ELAPSED}s"
        fi
        opened=1
        pane=$MODEL_FRAME
    fi
    # One page at a time: collect what the frame draws, press Down, repeat
    # until the marker stops moving. That is the end of the list; the walk is
    # what makes the entries below the fold reachable.
    while :; do
        while IFS=$'\t' read -r _ n pr; do
            [ -n "$n" ] || continue
            printf '%s\n' "$listed" | grep -qxF -- "$n" && continue
            listed="${listed:+$listed$'\n'}$n"
            rows="${rows:+$rows$'\n'}$n"$'\t'"$pr"
            count=$((count + 1))
        done <<<"$(picker_entries "$pane")"
        [ "$step" -lt "$MODEL_PICKER_STEPS" ] || break
        sel=$(picker_selected "$pane")
        "$tmux" send-keys -t "$session" Down 2>/dev/null || true
        step=$((step + 1))
        sleep "$MODEL_PICKER_POLL"
        pane=$("$tmux" capture-pane -p -t "$session" 2>/dev/null || true)
        picker_frame "$pane" || break
        [ "$(picker_selected "$pane")" != "$sel" ] || break
    done
    # A picker this command opened is closed again, so the session is left
    # exactly as it was found; one that was already open is left open.
    if [ "$opened" = 1 ]; then
        "$tmux" send-keys -t "$session" Escape 2>/dev/null || true
    fi
    # --free is the shortlist a launch picks from when hours are short: the
    # entries whose price line carries no hour multiplier. The count follows
    # the filter, so `models=N` is the number of rows printed.
    if [ "$free_only" = 1 ]; then
        rows=$(printf '%s\n' "$rows" | while IFS=$'\t' read -r n pr; do
            [ -n "$n" ] || continue
            [ "$(model_hours_cost "$pr")" = free ] || continue
            printf '%s\t%s\n' "$n" "$pr"
        done || true)
        count=$(printf '%s\n' "$rows" | grep -c . || true)
    fi
    if [ "$json" = 1 ]; then
        printf '{\n  "session": %s,\n  "count": %s,\n  "models": [\n' \
            "$(json_str "$session")" "$count"
        while IFS=$'\t' read -r n pr; do
            [ -n "$n" ] || continue
            [ "$first" = 1 ] || printf ',\n'
            first=0
            printf '    {"name": %s, "hours": %s, "price": %s}' \
                "$(json_str "$n")" "$(json_str "$(model_hours_cost "$pr")")" \
                "$(json_str "$pr")"
        done <<<"$rows"
        printf '\n  ]\n}\n'
        return 0
    fi
    while IFS=$'\t' read -r n pr; do
        [ -n "$n" ] || continue
        printf 'model=%s hours=%s\n' "$n" "$(model_hours_cost "$pr")"
    done <<<"$rows"
    printf 'models=%s session=%s\n' "$count" "$session"
}

# ---- watch, autostop, reap and gc ----
# The lifecycle: follow a run, stop what has finished or gone quiet, and record
# the evidence the review needs.
reap() {
    # reap NAME REASON [EXTRA] -> record evidence under .worktrees, then kill
    local name="$1" reason="$2" extra="${3:-}" session="fb-$name"
    local wt="$ROOT/.worktrees/$name" log branch="" tmux pr=unknown slug dirty=no
    local pane=""
    tmux=$(tmux_bin 2>/dev/null || true)
    log="$wt/.supervisor.log"
    if [ ! -d "$wt" ]; then
        log="$ROOT/.worktrees/.orphans.log"
    fi
    mkdir -p "$(dirname "$log")"

    if [ -d "$wt" ]; then
        branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    fi
    slug=$(repo_slug || true)
    if [ -n "$branch" ] && [ -n "$slug" ] &&
        command -v "${GH_BIN:-gh}" >/dev/null 2>&1; then
        pr=$("${GH_BIN:-gh}" pr list -R "$slug" --head "$branch" --state open \
            --json url --jq '.[0].url // "none"' 2>/dev/null || true)
        [ -n "$pr" ] || pr=unknown
    fi
    if [ -d "$wt" ] && [ -n "$(git -C "$wt" status --short 2>/dev/null || true)" ]; then
        dirty=yes
    fi

    if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
        pane=$("$tmux" capture-pane -p -t "$session" -S -120 2>/dev/null || true)
    fi

    {
        printf '\n=== %s stop name=%s reason=%s session=%s ===\n' \
            "$(date -u +%FT%TZ)" "$name" "$reason" "$session"
        [ -z "$branch" ] || printf 'branch=%s\n' "$branch"
        printf 'commit=%s\n' "$(git -C "$wt" log -1 --oneline 2>/dev/null || true)"
        printf 'dirty=%s\n' "$dirty"
        printf 'pr=%s\n' "$pr"
        [ -z "$extra" ] || printf '%s\n' "$extra"
        if [ -n "$pane" ]; then
            printf '%s\n' 'pane:'
            printf '%s\n' "$pane"
        fi
    } >>"$log"

    if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
        "$tmux" kill-session -t "$session"
        note "stopped=$session reason=$reason log=$log"
    else
        note "stopped=no (session already gone) reason=$reason log=$log"
    fi
    # The stop is what ends a refusal; the sentence stays in the log above.
    clear_refusal "$wt"

    local gstate
    case "$reason" in
        done|idle) gstate=done ;;
        blocked) gstate=blocked ;;
        failed) gstate=failed ;;
        *) gstate=stopped ;;
    esac
    gh_state "$wt" "$gstate" "🤖 **subagent $gstate** — reason \`$reason\`${branch:+, branch \`$branch\`}, pr=${pr}, dirty=${dirty}. Evidence: \`${log#"$ROOT"/}\`${extra:+
$extra}"
}

watch_run() {
    # watch_run NAME IDLE_SECONDS POLL TIMEOUT -> 0 done/idle, 1 timeout,
    # 2 missing, 3 blocked, 4 failed. The result file's own state is the
    # contract; a killed watcher's exit is not read as the run's outcome.
    local name="$1" idle_limit="$2" poll="$3" timeout="$4"
    local tmux session start now state last_state="" pane hash last_hash=""
    local idle_since="" elapsed
    tmux=$(tmux_bin) || die "watch: tmux not found"
    session="fb-$name"
    start=$(date +%s)

    while :; do
        now=$(date +%s)
        if [ "$timeout" -gt 0 ] && [ $((now - start)) -ge "$timeout" ]; then
            note "state=timeout elapsed=$((now - start))s"
            return 1
        fi
        state=$(session_state "$name")
        case "$state" in
            done)
                note 'state=done'
                return 0
                ;;
            blocked)
                note 'state=blocked'
                gh_state "$ROOT/.worktrees/$name" blocked \
                    "🤖 **subagent blocked** — session \`fb-$name\` is waiting on input; \`spawn-freebuff-agent status $name\` shows the pane." || true
                return 3
                ;;
            failed)
                note 'state=failed'
                return 4
                ;;
            missing)
                note 'state=missing'
                return 2
                ;;
        esac
        if [ "$state" != "$last_state" ]; then
            note "state=$state"
            last_state=$state
        fi
        if [ "$state" = idle ]; then
            pane=$("$tmux" capture-pane -p -t "$session" 2>/dev/null || true)
            hash=$(printf '%s' "$pane" | cksum | cut -d' ' -f1)
            if [ "$hash" != "$last_hash" ]; then
                last_hash=$hash
                idle_since=$now
            fi
            [ -n "$idle_since" ] || idle_since=$now
            elapsed=$((now - idle_since))
            note "state=idle idle_seconds=$elapsed"
            if [ "$elapsed" -ge "$idle_limit" ]; then
                return 0
            fi
        else
            idle_since=""
            last_hash=""
        fi
        sleep "$poll"
    done
}

watch() {
    local name="" idle=120 poll=5 timeout=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --idle-seconds) idle=${2:-}; shift 2 ;;
            --poll) poll=${2:-}; shift 2 ;;
            --timeout) timeout=${2:-}; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) die "watch: unsupported argument: $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "watch: NAME is required"
    valid_name "$name" || die "watch: invalid name"
    is_num "$idle" || die "watch: --idle-seconds must be a number"
    is_num "$poll" || die "watch: --poll must be a number"
    is_num "$timeout" || die "watch: --timeout must be a number"
    watch_run "$name" "$idle" "$poll" "$timeout"
}

autostop() {
    local name="" idle=120 poll=5 timeout=0 rc=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --idle-seconds) idle=${2:-}; shift 2 ;;
            --poll) poll=${2:-}; shift 2 ;;
            --timeout) timeout=${2:-}; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) die "autostop: unsupported argument: $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "autostop: NAME is required"
    valid_name "$name" || die "autostop: invalid name"
    is_num "$idle" || die "autostop: --idle-seconds must be a number"
    is_num "$poll" || die "autostop: --poll must be a number"
    is_num "$timeout" || die "autostop: --timeout must be a number"

    watch_run "$name" "$idle" "$poll" "$timeout" || rc=$?
    case "$rc" in
        # 0 is done or the idle window; 3 and 4 are the result file's blocked
        # and failed. All three end the run, so the watcher still stops the
        # session; the exit status keeps the outcome distinguishable.
        0|3|4) reap "$name" "$(session_state "$name")" ;;
    esac
    return "$rc"
}

notify() {
    # notify NAME -> the next turn-end event from the client's per-chat log,
    # one line group per call, for a watcher to poll. Each call advances the
    # cursor in the worktree, so a turn fires once; the first call arms at the
    # end of the log, so history is not replayed. It is an earlier signal than
    # .agent-result, not a replacement: done stays the result file's word.
    # Read-only otherwise: nothing is sent, stopped or written outside the
    # cursor.
    local name=""
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage; exit 0 ;;
            -*) die "notify: unsupported argument: $1" ;;
            *)
                [ -z "$name" ] || die "notify: at most one NAME"
                name=$1; shift
                ;;
        esac
    done
    [ -n "$name" ] || die "notify: NAME is required"
    valid_name "$name" || die "notify: invalid name"
    [ -d "$ROOT/.worktrees/$name" ] ||
        die "notify: no worktree at $ROOT/.worktrees/$name"
    turn_log_poll "$name"
}

gc() {
    # Worktree removal is never automatic: --prune-worktrees only prints the
    # cleanup commands. A refused launch is never offered for pruning, because
    # its branch was never pushed and its worktree may hold the only copy of
    # the agent's edits. A session whose worktree is already gone has nothing
    # left to review, so plain gc stops it instead of leaving the vendor slot
    # held behind --all.
    local idle_hours=12 dry=0 prune=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --idle-hours) idle_hours=${2:-}; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --prune-worktrees) prune=1; shift ;;
            --all) shift ;;  # accepted for compatibility; orphans are default
            -h|--help) usage; exit 0 ;;
            *) die "gc: unsupported argument: $1" ;;
        esac
    done
    is_num "$idle_hours" || die "gc: --idle-hours must be a number"

    local tmux now wt name session state idle_secs branch planned
    local names=() orphans=() listed
    tmux=$(tmux_bin) || die "gc: tmux not found"
    now=$(date +%s)

    for wt in "$ROOT"/.worktrees/*; do
        [ -d "$wt" ] || continue
        names+=("$(basename "$wt")")
    done
    listed=$("$tmux" list-sessions -F '#{session_name}' 2>/dev/null || true)
    while IFS= read -r session; do
        case "$session" in
            fb-*)
                name=${session#fb-}
                [ -d "$ROOT/.worktrees/$name" ] || orphans+=("$name")
                ;;
        esac
    done <<<"$listed"

    for name in ${names[@]+"${names[@]}"}; do
        planned=0
        state=$(session_state "$name")
        case "$state" in
            missing)
                continue
                ;;
            done|blocked|failed)
                # All three are a finished agent: blocked and failed still stop
                # the session, and the reason names the result state.
                planned=1
                if [ "$dry" = 1 ]; then
                    note "would-stop name=$name reason=$state"
                else
                    note "stop name=$name reason=$state"
                    reap "$name" "$state"
                fi
                ;;
            refused)
                # The stop is fine (the TUI is dead weight), but the worktree
                # is the evidence: never offer to prune it.
                planned=1
                if [ "$dry" = 1 ]; then
                    note "would-stop name=$name reason=refused"
                else
                    note "stop name=$name reason=refused"
                    reap "$name" refused
                fi
                ;;
            idle)
                idle_secs=$(idle_seconds "$name" 2>/dev/null || true)
                is_num "$idle_secs" || idle_secs=0
                if [ "$idle_secs" -ge $((idle_hours * 3600)) ]; then
                    planned=1
                    if [ "$dry" = 1 ]; then
                        note "would-stop name=$name reason=idle idle_seconds=$idle_secs"
                    else
                        note "stop name=$name reason=idle"
                        reap "$name" idle
                    fi
                else
                    note "skip name=$name reason=idle idle_seconds=$idle_secs"
                fi
                ;;
            unknown)
                # No rule matched, so nothing is known about this pane. Skipping
                # it is the same safe choice as a busy pane: gc never reaps a
                # session it cannot read.
                note "skip name=$name reason=unknown"
                ;;
            *)
                note "skip name=$name reason=busy"
                ;;
        esac
        if [ "$prune" = 1 ] && [ "$planned" = 1 ] && [ "$state" != refused ]; then
            branch=$(git -C "$ROOT/.worktrees/$name" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
            [ -z "$branch" ] || {
                if [ "$dry" = 1 ]; then
                    note "would-prune name=$name cleanup=git worktree remove .worktrees/$name && git branch -d $branch"
                else
                    note "cleanup=git worktree remove .worktrees/$name && git branch -d $branch"
                fi
            }
        fi
    done

    # No worktree means no result file and no branch to review, so the session
    # only holds a vendor slot. Plain gc stops it; --all is no longer needed.
    for name in ${orphans[@]+"${orphans[@]}"}; do
        if [ "$dry" = 1 ]; then
            note "would-stop name=$name reason=orphan"
        else
            note "stop name=$name reason=orphan"
            reap "$name" orphan
        fi
    done
}

# ---- the GUI ----
# The static snapshot and the served page, both over `sessions --json`.
snapshot_html() {
    # snapshot_html FILE JSON WATCH [LINK_PREFIX] [NOTE] [FORM_NONCE] [FLASH]
    # -> one self-contained page. `sessions --json` is the input: fixed keys,
    # one per line, so the reader below is a field scan rather than a general
    # JSON parser. WATCH is empty for a one shot snapshot and a whole number of
    # seconds for the meta refresh. LINK_PREFIX is `/tty/` when the served page
    # should carry a terminal link per session; NOTE is one line under the
    # header. FORM_NONCE adds the action forms and is empty for a static
    # snapshot, which stays read-only; FLASH is the output of an action that
    # redirected here (the gc report) and is shown above the cards.
    # The CSS is inlined from gui/page.css, shared with gui/server.py's action
    # pages, so the page stays a single file with no external asset.
    local file="$1" json="$2" watch="$3" link_prefix=${4:-} note_text=${5:-}
    local form_nonce=${6:-} flash_text=${7:-}
    local line key value name state idle watcher worktree result branch pr
    local model_name model_hours in_model=0
    local tests="" commit="" wt generated total=0 live=0 trees=0 cards='' card
    local cls pr_html refresh='' css_file
    css_file=$(stylesheet_file)
    [ -f "$css_file" ] ||
        die "gui: missing $css_file (the shared stylesheet next to the tool)"
    generated=$(date -u '+%Y-%m-%d %H:%M:%SZ')
    if [ -n "$watch" ]; then
        refresh="<meta http-equiv=\"refresh\" content=\"$watch\">"
    fi

    while IFS= read -r line; do
        case "$line" in
            '  {'*)
                name='' state='' idle='' watcher='' worktree='' result=''
                branch='' pr='' model_name='' model_hours='' in_model=0
                continue
                ;;
            '  }'*)
                total=$((total + 1))
                [ "$worktree" = yes ] && trees=$((trees + 1))
                [ -n "$idle" ] && live=$((live + 1))
                tests=''
                commit=''
                if [ "$worktree" = yes ] && valid_name "$name"; then
                    wt="$ROOT/.worktrees/$name"
                    if [ -f "$wt/$RESULT_FILE" ]; then
                        tests=$(result_key "$wt/$RESULT_FILE" tests)
                        commit=$(result_key "$wt/$RESULT_FILE" commit)
                    fi
                    if [ -z "$commit" ]; then
                        commit=$(git -C "$wt" log -1 --format='%h %s' \
                            2>/dev/null || true)
                    fi
                fi
                cls=$(state_class "$state")
                card="<article class=\"card state-$cls\">"$'\n'
                card+="<header><h2>$(html_escape "$name")</h2>"
                if [ "$worktree" != yes ]; then
                    card+="<span class=\"tag\">no worktree</span>"
                fi
                card+="<span class=\"badge\">"
                card+="$(html_escape "${state:-unknown}")</span></header>"$'\n'
                card+="<dl>"$'\n'
                if [ -n "$idle" ]; then
                    card+="<dt>idle</dt><dd>${idle}s</dd>"$'\n'
                fi
                card+="<dt>watcher</dt><dd>$(html_escape "${watcher:--}")</dd>"$'\n'
                card+="<dt>worktree</dt><dd>$(html_escape "$worktree")</dd>"$'\n'
                card+="<dt>result</dt><dd>$(html_escape "${result:--}")</dd>"$'\n'
                card+="<dt>branch</dt><dd><code>$(html_escape "${branch:--}")</code></dd>"$'\n'
                # The model and its cost class are one row, so `free` and
                # `2x` are visible at a glance next to the hours reading (#136).
                if [ -n "$model_name" ]; then
                    card+="<dt>model</dt><dd>$(html_escape "$model_name")"
                    card+=" <span class=\"tag\">"
                    card+="$(html_escape "$model_hours")</span></dd>"$'\n'
                fi
                # A terminal link exists only for a served page with ttyd
                # behind it, and only for a name the tool accepts.
                if [ -n "$link_prefix" ] && [ "$worktree" = yes ] &&
                    valid_name "$name"; then
                    card+="<dt>terminal</dt><dd><a href=\"$(html_escape "$link_prefix$name")\">open in ttyd</a></dd>"$'\n'
                fi
                if [ -n "$pr" ]; then
                    case "$pr" in
                        http://*|https://*)
                            pr_html="<a href=\"$(html_escape "$pr")\">"
                            pr_html+=$(html_escape "$pr")
                            pr_html+='</a>'
                            ;;
                        *) pr_html=$(html_escape "$pr") ;;
                    esac
                else
                    pr_html='-'
                fi
                card+="<dt>pr</dt><dd>$pr_html</dd>"$'\n'
                if [ -n "$commit" ]; then
                    card+="<dt>commit</dt><dd><code>$(html_escape "$commit")</code></dd>"$'\n'
                fi
                if [ -n "$tests" ]; then
                    card+="<dt>tests</dt><dd>$(html_escape "$tests")</dd>"$'\n'
                fi
                card+='</dl>'$'\n'
                # Actions only for a running session the action could end.
                # `done` and `blocked` are result states: the session is
                # already over, so a Stop button would be a lie.
                if [ -n "$form_nonce" ] && [ "$worktree" = yes ] &&
                    valid_name "$name" && [ -n "$idle" ]; then
                    case "${state:-}" in
                        done|stopped|failed|blocked) ;;
                        *)
                            card+='<div class="actions">'
                            card+=$(action_form "$form_nonce" \
                                "/api/session/$name/stop" 'Stop')
                            card+=$(action_form "$form_nonce" \
                                "/api/session/$name/stop?graceful=1" \
                                'Stop (graceful)')
                            card+='</div>'$'\n'
                            ;;
                    esac
                fi
                card+='</article>'$'\n'
                cards+=$card
                continue
                ;;
            '    "model": {'*)
                in_model=1
                continue
                ;;
            # The model object is the only nested one the card reads; its
            # closing brace ends the read so the account hours object below it
            # is not mistaken for the model's own hours.
            '    }'*)
                in_model=0
                continue
                ;;
            '      "name": '*)
                [ "$in_model" = 1 ] || continue
                value=${line#*: }
                value=${value%,}
                model_name=$(json_scalar "$value")
                continue
                ;;
            '      "hours": '*)
                [ "$in_model" = 1 ] || continue
                value=${line#*: }
                value=${value%,}
                model_hours=$(json_scalar "$value")
                continue
                ;;
            '    "'*) ;;
            *) continue ;;
        esac
        key=${line#    \"}
        key=${key%%\"*}
        value=${line#*: }
        value=${value%,}
        value=$(json_scalar "$value")
        case "$key" in
            name) name=$value ;;
            state) state=$value ;;
            idle_seconds) idle=$value ;;
            watcher) watcher=$value ;;
            worktree) worktree=$value ;;
            result) result=$value ;;
            branch) branch=$value ;;
            pr) pr=$value ;;
        esac
    done <<<"$json"

    {
        printf '<!DOCTYPE html>\n'
        printf '<html lang="en">\n<head>\n'
        printf '<meta charset="utf-8">\n'
        printf '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
        # connect-src 'self' is here for Chrome DevTools, which fetches
        # /.well-known/appspecific/com.chrome.devtools.json from the page's
        # origin; without it the probe is blocked and the console shows two
        # violations per load. Same origin only, and there is no script to
        # use the allowance anyway.
        printf '<meta http-equiv="Content-Security-Policy" content="default-src %s; style-src %s; img-src data:; connect-src %s">\n' \
            "'none'" "'unsafe-inline'" "'self'"
        printf '<meta name="referrer" content="no-referrer">\n'
        [ -z "$refresh" ] || printf '%s\n' "$refresh"
        printf '<title>freebuff agents</title>\n'
        printf '<style>\n'
        cat "$css_file"
        printf '</style>\n</head>\n<body>\n'
        printf '<header class="page">\n<h1>freebuff agents</h1>\n'
        printf '<p class="meta">repo %s · generated %s · sessions %s · running %s · worktrees %s · orphans %s</p>\n' \
            "$(html_escape "$ROOT")" "$generated" "$total" "$live" \
            "$trees" "$((total - trees))"
        if [ -n "$note_text" ]; then
            printf '<p class="note">%s</p>\n' "$(html_escape "$note_text")"
        fi
        # The safe action comes first: a dry run reports, it does not stop
        # anything, and its report is useful without a terminal. Nothing to
        # reap means no form.
        if [ -n "$form_nonce" ] && [ "$live" -gt 0 ]; then
            printf '<div class="actions">%s</div>\n' \
                "$(action_form "$form_nonce" '/api/gc?dry=1' 'gc --dry-run')"
        fi
        printf '</header>\n'
        if [ -n "$flash_text" ]; then
            printf '<section class="flash">\n<h2>gc --dry-run</h2>\n<pre>%s</pre>\n</section>\n' \
                "$(html_escape "$flash_text")"
        fi
        printf '<main class="grid">\n'
        if [ "$total" = 0 ]; then
            printf '<p class="empty">no sessions</p>\n'
        else
            printf '%s' "$cards"
        fi
        printf '</main>\n'
        if [ -n "$form_nonce" ]; then
            printf '<footer>Actions are plain server-rendered forms; no script. Stop asks for confirmation before it acts.</footer>\n'
        else
            printf '<footer>Read-only view from spawn-freebuff-agent sessions --json. No script.</footer>\n'
        fi
        printf '</body>\n</html>\n'
    } >"$file.tmp.$$"
    mv "$file.tmp.$$" "$file"
}

gui() {
    # Two modes over the same inventory:
    #   --snapshot FILE [--watch N] [--no-gh]      write one page
    #   --serve [--port N] [--host H] [--token T]  serve that page and the API
    # The server itself is gui/server.py; python3 stays optional so the rest
    # of the CLI works on a host that does not have it.
    local snapshot='' watch='' no_gh=0 serve=0 first=1 json args py dir
    local links='' note_text='' ttyd=0 interactive=0
    local form_nonce='' flash_file='' flash_text=''
    local passthrough=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --snapshot) snapshot=${2:-}; shift 2 ;;
            --watch) watch=${2:-}; shift 2 ;;
            --no-gh) no_gh=1; shift ;;
            --serve) serve=1; shift ;;
            --ttyd) ttyd=1; passthrough+=(--ttyd); shift ;;
            --interactive) interactive=1; passthrough+=(--interactive); shift ;;
            --terminal-links) links=/tty/; shift ;;
            --terminal-note) note_text=${2:-}; shift 2 ;;
            --form-nonce) form_nonce=${2:-}; shift 2 ;;
            --flash-file) flash_file=${2:-}; shift 2 ;;
            --port|--host|--token|--allow-host)
                [ $# -ge 2 ] || die "gui: $1 needs a value"
                passthrough+=("$1" "$2"); shift 2 ;;
            --read-only) passthrough+=(--read-only); shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "gui: unsupported argument: $1" ;;
        esac
    done

    if [ "$serve" = 0 ] && { [ "$ttyd" = 1 ] || [ "$interactive" = 1 ]; }; then
        die "gui: --ttyd and --interactive belong to --serve"
    fi

    if [ "$serve" = 1 ]; then
        [ -z "$snapshot" ] ||
            die "gui: --serve and --snapshot are separate modes"
        py=$(command -v python3 2>/dev/null || true)
        [ -n "$py" ] ||
            die "gui: --serve needs python3 (pkg install python on Termux); the rest of the CLI works without it"
        case "$0" in
            */*) dir=$(cd "$(dirname "$0")" && pwd) ;;
            *) dir=$(cd "$(dirname "$(command -v "$0" 2>/dev/null || printf '%s' "$0")")" && pwd) ;;
        esac
        [ -f "$dir/gui/server.py" ] ||
            die "gui: gui/server.py is missing next to the tool"
        exec "$py" "$dir/gui/server.py" --root "$ROOT" \
            ${passthrough[@]+"${passthrough[@]}"}
    fi

    [ -n "$snapshot" ] || die "gui: --snapshot FILE or --serve is required"
    if [ -n "$watch" ]; then
        is_num "$watch" || die "gui: --watch must be a number"
        [ "$watch" -ge 1 ] || die "gui: --watch must be at least 1 second"
    fi
    mkdir -p "$(dirname "$snapshot")"
    while :; do
        args=(--json)
        if [ "$no_gh" = 1 ]; then
            args+=(--no-gh)
        fi
        json=$(sessions "${args[@]}")
        flash_text=''
        if [ -n "$flash_file" ] && [ -f "$flash_file" ]; then
            flash_text=$(cat "$flash_file")
        fi
        snapshot_html "$snapshot" "$json" "$watch" "$links" "$note_text" \
            "$form_nonce" "$flash_text"
        if [ "$first" = 1 ]; then
            note "snapshot=$snapshot"
            [ -z "$watch" ] || note "watch_seconds=$watch"
            first=0
        fi
        [ -n "$watch" ] || return 0
        sleep "$watch"
    done
}

# ---- attach, send and stop ----
# The terminal actions: attach to the pane, send a follow-up, stop explicitly.
attach() {
    local name=${1:-} tmux
    [ -n "$name" ] || die "attach: NAME is required"
    valid_name "$name" || die "attach: invalid name"
    [ -t 0 ] && [ -t 1 ] || die "attach: needs a terminal"
    tmux=$(tmux_bin) || die "attach: tmux not found"
    exec "$tmux" attach -t "fb-$name"
}

send() {
    # send NAME TEXT, or send NAME -- TEXT for text that starts with a dash.
    # `--` was previously taken as the text itself, so a message passed that
    # way typed `--` (or landed in an overlay) instead of failing (#121).
    local name='' text='' tmux pane
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage; exit 0 ;;
            --) shift; text="$*"; break ;;
            *)
                if [ -z "$name" ]; then
                    name=$1
                elif [ -z "$text" ]; then
                    text=$1
                else
                    die "send: unexpected argument: $1 (quote the text as one argument)"
                fi
                ;;
        esac
        shift
    done
    [ -n "$name" ] || die "send: NAME is required"
    valid_name "$name" || die "send: invalid name"
    [ -n "$text" ] || die "send: TEXT is required"
    tmux=$(tmux_bin) || die "send: tmux not found"
    "$tmux" has-session -t "fb-$name" 2>/dev/null ||
        die "send: session fb-$name is not running"
    # The overlay's Enter takes over and stops another live session, and the
    # hours overlay's Enter opens the model picker. Never type into either: a
    # follow-up is not worth killing a sibling agent or losing the text.
    pane=$("$tmux" capture-pane -p -t "fb-$name" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
    if printf '%s\n' "$pane" | grep -qiE "$REFUSAL_OVERLAY_RE|$HOURS_OVERLAY_RE"; then
        die "send: fb-$name is on the concurrent-session overlay or the hours overlay; no keys were sent (Enter would take over another session or open the model picker; stop it first)"
    fi
    # A released session draws no composer: Enter retries with the model
    # picker's choice and starts a new session, so the text would be lost.
    if printf '%s\n' "$pane" | grep -qiE "$RELEASED_OVERLAY_RE"; then
        die "send: fb-$name is on the released-session overlay; no keys were sent (its Enter retries with a model and starts a new session; press Enter in the pane, then send again)"
    fi
    "$tmux" send-keys -t "fb-$name" -l "$text"
    sleep 0.2
    "$tmux" send-keys -t "fb-$name" C-m
}

stop() {
    local name="" tmux graceful=0 wait=20 initial state deadline interrupted=no
    while [ $# -gt 0 ]; do
        case "$1" in
            --graceful) graceful=1; shift ;;
            --wait) wait=${2:-}; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) die "stop: unsupported argument: $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "stop: NAME is required"
    valid_name "$name" || die "stop: invalid name"
    is_num "$wait" || die "stop: --wait must be a number"
    tmux=$(tmux_bin) || die "stop: tmux not found"

    if ! "$tmux" has-session -t "fb-$name" 2>/dev/null; then
        # The session may already be gone after a refused launch; stop is
        # still the action that clears the recorded refusal.
        clear_refusal "$ROOT/.worktrees/$name"
        note "stopped=no (fb-$name not running)"
        return 0
    fi

    if [ "$graceful" = 0 ]; then
        "$tmux" kill-session -t "fb-$name"
        clear_refusal "$ROOT/.worktrees/$name"
        note "stopped=fb-$name"
        # A plain stop is a state change too: the issue must not keep saying
        # status:working for a session that is gone.
        gh_state "$ROOT/.worktrees/$name" stopped \
            "🤖 **subagent stopped** — \`stop $name\` killed \`fb-$name\` before it finished; the worktree and branch are kept."
        return 0
    fi

    # Graceful: end the turn with Escape, then wait for the resting prompt, so
    # a kill cannot land between an edit and its commit unnoticed.
    initial=$(session_state "$name")
    case "$initial" in
        working|unknown)
            # An unknown pane is unreadable, not finished: interrupt it like a
            # busy turn and refuse the kill below if it never settles.
            "$tmux" send-keys -t "fb-$name" Escape
            interrupted=yes
            note 'graceful=escape'
            ;;
        *) note "graceful=already-$initial" ;;
    esac
    deadline=$(( $(date +%s) + wait ))
    while :; do
        state=$(session_state "$name")
        case "$state" in
            done|blocked|failed|idle|refused|missing) break ;;
        esac
        if [ "$(date +%s)" -ge "$deadline" ]; then
            break
        fi
        sleep 1
    done
    if [ "$state" = working ] || [ "$state" = unknown ]; then
        note "graceful=no state=$state waited=${wait}s"
        note "still busy: nothing was stopped; use plain 'stop $name' to kill it"
        return 1
    fi
    reap "$name" graceful \
        "pane_state=$state interrupted=$interrupted waited=${wait}s"
}

# ---- the dispatch ----
# The --root peel, the help shortcut and the case over $cmd.
# --root is accepted before the subcommand so tests can point at a temp repo.
ROOT="${FREEBUFF_SUPERVISOR_ROOT:-}"
args=("$@")
while [ ${#args[@]} -gt 0 ]; do
    case "${args[0]}" in
        --root)
            [ ${#args[@]} -ge 2 ] || die "--root needs a directory"
            ROOT=${args[1]}
            args=("${args[@]:2}")
            ;;
        *) break ;;
    esac
done
set -- "${args[@]}"

# Help is about the tool, not about a checkout: answer it before the root
# lookup, so `--help` works from any directory (and the suites can run from
# anywhere, not only from inside the repo).
case "${1:-}" in
    -h|--help|help) usage; exit 0 ;;
esac

if [ -z "$ROOT" ]; then
    ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
[ -n "$ROOT" ] || die "not inside a git repository"
[ -d "$ROOT" ] || die "root does not exist: $ROOT"

cmd=${1:-}
if [ $# -gt 0 ]; then
    shift
fi
case "$cmd" in
    start) start "$@" ;;
    status) status "$@" ;;
    list|ls) list_agents "$@" ;;
    sessions|ps) sessions "$@" ;;
    hours) hours "$@" ;;
    models) models "$@" ;;
    gui) gui "$@" ;;
    attach) attach "$@" ;;
    send) send "$@" ;;
    watch) watch "$@" ;;
    autostop) autostop "$@" ;;
    notify) notify "$@" ;;
    gc) gc "$@" ;;
    stop) stop "$@" ;;
    -h|--help|help) usage ;;
    '') usage; exit 2 ;;
    *) die "unknown command: $cmd (try --help)" ;;
esac
