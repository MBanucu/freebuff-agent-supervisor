#!/usr/bin/env bash
# Spawn and inspect parallel Freebuff agents, one git worktree per agent.
#
# What this wraps:
#   1. create a git worktree and branch from a base;
#   2. write the task brief to .task.md in the worktree;
#   3. start Freebuff in a detached tmux session at 180x55 (the TUI does not
#      enter raw input mode in smaller panes);
#   4. wait until the TUI accepts input, then send the short "read .task.md"
#      prompt;
#   5. status/list/attach/stop/send against the live session;
#   6. optionally watch for the agent's .agent-result and stop the session.
#
# The agent is told to commit, push and open the PR. This tool never commits
# and never touches the main worktree.
set -euo pipefail

COLS=180
ROWS=55
PROMPT='Read the file .task.md in this directory and execute it autonomously. Do not commit .task.md, .agent-result or local.properties. Follow the PR instructions in it exactly. Do not ask questions; if blocked, open a draft PR and explain.'
RESULT_FILE='.agent-result'
# The vendor refuses a message identical to a recent one as scripted use and
# counts a strike, so every sent brief is hashed here before it is typed. The
# file lives in the repository root and the last BRIEF_LEDGER_KEEP hashes are
# kept: a brief stops counting as a duplicate once it has aged out of the
# window, so a retry next week is not blocked by today's run.
BRIEF_LEDGER='.supervisor-briefs.jsonl'
BRIEF_LEDGER_KEEP=20
# The pane is the only completion signal Freebuff offers. Markers are matched
# against the bottom lines of the visible pane only, so prose in the agent's
# scrollback cannot keep a finished session alive.
# Verified against Freebuff 0.2.38: a running turn shows `thinking...` /
# `working...` with a `■ Esc` hint in the bottom-right; `esc to interrupt` and
# the spinner glyphs are kept for other builds.
BUSY_RE='esc to interrupt|thinking\.\.\.|working\.\.\.|■ Esc|[◐◓◑◒]'
PROTECTED_RE='approval|approve|Allow once|Allow always|Run command|permission|rate limit|Can.t reach Freebuff'
# A refusal is not only the concurrent-session overlay. The vendor also
# answers a brief as a finished turn, above the resting prompt: "Freebuff did
# not send this message to the model ... the same message sent over and over
# ... counts as strike 1 today", usually with an account budget line. A
# session that shows that answer is not healthy and idle: the account was
# penalised. Keep the phrases specific enough that an agent discussing the
# policy in its own prose does not match them.
REFUSED_RE='session limit|Take over to stop another session|did not send this message to the model|Scripted or automated use|sent over and over|automated account or site farming|counts as strike [0-9]+|strike [0-9]+ today|account budget|daily budget|budget (is )?(exhausted|exceeded|reached|remaining|left)|remaining budget|out of (daily )?hours|daily hours (refill|reset)'
# Only the overlay offers an Enter that takes over another live session, so
# send refuses to type into a pane carrying one of these strings.
REFUSAL_OVERLAY_RE='concurrent-session limit|session limit across CLI and Desktop|Take over to stop another session'
# A refusal is written here as well as to .supervisor.log. The file is what
# keeps status at refused after the sentence has scrolled away; stop removes
# it, so a refusal lasts until the session is explicitly stopped.
REFUSAL_FILE='.refusal'
# Turn text sits above the visible prompt, so refusal detection reads this
# many lines of scrollback rather than the 12-line chrome window.
REFUSAL_WINDOW=40
# No rule matching a pane used to fall through to `working`, which made new
# vendor chrome indistinguishable from a live turn. It is now `unknown`, but
# only once the same normalised window has been seen twice: a boot frame or a
# mid-repaint changes between scans and is not evidence of a new state.
UNKNOWN_RESCAN_DELAY=0.4
# Readiness gate: the TUI accepts the brief only once it is in raw mode and
# draws its resting prompt. A cold first launch in a fresh worktree pays for
# the banner, the trust prompt and the session scan, which outran the old
# fixed 45s gate, so the default deadline is generous and both values are
# per-start flags. A warm pane is ready on the first check and pays no poll.
READY_TIMEOUT=120
READY_POLL=0.5
# Note the wait every this many polls, so a slow launch leaves a trace in
# .supervisor.log instead of looking like a hang.
READY_NOTE_POLLS=10
# Set by wait_ready: seconds spent polling, for the log and the failure line.
READY_ELAPSED=0.0
# A ready TUI can still swallow the Enter: the brief lands in the composer and
# is never submitted, the composer clears, and the session rests at the idle
# prompt looking healthy. So the Enter is not proof. After typing, start waits
# for the input line to clear and for a turn to begin (or the chat title to
# change) with the same poll-with-deadline shape as the readiness gate. The
# brief is never retyped automatically: a swallowed send is reported as
# sent=no with the pane, not doubled.
SUBMIT_TIMEOUT=20
# Set by await_submission: the signal that proved the send and the time it took.
SUBMIT_PROOF=''
SUBMIT_ELAPSED=0.0

usage() {
    cat <<'USAGE'
Spawn parallel Freebuff agents in isolated git worktrees.

  spawn-freebuff-agent start --issue N [options]
      Create .worktrees/<name> on a new branch, write .task.md, and launch
      Freebuff in tmux session fb-<name> at 180x55.

      --issue N          GitHub issue number (required)
      --name NAME        worktree/session name (default: issue-N)
      --branch BRANCH    new branch (default: issue/N)
      --base REF         base ref (default: main)
      --task-file FILE   use a custom brief instead of the generic one
      --title TEXT       issue title (otherwise read with gh)
      --url URL          issue URL (otherwise read with gh)
      --sdk-dir DIR      write sdk.dir into local.properties
      --auto-stop        stop fb-<name> after the agent finishes
      --idle-seconds N   idle window for --auto-stop (default: 120)
      --poll N           watcher poll interval in seconds (default: 5)
      --ready-timeout N  seconds to wait for the TUI to take raw input
                         (default: 120); a cold first launch can need more
                         than the old fixed 45s
      --ready-poll N     seconds between readiness checks (default: 0.5)
      --submit-timeout N seconds after the Enter to see the turn begin or the
                         chat title change (default: 20); a brief that never
                         proves submission is reported as sent=no and the
                         session is stopped, never retyped
      --max-sessions N   refuse to start while N fb-* sessions are live
      --wait-slot [N]    wait up to N seconds (default: 300) for a free slot
                         instead of failing; requires --max-sessions
                         With N > 1, each send is jittered by a random delay
                         so a burst does not reach the TUI in one second.
      --no-start         create the worktree and brief, do not launch
      --prompt TEXT      send this message instead of the default brief
      --dry-run          print the plan, change nothing
      --help             this text

  spawn-freebuff-agent status NAME [--lines N] [--no-gh] [--json] [--explain]
      Show the session, input mode, result state, pane tail, branch, last
      commit and PR.
      --lines N   pane lines to show (default: 25)
      --no-gh     do not ask gh for the PR
      --json      emit the same fields as one JSON object, plus an evidence
                  object naming the rule, the matched line and the window
      --explain   print the classification decision line by line: every
                  marker checked and the pane the rule looked at
      --window N  pane lines the classifier reads (default: 40)

  spawn-freebuff-agent list
      List worktrees with session state, running flag and idle time.

  spawn-freebuff-agent sessions [--no-gh] [--json]
      One table over every fb-* session and every worktree: live state, idle
      time, attached autostop watcher, whether a worktree exists, the result
      state, the branch and the open PR. Sessions with no worktree are listed
      here instead of only being reapable by gc --all. --json emits the same
      rows as an array of objects.

  spawn-freebuff-agent gui --snapshot FILE [--watch N] [--no-gh]
      Write one self-contained HTML page from `sessions --json`: one card
      per session with done-versus-working visible at a glance. No server,
      no script, no external assets, so it opens from file:// offline.
      --watch N   rewrite the file every N seconds (adds a meta refresh)
      --no-gh     do not ask gh for the PR

  spawn-freebuff-agent gui --serve [--port N] [--host H] [--token T] [--read-only]
                              [--allow-host NAME] [--ttyd [--interactive]]
      Serve the dashboard and JSON API from python3's standard library:
      GET / is the --snapshot page, GET /api/sessions is `sessions --json`
      verbatim and GET /api/session/<name>/pane is `status --json`. POST
      /api/session/<name>/stop[?graceful=1], /api/session/<name>/send (JSON
      {"text": ...}) and /api/gc[?dry=1] run the matching CLI command and
      answer 202 with its key=value output. The served page carries Stop and
      gc forms that post to those routes; a form submission is
      cookie-authenticated, so it must carry the page nonce, passes an Origin
      check, and a successful stop answers 303 See Other to / (gc to the
      report). Binds 127.0.0.1:7788 by default;
      a non-loopback host is refused unless --token is given. Without --token
      one is generated and printed once. Every POST needs the token even on
      loopback; --read-only answers them 403. Only loopback Host names (and
      --host) are served; a foreign Host is 421, so a rebinding name gets
      nothing. --allow-host adds a name a proxy keeps, repeatable. No TLS:
      put a reverse proxy in front for LAN or Tailscale access.
      --ttyd          add a terminal link per session; GET /tty/<name> starts
                      one loopback ttyd of `tmux attach -t fb-<name>` on
                      demand and redirects to it. Read-only unless
                      --interactive, which adds ttyd's -W.
      --interactive   let the browser type into the agent; refused with
                      --read-only

  spawn-freebuff-agent attach NAME
      Attach to the tmux session (detach with Ctrl-b d).

  spawn-freebuff-agent send NAME TEXT
      Send a follow-up message to a running agent.

  spawn-freebuff-agent watch NAME [--idle-seconds N] [--poll N] [--timeout N]
      Report working/idle/done/blocked/failed/refused/unknown/missing
      transitions. Exits 0 when the agent is done or the pane has been idle
      past the window, 1 on timeout, 2 when the session is gone, 3 when the
      agent reported blocked and 4 when it reported failed. Never stops
      anything.

  spawn-freebuff-agent autostop NAME [--idle-seconds N] [--poll N] [--timeout N]
      Watch, then stop fb-<name> and record the run evidence. This is what
      start --auto-stop runs detached. A done, blocked or failed result stops
      the session; the exit status is watch's (0, 3 or 4).

  spawn-freebuff-agent stop NAME [--graceful [--wait N]]
      Kill the tmux session; the worktree and branch are left in place.
      --graceful sends Escape, waits up to N seconds (default: 20) for the turn
      to end, then stops, recording the pane state. It refuses to kill a
      session that is still working when the wait expires.

  spawn-freebuff-agent gc [--idle-hours N] [--all] [--dry-run]
      Stop finished sessions, sessions idle past N hours (default: 12),
      sessions stuck on the concurrent-session overlay, and with --all,
      fb-* sessions whose worktree no longer exists. Busy and approval
      panes are skipped. Worktrees and branches are never removed.

Environment:
  FREEBUFF_BIN        freebuff executable (default: freebuff on PATH)
  FREEBUFF_TMUX       tmux executable (default: tmux on PATH, then nix-shell)
  FREEBUFF_START_JITTER  upper bound in seconds for the random delay before a
                         send when --max-sessions allows several (default:
                         2N; 0 disables the wait)
  FREEBUFF_TTYD       ttyd executable for gui --ttyd (default: ttyd on PATH)
  FREEBUFF_SUPERVISOR_ROOT  repository root override (tests)
  GH_BIN              gh executable (default: gh on PATH)

Notes:
  - The TUI needs a 180x55 pane. Smaller panes stay in canonical mode and
    silently ignore the prompt; this tool waits for -icanon before sending,
    re-checking every --ready-poll seconds for up to --ready-timeout.
  - A wait that gives up names the timeout it used, prints the last pane
    lines and records elapsed seconds in .supervisor.log, so a slow cold
    launch is distinguishable from a hung TUI.
  - A ready pane can still swallow the Enter. After typing, start waits for
    the input line to clear and for the turn to begin (or the chat title to
    change) and prints sent=yes with the signal that proved it. A send that
    never proves submission prints sent=no with the pane, stops the session
    and exits non-zero; the brief is not retyped.
  - A running agent runs shell commands with its normal approvals. Do not
    attach and type while it is working.
  - A brief is hashed into .supervisor-briefs.jsonl (last 20 kept) before it
    is typed; a repeat inside that window is a hard error and sends nothing,
    because Freebuff treats a repeated message as scripted use and counts a
    strike against the account. A brief the vendor refused is marked in the
    same ledger, kept past the window and never sent again.
  - A refusal (the concurrent-session overlay or the vendor's anti-automation
    answer in the turn text) is recorded in .worktrees/<name>/.refusal and
    .supervisor.log. start prints refused=yes with the sentence and exits
    non-zero; the overlay gets no keys at all, and status keeps refused until
    stop clears it.
  - Completion is either the agent's .agent-result file (stock brief) or an
    idle pane after the window; the pane heuristic is tied to the TUI.
  - The tool never deletes a worktree or branch. Use git worktree remove and
    git branch -D explicitly when the PR is done.
USAGE
}

die() {
    printf 'spawn-freebuff-agent: %s\n' "$*" >&2
    exit 1
}

note() {
    printf '%s\n' "$*"
}

is_num() {
    case "${1:-}" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

is_duration() {
    # is_duration VALUE -> 0 for a positive number of seconds. Decimals are
    # allowed because --ready-poll defaults to 0.5 and sleep accepts fractions
    # on every target; zero is refused so a poll cannot busy-loop.
    case "${1:-}" in
        ''|*[!0-9.]*|*.*.*) return 1 ;;
        *[1-9]*) return 0 ;;
        *) return 1 ;;
    esac
}

valid_name() {
    case "${1:-}" in
        ''|*[!A-Za-z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

repo_slug() {
    local url
    url=$(git -C "$ROOT" remote get-url origin 2>/dev/null || true)
    [ -n "$url" ] || return 0
    printf '%s' "$url" |
        sed -E 's#^git@github\.com:##; s#^https://github\.com/##; s#\.git$##'
}

tmux_bin() {
    local cache path
    if [ -n "${FREEBUFF_TMUX:-}" ]; then
        printf '%s' "$FREEBUFF_TMUX"
        return 0
    fi
    if command -v tmux >/dev/null 2>&1; then
        command -v tmux
        return 0
    fi
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/wireless-adb-keeper/tmux.path"
    if [ -x "$cache" ]; then
        cat "$cache"
        return 0
    fi
    if command -v nix-shell >/dev/null 2>&1; then
        path=$(nix-shell -p tmux --run 'command -v tmux' 2>/dev/null | tail -n 1 || true)
        if [ -n "$path" ] && [ -x "$path" ]; then
            mkdir -p "$(dirname "$cache")" 2>/dev/null || true
            printf '%s' "$path" >"$cache" 2>/dev/null || true
            printf '%s' "$path"
            return 0
        fi
    fi
    return 1
}

freebuff_bin() {
    if [ -n "${FREEBUFF_BIN:-}" ]; then
        printf '%s' "$FREEBUFF_BIN"
        return 0
    fi
    if command -v freebuff >/dev/null 2>&1; then
        command -v freebuff
        return 0
    fi
    if [ -x "$HOME/.local/bin/freebuff" ]; then
        printf '%s' "$HOME/.local/bin/freebuff"
        return 0
    fi
    return 1
}

exclude_path() {
    local common
    common=$(git -C "$ROOT" rev-parse --git-common-dir 2>/dev/null || true)
    [ -n "$common" ] || common="$ROOT/.git"
    case "$common" in
        /*) ;;
        *) common="$ROOT/$common" ;;
    esac
    printf '%s/info/exclude' "$common"
}

ensure_excludes() {
    local file entry
    file=$(exclude_path)
    mkdir -p "$(dirname "$file")"
    for entry in '.worktrees/' '.task.md' 'local.properties' "$RESULT_FILE" \
        '.supervisor.log' "$BRIEF_LEDGER"; do
        grep -qxF "$entry" "$file" 2>/dev/null || printf '%s\n' "$entry" >>"$file"
    done
}

result_key() {
    # result_key FILE KEY -> value, empty when absent
    local value
    value=$(grep -m1 "^$2=" "$1" 2>/dev/null | cut -d= -f2- || true)
    printf '%s' "${value%$'\r'}"
}

result_state() {
    # result_state WORKTREE -> done|blocked|failed|unknown, empty without a file
    local file="$1/$RESULT_FILE" state
    [ -f "$file" ] || return 0
    state=$(result_key "$file" state)
    case "$state" in
        done|blocked|failed) printf '%s' "$state" ;;
        *) printf 'unknown' ;;
    esac
}

state_is_terminal() {
    # state_is_terminal STATE -> 0 when the run is over and the session can no
    # longer take a turn. Idle time is meaningless there: a done card reading
    # `idle 5495s` is a contradiction, not a clock (#57). `refused` is not in
    # this set: stop clears the refusal and the pane is still live.
    case "${1:-}" in
        done|blocked|failed|stopped) return 0 ;;
    esac
    return 1
}

refusal_recorded() {
    # refusal_recorded WORKTREE -> the recorded refusal sentence, empty when
    # the session has not been refused. This survives the pane: the vendor's
    # answer scrolls away while the account stays penalised.
    local file="$1/$REFUSAL_FILE"
    [ -f "$file" ] || return 0
    head -n 1 "$file" 2>/dev/null | tr -d '\r' || true
}

refusal_sentence() {
    # refusal_sentence TEXT -> every line of TEXT that matches a refusal,
    # joined into one line. The anti-automation answer is wrapped prose, so
    # matching lines are what names the refusal without recording the pane.
    local text=${1-} line out=''
    while IFS= read -r line; do
        printf '%s' "$line" | grep -qiE "$REFUSED_RE" || continue
        line=$(printf '%s' "$line" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')
        [ -n "$line" ] || continue
        out+="${out:+ }$line"
    done <<<"$text"
    printf '%s' "$out"
}

refusal_record() {
    # refusal_record WORKTREE SENTENCE -> persist the state and the evidence.
    # The sentence goes to .supervisor.log (not the pane), and .refusal is
    # what keeps status at refused until stop clears it.
    local wt="$1" sentence="$2"
    [ -d "$wt" ] || return 0
    printf '%s\n' "$sentence" >"$wt/$REFUSAL_FILE"
    printf 'refused at=%s sentence=%s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$sentence" >>"$wt/.supervisor.log"
}

clear_refusal() {
    # clear_refusal WORKTREE -> stop is the only thing that clears a refusal
    local wt="$1"
    [ -d "$wt" ] || return 0
    rm -f "$wt/$REFUSAL_FILE"
}

json_str() {
    # json_str STRING -> a quoted JSON string. Session names are already
    # restricted by valid_name, so only values need escaping: a pane carries
    # tabs, newlines and CR from tmux, and prose may carry quotes and
    # backslashes. This is not a general JSON writer, only a string escaper for
    # values this tool produces. Byte-wise in the C locale so a multibyte glyph
    # is re-emitted unchanged instead of being split.
    local s=${1-} out='' c i
    local LC_ALL=C
    for ((i = 0; i < ${#s}; i++)); do
        c=${s:i:1}
        case "$c" in
            '\') out+='\\' ;;
            '"') out+='\"' ;;
            $'\n') out+='\n' ;;
            $'\r') out+='\r' ;;
            $'\t') out+='\t' ;;
            $'\b') out+='\b' ;;
            $'\f') out+='\f' ;;
            [[:cntrl:]])
                printf -v c '\\u%04x' "'$c"
                out+=$c
                ;;
            *) out+=$c ;;
        esac
    done
    printf '"%s"' "$out"
}

json_nullable_str() {
    # json_nullable_str VALUE -> "value", or null for empty and for the `-`
    # placeholder the human views print for "not applicable"
    if [ -n "${1:-}" ] && [ "$1" != '-' ]; then
        json_str "$1"
    else
        printf 'null'
    fi
}

json_nullable_num() {
    # json_nullable_num VALUE -> a bare number, or null when it is not one
    if is_num "${1:-}"; then
        printf '%s' "$1"
    else
        printf 'null'
    fi
}

html_escape() {
    # html_escape STRING -> text that cannot leave its element. Branch names,
    # PR URLs, commit subjects and result text are arbitrary, so every value
    # in the snapshot goes through here; session names are constrained but
    # are escaped too so no value is trusted.
    local s=${1-}
    # The ampersands are backslash-quoted: bash 5.2 replaces an unquoted `&`
    # in a substitution's replacement with the matched text.
    s=${s//&/\&amp;}
    s=${s//</\&lt;}
    s=${s//>/\&gt;}
    s=${s//\"/\&quot;}
    s=${s//\'/\&#39;}
    printf '%s' "$s"
}

json_unescape() {
    # json_unescape STRING -> the decoded content of a JSON string, for
    # display. Only the escapes json_str emits are decoded; a \uXXXX sequence
    # is left as written, which is safe because html_escape runs afterwards.
    local s=${1-} out='' c i
    for ((i = 0; i < ${#s}; i++)); do
        c=${s:i:1}
        if [ "$c" = '\' ] && [ $((i + 1)) -lt ${#s} ]; then
            i=$((i + 1))
            c=${s:i:1}
            case "$c" in
                n|r|t) c=' ' ;;
                b|f) c='' ;;
                '"'|'\'|'/') ;;
                *) c='\'$c ;;
            esac
        fi
        out+=$c
    done
    printf '%s' "$out"
}

json_scalar() {
    # json_scalar VALUE -> a decoded value, empty for null
    local v=${1-}
    [ "$v" != null ] || return 0
    case "$v" in
        \"*\")
            v=${v:1:${#v}-2}
            json_unescape "$v"
            return 0
            ;;
    esac
    printf '%s' "$v"
}

state_class() {
    # state_class STATE -> a CSS class, so only known words reach the markup
    case "${1:-}" in
        done) printf 'done' ;;
        working) printf 'working' ;;
        idle|stopped) printf 'idle' ;;
        refused) printf 'refused' ;;
        blocked|failed) printf 'failed' ;;
        *) printf 'other' ;;
    esac
}

action_form() {
    # action_form NONCE ACTION LABEL -> one server-rendered POST form.
    # The nonce is the server's CSRF secret: a cookie-authenticated POST has
    # no other way to prove the form came from this page. No script, so a
    # stray click is the only risk left, and the stop routes answer with a
    # confirmation page before they act.
    local nonce=$1 action=$2 label=$3
    printf '<form method="post" action="%s">' "$(html_escape "$action")"
    printf '<input type="hidden" name="nonce" value="%s">' \
        "$(html_escape "$nonce")"
    printf '<button type="submit">%s</button></form>' "$(html_escape "$label")"
}

stylesheet_file() {
    # stylesheet_file -> gui/page.css next to the tool. It is the one
    # stylesheet: this renderer inlines it into the snapshot, and
    # gui/server.py inlines the same file into the stop confirmation and the
    # action-result page. Resolved from $0, not ROOT, because the asset ships
    # with the tool rather than with the repository it inspects.
    local dir
    case "$0" in
        */*) dir=$(cd -- "$(dirname -- "$0")" && pwd) ;;
        *) dir=$(cd -- "$(dirname -- "$(command -v -- "$0" 2>/dev/null || printf '%s' "$0")")" && pwd) ;;
    esac
    printf '%s/gui/page.css' "$dir"
}

snapshot_html() {
    # snapshot_html FILE JSON WATCH [LINK_PREFIX] [NOTE] [FORM_NONCE] [FLASH]
    # -> one self-contained page. `sessions --json` is the input: fixed keys,
    # one per line, so the reader below is a field scan rather than a general
    # JSON parser. WATCH is empty for a one shot snapshot and a whole number of
    # seconds for the meta refresh. LINK_PREFIX is `/tty/` when the served page
    # should carry a terminal link per session; NOTE is one line under the
    # header. FORM_NONCE adds the action forms and is empty for a static
    # snapshot, which stays read-only; FLASH is the output of an action that
    # redirected here (the gc report) and is shown above the cards.
    # The CSS is inlined from gui/page.css, shared with gui/server.py's action
    # pages, so the page stays a single file with no external asset.
    local file="$1" json="$2" watch="$3" link_prefix=${4:-} note_text=${5:-}
    local form_nonce=${6:-} flash_text=${7:-}
    local line key value name state idle watcher worktree result branch pr
    local tests="" commit="" wt generated total=0 live=0 trees=0 cards='' card
    local cls pr_html refresh='' css_file
    css_file=$(stylesheet_file)
    [ -f "$css_file" ] ||
        die "gui: missing $css_file (the shared stylesheet next to the tool)"
    generated=$(date -u '+%Y-%m-%d %H:%M:%SZ')
    if [ -n "$watch" ]; then
        refresh="<meta http-equiv=\"refresh\" content=\"$watch\">"
    fi

    while IFS= read -r line; do
        case "$line" in
            '  {'*)
                name='' state='' idle='' watcher='' worktree='' result=''
                branch='' pr=''
                continue
                ;;
            '  }'*)
                total=$((total + 1))
                [ "$worktree" = yes ] && trees=$((trees + 1))
                [ -n "$idle" ] && live=$((live + 1))
                tests=''
                commit=''
                if [ "$worktree" = yes ] && valid_name "$name"; then
                    wt="$ROOT/.worktrees/$name"
                    if [ -f "$wt/$RESULT_FILE" ]; then
                        tests=$(result_key "$wt/$RESULT_FILE" tests)
                        commit=$(result_key "$wt/$RESULT_FILE" commit)
                    fi
                    if [ -z "$commit" ]; then
                        commit=$(git -C "$wt" log -1 --format='%h %s' \
                            2>/dev/null || true)
                    fi
                fi
                cls=$(state_class "$state")
                card="<article class=\"card state-$cls\">"$'\n'
                card+="<header><h2>$(html_escape "$name")</h2>"
                if [ "$worktree" != yes ]; then
                    card+="<span class=\"tag\">no worktree</span>"
                fi
                card+="<span class=\"badge\">"
                card+="$(html_escape "${state:-unknown}")</span></header>"$'\n'
                card+="<dl>"$'\n'
                if [ -n "$idle" ]; then
                    card+="<dt>idle</dt><dd>${idle}s</dd>"$'\n'
                fi
                card+="<dt>watcher</dt><dd>$(html_escape "${watcher:--}")</dd>"$'\n'
                card+="<dt>worktree</dt><dd>$(html_escape "$worktree")</dd>"$'\n'
                card+="<dt>result</dt><dd>$(html_escape "${result:--}")</dd>"$'\n'
                card+="<dt>branch</dt><dd><code>$(html_escape "${branch:--}")</code></dd>"$'\n'
                # A terminal link exists only for a served page with ttyd
                # behind it, and only for a name the tool accepts.
                if [ -n "$link_prefix" ] && [ "$worktree" = yes ] &&
                    valid_name "$name"; then
                    card+="<dt>terminal</dt><dd><a href=\"$(html_escape "$link_prefix$name")\">open in ttyd</a></dd>"$'\n'
                fi
                if [ -n "$pr" ]; then
                    case "$pr" in
                        http://*|https://*)
                            pr_html="<a href=\"$(html_escape "$pr")\">"
                            pr_html+=$(html_escape "$pr")
                            pr_html+='</a>'
                            ;;
                        *) pr_html=$(html_escape "$pr") ;;
                    esac
                else
                    pr_html='-'
                fi
                card+="<dt>pr</dt><dd>$pr_html</dd>"$'\n'
                if [ -n "$commit" ]; then
                    card+="<dt>commit</dt><dd><code>$(html_escape "$commit")</code></dd>"$'\n'
                fi
                if [ -n "$tests" ]; then
                    card+="<dt>tests</dt><dd>$(html_escape "$tests")</dd>"$'\n'
                fi
                card+='</dl>'$'\n'
                # Actions only for a running session the action could end.
                # `done` and `blocked` are result states: the session is
                # already over, so a Stop button would be a lie.
                if [ -n "$form_nonce" ] && [ "$worktree" = yes ] &&
                    valid_name "$name" && [ -n "$idle" ]; then
                    case "${state:-}" in
                        done|stopped|failed|blocked) ;;
                        *)
                            card+='<div class="actions">'
                            card+=$(action_form "$form_nonce" \
                                "/api/session/$name/stop" 'Stop')
                            card+=$(action_form "$form_nonce" \
                                "/api/session/$name/stop?graceful=1" \
                                'Stop (graceful)')
                            card+='</div>'$'\n'
                            ;;
                    esac
                fi
                card+='</article>'$'\n'
                cards+=$card
                continue
                ;;
            '    "'*) ;;
            *) continue ;;
        esac
        key=${line#    \"}
        key=${key%%\"*}
        value=${line#*: }
        value=${value%,}
        value=$(json_scalar "$value")
        case "$key" in
            name) name=$value ;;
            state) state=$value ;;
            idle_seconds) idle=$value ;;
            watcher) watcher=$value ;;
            worktree) worktree=$value ;;
            result) result=$value ;;
            branch) branch=$value ;;
            pr) pr=$value ;;
        esac
    done <<<"$json"

    {
        printf '<!DOCTYPE html>\n'
        printf '<html lang="en">\n<head>\n'
        printf '<meta charset="utf-8">\n'
        printf '<meta name="viewport" content="width=device-width, initial-scale=1">\n'
        # connect-src 'self' is here for Chrome DevTools, which fetches
        # /.well-known/appspecific/com.chrome.devtools.json from the page's
        # origin; without it the probe is blocked and the console shows two
        # violations per load. Same origin only, and there is no script to
        # use the allowance anyway.
        printf '<meta http-equiv="Content-Security-Policy" content="default-src %s; style-src %s; img-src data:; connect-src %s">\n' \
            "'none'" "'unsafe-inline'" "'self'"
        printf '<meta name="referrer" content="no-referrer">\n'
        [ -z "$refresh" ] || printf '%s\n' "$refresh"
        printf '<title>freebuff agents</title>\n'
        printf '<style>\n'
        cat "$css_file"
        printf '</style>\n</head>\n<body>\n'
        printf '<header class="page">\n<h1>freebuff agents</h1>\n'
        printf '<p class="meta">repo %s · generated %s · sessions %s · running %s · worktrees %s · orphans %s</p>\n' \
            "$(html_escape "$ROOT")" "$generated" "$total" "$live" \
            "$trees" "$((total - trees))"
        if [ -n "$note_text" ]; then
            printf '<p class="note">%s</p>\n' "$(html_escape "$note_text")"
        fi
        # The safe action comes first: a dry run reports, it does not stop
        # anything, and its report is useful without a terminal. Nothing to
        # reap means no form.
        if [ -n "$form_nonce" ] && [ "$live" -gt 0 ]; then
            printf '<div class="actions">%s</div>\n' \
                "$(action_form "$form_nonce" '/api/gc?dry=1' 'gc --dry-run')"
        fi
        printf '</header>\n'
        if [ -n "$flash_text" ]; then
            printf '<section class="flash">\n<h2>gc --dry-run</h2>\n<pre>%s</pre>\n</section>\n' \
                "$(html_escape "$flash_text")"
        fi
        printf '<main class="grid">\n'
        if [ "$total" = 0 ]; then
            printf '<p class="empty">no sessions</p>\n'
        else
            printf '%s' "$cards"
        fi
        printf '</main>\n'
        if [ -n "$form_nonce" ]; then
            printf '<footer>Actions are plain server-rendered forms; no script. Stop asks for confirmation before it acts.</footer>\n'
        else
            printf '<footer>Read-only view from spawn-freebuff-agent sessions --json. No script.</footer>\n'
        fi
        printf '</body>\n</html>\n'
    } >"$file.tmp.$$"
    mv "$file.tmp.$$" "$file"
}

pr_json_array() {
    # pr_json_array "pr=#N URL TITLE" lines -> [{number,url,title}, ...]
    # The human `pr=` lines already carry all three, so nesting them loses
    # nothing. Empty input is [] rather than null: null means gh was not asked.
    local line number url title first=1
    printf '['
    while IFS=$'\t' read -r number url title; do
        case "$number" in
            ''|*[!0-9]*) continue ;;
        esac
        [ "$first" = 1 ] || printf ', '
        first=0
        printf '{"number": %s, "url": %s, "title": %s}' \
            "$number" "$(json_str "$url")" "$(json_str "${title:-}")"
    done <<<"$(printf '%s\n' "${1:-}" |
        sed -E 's/^pr=#([0-9]+) ([^ ]+)( (.*))?$/\1\t\2\t\4/')"
    printf ']'
}

sha256_hex() {
    # sha256_hex -> a hex digest of stdin, from the first tool present. Only
    # stability matters (the same window must hash the same twice), so cksum
    # is a last resort on a machine with none of the hash tools.
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 | cut -d' ' -f1
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 | sed 's/^.*= //'
    else
        cksum | cut -d' ' -f1
    fi
}

normalise_window() {
    # normalise_window (stdin) -> text a repaint cannot change: no ANSI, no
    # padding, no clocks. Box-drawing rules are dropped because a redraw can
    # reflow them; their content lines stay. Two captures of one unclassified
    # pane hash the same even when the spacing or the elapsed time differs.
    local LC_ALL=C
    sed -E \
        -e $'s/\x1b\\][^\x07]*\x07//g' \
        -e $'s/\x1b\\[[0-9;?]*[A-Za-z]//g' \
        -e 's/\r$//' \
        -e 's/[[:space:]]+/ /g' \
        -e 's/^ //' -e 's/ $//' \
        -e 's/[0-9]+(\.[0-9]+)?(ms|s|m|h)([^0-9A-Za-z]|$)/<time>\3/g' \
        -e 's/(^|[^0-9])[0-9][0-9]?:[0-9][0-9](:[0-9][0-9])?/\1<time>/g' \
        | sed -E '/^[─━═╭╮╰╯│┃├┤┬┴┼╔╗╚╝║╠╣╦╩╬ ]*$/d'
}

first_match() {
    # first_match REGEX TEXT -> the first matching line, trimmed; empty on none
    local line
    line=$(printf '%s\n' "$2" | grep -m1 -iE -- "$1" 2>/dev/null || true)
    line=${line%$'\r'}
    line=$(printf '%s' "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')
    printf '%s' "$line"
}

evidence_field() {
    # evidence_field BLOCK KEY -> the first KEY= value in an evidence block
    local block="$1" key="$2" line
    while IFS= read -r line; do
        case "$line" in
            "$key"=*) printf '%s' "${line#"$key"=}"; return 0 ;;
        esac
    done <<<"$block"
}

# classify_chrome fills these, so a rescan can reuse one rule table.
PANE_STATE=''
PANE_RULE=''
PANE_MATCHED=''
PANE_CHECKS=''

classify_chrome() {
    # classify_chrome PANE CHROME -> sets PANE_STATE (empty when nothing
    # matched), PANE_RULE, PANE_MATCHED and the checks that were run. The
    # order is the tool's existing precedence; only the terminal fallback
    # changed.
    local pane="$1" chrome="$2" matched
    PANE_STATE=''
    PANE_RULE=''
    PANE_MATCHED=''
    PANE_CHECKS=''

    # The refusal can be the turn text above the resting prompt, not just the
    # 12-line chrome window, so scan enough scrollback to see the answer.
    matched=$(first_match "$REFUSED_RE" "$pane")
    PANE_CHECKS+="check: refusal-prose: $([ -n "$matched" ] && printf yes || printf no)"
    if [ -n "$matched" ]; then
        PANE_STATE=refused
        PANE_RULE=refusal-prose
        PANE_MATCHED=$matched
        return 0
    fi

    matched=$(first_match "$BUSY_RE" "$chrome")
    PANE_CHECKS+=$'\n'"check: busy-marker pattern=\"$BUSY_RE\": $([ -n "$matched" ] && printf yes || printf no)"
    if [ -n "$matched" ]; then
        PANE_STATE=working
        PANE_RULE=busy-marker
        PANE_MATCHED=$matched
        return 0
    fi

    # The resting prompt means no turn is running, so it outranks the
    # protected strings: the startup `Can't reach Freebuff` banner lands in the
    # same 12-line window and would otherwise pin a finished session at
    # `working` forever, which is the leak this tool exists to prevent.
    matched=$(first_match 'Enter a coding task' "$chrome")
    PANE_CHECKS+=$'\n'"check: resting-prompt pattern=\"Enter a coding task\": $([ -n "$matched" ] && printf yes || printf no)"
    if [ -n "$matched" ]; then
        PANE_STATE=idle
        PANE_RULE=resting-prompt
        PANE_MATCHED=$matched
        return 0
    fi

    matched=$(first_match "$PROTECTED_RE" "$chrome")
    PANE_CHECKS+=$'\n'"check: protected-window pattern=\"$PROTECTED_RE\": $([ -n "$matched" ] && printf yes || printf no)"
    if [ -n "$matched" ]; then
        PANE_STATE=working
        PANE_RULE=protected-window
        PANE_MATCHED=$matched
        return 0
    fi
}

# The classifier's window, shared by emit_evidence and the status view.
EV_PANE=''
EV_LINES=0
EV_SHA=''

emit_evidence() {
    # emit_evidence STATE RULE MATCHED SCANS CHECKS -> the evidence block.
    # The first line is `state=...` because session_state reads only that;
    # everything after it is what --explain shows line by line.
    local state="$1" rule="$2" matched="$3" scans="$4" checks="$5"
    printf 'state=%s\nrule=%s\nmatched=%s\nwindow_lines=%s\nwindow_sha256=%s\nstable_scans=%s\n' \
        "$state" "$rule" "${matched:0:200}" "$EV_LINES" "$EV_SHA" "$scans"
    [ -z "$checks" ] || printf '%s\n' "$checks"
    printf 'pane_begin\n%s\npane_end\n' "$EV_PANE"
}

classify_state() {
    # classify_state NAME [WINDOW] -> evidence block; line one is
    # `state=done|refused|working|idle|unknown|missing`. Read-only: captures
    # only, never sends, stops or writes. A first scan that no rule claims is
    # captured again after a pause, and only the same normalised window twice
    # becomes `unknown`.
    local name="$1" window="${2:-$REFUSAL_WINDOW}"
    local session="fb-$name" wt="$ROOT/.worktrees/$name" tmux
    local sentence result pane chrome norm norm2 base_checks checks
    tmux=$(tmux_bin 2>/dev/null || true)

    EV_PANE=''
    EV_LINES=0
    EV_SHA=''

    if [ -z "$tmux" ] || ! "$tmux" has-session -t "$session" 2>/dev/null; then
        checks="check: session (fb-$name): no"
        emit_evidence missing no-session '' 0 "$checks"
        return 0
    fi
    checks="check: session (fb-$name): yes"

    # A refusal recorded by start outranks the pane: the turn ends, the
    # sentence scrolls away and the prompt comes back, but the account is
    # still penalised. stop removes the file.
    sentence=$(refusal_recorded "$wt")
    checks+=$'\n'"check: recorded-refusal ($REFUSAL_FILE): $([ -n "$sentence" ] && printf yes || printf no)"
    if [ -n "$sentence" ]; then
        emit_evidence refused recorded-refusal "$sentence" 0 "$checks"
        return 0
    fi
    base_checks=$checks

    result=$(result_state "$wt")
    base_checks+=$'\n'"check: result-file ($RESULT_FILE): ${result:-no}"
    case "$result" in
        done|blocked|failed)
            # The result file names the outcome, so a blocked or failed run
            # must not be reported as done: a wait contract built on `done`
            # would otherwise call failure success.
            emit_evidence "$result" result-file "$result" 0 "$base_checks"
            return 0
            ;;
    esac

    EV_PANE=$("$tmux" capture-pane -p -t "$session" -S "-$window" 2>/dev/null || true)
    EV_LINES=$(printf '%s' "$EV_PANE" | awk 'END { print NR }')
    chrome=$(printf '%s\n' "$EV_PANE" | tail -n 12)
    classify_chrome "$EV_PANE" "$chrome"
    if [ -n "$PANE_STATE" ]; then
        EV_SHA=$(printf '%s\n' "$EV_PANE" | normalise_window | sha256_hex)
        emit_evidence "$PANE_STATE" "$PANE_RULE" "$PANE_MATCHED" 1 \
            "$base_checks"$'\n'"$PANE_CHECKS"
        return 0
    fi

    # Nothing claimed the first scan. A boot frame or a mid-repaint must not
    # raise `unknown`: capture again, and let a pane that settled into a known
    # state be classified by that state.
    norm=$(printf '%s\n' "$EV_PANE" | normalise_window)
    sleep "$UNKNOWN_RESCAN_DELAY"
    EV_PANE=$("$tmux" capture-pane -p -t "$session" -S "-$window" 2>/dev/null || true)
    EV_LINES=$(printf '%s' "$EV_PANE" | awk 'END { print NR }')
    chrome=$(printf '%s\n' "$EV_PANE" | tail -n 12)
    norm2=$(printf '%s\n' "$EV_PANE" | normalise_window)
    EV_SHA=$(printf '%s\n' "$norm2" | sha256_hex)
    classify_chrome "$EV_PANE" "$chrome"
    checks="$base_checks"$'\n'"$PANE_CHECKS"$'\n'"check: stable-window: $([ "$norm" = "$norm2" ] && printf yes || printf no)"
    if [ -n "$PANE_STATE" ]; then
        emit_evidence "$PANE_STATE" "$PANE_RULE" "$PANE_MATCHED" 2 "$checks"
    elif [ "$norm" = "$norm2" ]; then
        emit_evidence unknown no-rule-matched '' 2 "$checks"
    else
        # Changing but unrecognised: not enough evidence to call it unknown.
        # Keep the old safe failure mode for this scan and look again next poll.
        emit_evidence working unstable-window '' 2 "$checks"
    fi
}

session_state() {
    # session_state NAME -> done|blocked|failed|refused|working|idle|unknown|missing
    local block first
    block=$(classify_state "$1")
    first=${block%%$'\n'*}
    printf '%s' "${first#state=}"
}

session_activity() {
    # session_activity NAME -> epoch of last tmux activity; fails when unknown
    local tmux activity
    tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$tmux" ] || return 1
    activity=$("$tmux" display-message -p -t "fb-$1" '#{session_activity}' 2>/dev/null || true)
    is_num "$activity" || return 1
    printf '%s' "$activity"
}

idle_seconds() {
    # idle_seconds NAME -> non-negative seconds since tmux activity, or empty
    local activity
    activity=$(session_activity "$1" 2>/dev/null || true)
    is_num "$activity" || return 0
    local now elapsed
    now=$(date +%s)
    elapsed=$((now - activity))
    [ "$elapsed" -ge 0 ] || elapsed=0
    printf '%s' "$elapsed"
}

write_task() {
    local file="$1" slug="${2:-}" issue="$3" title="$4" url="$5" branch="$6" base="$7"
    cat >"$file" <<EOF
# Task: issue #$issue — $title

Repo: ${slug:-this repository}. Branch: \`$branch\` (based on \`$base\`).
Issue: $url
Read it with: \`gh issue view $issue${slug:+ -R $slug}\`.

## Deliverable

Implement the issue end to end in this worktree. Follow the repository's
existing conventions. Add or update the tests the change needs. Run the
relevant checks and report exactly what was run.

## Constraints

- Work only in this worktree. Do not modify the main worktree or another
  worktree.
- Do not commit \`.task.md\`, \`.agent-result\` or \`local.properties\`.
- Do not touch unrelated files.
- If you need the phone, do not reboot or lock it; read-only adb checks only.
- If blocked, commit what works and open a draft PR explaining the blocker.

## Finish

Commit with a conventional message, push \`$branch\`, and open a PR against
\`$base\` with \`gh pr create\`. The PR body must link #$issue and list what
was tested. Report the PR URL, branch, commit and tests in your final message.

As your last action, write \`.agent-result\` in this worktree root. Use one
\`key=value\` per line, no JSON:

    state=done          # done, blocked or failed
    pr=<PR URL, or none>
    commit=<short sha, or none>
    tests=<one line: what you ran>

Use \`state=blocked\` when you opened a draft PR because of a blocker and
\`state=failed\` when the branch is not usable. Write the file even when
blocked, and do not commit it.
EOF
}

ready_polls() {
    # ready_polls TIMEOUT POLL -> poll intervals that fit in TIMEOUT, rounded
    # up, so the deadline follows --ready-timeout instead of a fixed count.
    awk -v t="$1" -v p="$2" 'BEGIN {
        n = t / p; c = int(n); if (n > c) c++; if (c < 1) c = 1
        printf "%d", c
    }'
}

ready_elapsed() {
    # ready_elapsed POLLS POLL -> seconds spent polling, with one decimal so a
    # sub-second interval is visible. awk is already used for the brief ledger.
    awk -v n="$1" -v p="$2" 'BEGIN { printf "%.1f", n * p }'
}

ready_note() {
    # ready_note WORKTREE MESSAGE -> a readiness line on stdout and in
    # .supervisor.log, so a slow launch is evidence instead of silence after
    # the terminal is gone.
    local wt="$1"
    shift
    note "$*"
    [ -d "$wt" ] || return 0
    printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >>"$wt/.supervisor.log"
}

wait_ready() {
    # wait_ready TMUX SESSION WORKTREE TIMEOUT POLL -> 0 ready, 2 refused,
    # 1 never ready inside TIMEOUT. A refusal is checked first: the overlay
    # never draws the resting prompt, and typing into it would take over
    # another live session instead of starting this one. The wait is a
    # predicate with a deadline, not a fixed sleep count: it re-checks every
    # POLL seconds until TIMEOUT has passed, so a warm pane returns on the
    # first check and a cold launch gets the whole --ready-timeout budget.
    # READY_ELAPSED is set for the caller's log line and failure message.
    local tmux="$1" session="$2" wt="$3" timeout="$4" poll="$5"
    local polls i=0 tty pane
    polls=$(ready_polls "$timeout" "$poll")
    while :; do
        if ! "$tmux" has-session -t "$session" 2>/dev/null; then
            READY_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 1
        fi
        tty=$("$tmux" display-message -p -t "$session" '#{pane_tty}' 2>/dev/null || true)
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        if printf '%s\n' "$pane" | grep -qiE "$REFUSED_RE"; then
            READY_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 2
        fi
        if [ -n "$tty" ] &&
            stty -a -F "$tty" 2>/dev/null | grep -q -- '-icanon' &&
            printf '%s' "$pane" | grep -q 'Enter a coding task'; then
            READY_ELAPSED=$(ready_elapsed "$i" "$poll")
            ready_note "$wt" "ready=yes elapsed=${READY_ELAPSED}s timeout=${timeout}s poll=${poll}s"
            return 0
        fi
        i=$((i + 1))
        if [ "$i" -ge "$polls" ]; then
            READY_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 1
        fi
        if [ $((i % READY_NOTE_POLLS)) -eq 0 ]; then
            ready_note "$wt" "waiting-for-ready=yes elapsed=$(ready_elapsed "$i" "$poll")s timeout=${timeout}s poll=${poll}s"
        fi
        sleep "$poll"
    done
}

composer_line() {
    # composer_line PANE -> the TUI's input line, the one carrying the `▍`
    # glyph. A brief that was never submitted is still drawn there; an empty
    # composer shows the resting or the mid-turn prompt instead.
    printf '%s\n' "$1" | grep -F '▍' | tail -n 1 || true
}

chat_title() {
    # chat_title PANE -> the `Chat: ...` label the chrome draws. A brief the
    # client accepted names the chat after the task instead of `New chat`.
    printf '%s\n' "$1" | sed -n 's/.*Chat: //p' | tail -n 1 || true
}

composer_cleared() {
    # composer_cleared PANE -> 0 when the input line is empty again. Both the
    # resting prompt and the mid-turn prompt are empty-composer chrome; the
    # typed brief still sitting in the line is not, whether the Enter was
    # swallowed or never arrived.
    local line
    line=$(composer_line "$1")
    case "$line" in
        *'Enter a coding task'*|*'Add to the current task'*) return 0 ;;
    esac
    return 1
}

turn_began() {
    # turn_began PANE -> 0 when a turn is in flight. The mid-turn composer
    # carries no busy marker but it is not a brief waiting for Enter either:
    # the README already treats `Add to the current task` as busy while a turn
    # is in flight, so it is proof that the input was submitted.
    local chrome
    chrome=$(printf '%s\n' "$1" | tail -n 12)
    if printf '%s\n' "$chrome" | grep -qiE "$BUSY_RE"; then
        return 0
    fi
    printf '%s\n' "$chrome" | grep -qF 'Add to the current task'
}

await_submission() {
    # await_submission TMUX SESSION BEFORE_TITLE TIMEOUT POLL ->
    # 0 submitted, 2 refused, 1 no proof inside TIMEOUT. The brief has already
    # been typed and Entered; this reads the pane until it can prove the send
    # was taken. Proof is the input line clearing plus either a turn in flight
    # or a changed chat title. A refusal is checked first, because its answer
    # arrives as a finished turn above the resting prompt. Nothing is retyped
    # here: a deadline that passes returns 1 and the caller reports sent=no.
    local tmux="$1" session="$2" before_title="$3" timeout="$4" poll="$5"
    local polls i=0 pane chrome title
    polls=$(ready_polls "$timeout" "$poll")
    SUBMIT_PROOF=''
    SUBMIT_ELAPSED=0.0
    while :; do
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        if printf '%s\n' "$pane" | grep -qiE "$REFUSED_RE"; then
            SUBMIT_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 2
        fi
        chrome=$(printf '%s\n' "$pane" | tail -n 12)
        if composer_cleared "$pane"; then
            if turn_began "$pane"; then
                SUBMIT_PROOF=turn-began
                SUBMIT_ELAPSED=$(ready_elapsed "$i" "$poll")
                return 0
            fi
            title=$(chat_title "$chrome")
            if [ -n "$title" ] && [ "$title" != "$before_title" ]; then
                SUBMIT_PROOF=chat-title
                SUBMIT_ELAPSED=$(ready_elapsed "$i" "$poll")
                return 0
            fi
        fi
        i=$((i + 1))
        if [ "$i" -ge "$polls" ]; then
            SUBMIT_ELAPSED=$(ready_elapsed "$i" "$poll")
            return 1
        fi
        sleep "$poll"
    done
}

brief_hash() {
    # brief_hash TEXT -> a stable digest of the text about to be typed.
    # sha256sum is coreutils, shasum ships with macOS and cksum is the POSIX
    # last resort; the ledger is only ever read by this same tool, so a
    # weaker digest on a bare phone is enough to notice a repeat.
    if command -v sha256sum >/dev/null 2>&1; then
        printf '%s' "${1-}" | sha256sum | cut -d' ' -f1
    elif command -v shasum >/dev/null 2>&1; then
        printf '%s' "${1-}" | shasum -a 256 | cut -d' ' -f1
    else
        printf '%s' "${1-}" | cksum | tr ' ' '-'
    fi
}

brief_ledger_file() {
    printf '%s/%s' "$ROOT" "$BRIEF_LEDGER"
}

brief_ledger_seen() {
    # brief_ledger_seen HASH -> the last ledger line carrying that hash, empty
    # when the brief was not sent inside the retained window.
    local file
    file=$(brief_ledger_file)
    [ -f "$file" ] || return 0
    grep -F "\"hash\": \"$1\"" "$file" 2>/dev/null | tail -n 1 || true
}

brief_ledger_trim() {
    # Keep the last BRIEF_LEDGER_KEEP entries, plus every entry marked refused.
    # A refused brief is never resent, so its hash has to outlive the window
    # instead of ageing out and being typed again next week.
    local file tmp
    file=$(brief_ledger_file)
    [ -f "$file" ] || return 0
    tmp="$file.tmp.$$"
    awk -v keep="$BRIEF_LEDGER_KEEP" '
        { line[NR] = $0; if ($0 ~ /"refused": true/) keepit[NR] = 1 }
        END {
            first = NR - keep + 1
            if (first < 1) first = 1
            for (i = 1; i <= NR; i++) {
                if (keepit[i] || i >= first) print line[i]
            }
        }
    ' "$file" >"$tmp"
    mv "$tmp" "$file"
}

brief_ledger_record() {
    # brief_ledger_record HASH NAME BRANCH [REFUSED] -> one JSON line, then
    # trim. REFUSED marks the text as one the vendor rejected, which the
    # ledger keeps past the window.
    local file line refused=${4:-}
    file=$(brief_ledger_file)
    mkdir -p "$(dirname "$file")"
    if [ -n "$refused" ]; then
        line=$(printf '{"at": %s, "name": %s, "branch": %s, "hash": %s, "refused": true}' \
            "$(json_str "$(date -u '+%Y-%m-%dT%H:%M:%SZ')")" \
            "$(json_str "${2:-}")" "$(json_str "${3:-}")" "$(json_str "${1:-}")")
    else
        line=$(printf '{"at": %s, "name": %s, "branch": %s, "hash": %s}' \
            "$(json_str "$(date -u '+%Y-%m-%dT%H:%M:%SZ')")" \
            "$(json_str "${2:-}")" "$(json_str "${3:-}")" "$(json_str "${1:-}")")
    fi
    printf '%s\n' "$line" >>"$file"
    brief_ledger_trim
}

brief_ledger_mark_refused() {
    # brief_ledger_mark_refused HASH NAME BRANCH -> mark the send that the
    # vendor refused. This is the same ledger as #48, not a second one: the
    # hash that was typed is the hash that must never be typed again.
    local file hash=$1 name=${2:-} branch=${3:-} tmp
    file=$(brief_ledger_file)
    mkdir -p "$(dirname "$file")"
    if [ -f "$file" ] && grep -qF "\"hash\": \"$hash\"" "$file"; then
        tmp="$file.tmp.$$"
        awk -v h="\"hash\": \"$hash\"" '
            index($0, h) && index($0, "\"refused\": true") == 0 {
                sub(/\}$/, ", \"refused\": true}")
            }
            { print }
        ' "$file" >"$tmp"
        mv "$tmp" "$file"
    else
        brief_ledger_record "$hash" "$name" "$branch" refused
    fi
    brief_ledger_trim
}

refuse_sent_brief() {
    # refuse_sent_brief HASH -> die when that text was already sent recently
    # or was refused by the vendor at any time. This runs before the worktree
    # is created, so a refusal costs no worktree and no keystroke; the earlier
    # send is named so the caller can change the brief instead of retrying.
    local seen at prev
    seen=$(brief_ledger_seen "$1")
    [ -n "$seen" ] || return 0
    at=$(printf '%s' "$seen" | sed -n 's/.*"at": "\([^"]*\)".*/\1/p')
    prev=$(printf '%s' "$seen" | sed -n 's/.*"name": "\([^"]*\)".*/\1/p')
    if printf '%s' "$seen" | grep -q '"refused": true'; then
        die "start: refusing a brief Freebuff already refused: its text was sent to ${prev:-another session} at ${at:-an earlier run} (hash $1) and rejected as scripted or automated use. A refused brief is never resent, so nothing was sent and nothing was created. Give this session different text (a different issue, name or --prompt)."
    fi
    die "start: refusing a duplicate brief: its text was already sent to ${prev:-another session} at ${at:-an earlier run} (hash $1). Freebuff refuses a repeated identical message as scripted or automated use and counts a strike, so nothing was sent and nothing was created. Give this session a different brief, name or issue, or pass a different --prompt."
}

compose_brief() {
    # compose_brief NAME BRANCH WORKTREE ISSUE PROMPT -> the text typed into
    # the TUI. It names real content (session, branch, worktree, issue) so the
    # stock brief cannot repeat; PROMPT replaces it entirely, and is then the
    # caller's job to keep unique (the ledger catches it otherwise).
    local name=$1 branch=$2 wt=$3 issue=$4 prompt=${5:-}
    if [ -n "$prompt" ]; then
        printf '%s' "$prompt"
        return 0
    fi
    local text="$PROMPT Session $name, branch $branch, worktree $wt."
    [ -z "$issue" ] || text="$text Issue #$issue."
    printf '%s' "$text"
}

brief_jitter_max() {
    # brief_jitter_max MAX_SESSIONS -> upper bound for the random delay before
    # a send. Only a pool of several slots is paced: one slot cannot fire two
    # starts at once. FREEBUFF_START_JITTER overrides it, 0 disables the wait.
    local max=$1 bound
    [ "${max:-0}" -gt 1 ] || {
        printf '0'
        return 0
    }
    bound=${FREEBUFF_START_JITTER:-$((max * 2))}
    is_num "$bound" || bound=0
    printf '%s' "$bound"
}

start() {
    local issue="" name="" branch="" base="main" title="" url="" task_file=""
    local sdk_dir="" dry=0 nostart=0 autostop=0 idle=120 poll=5
    local idle_set=0 poll_set=0 max_sessions=0 wait_slot=0 slot_wait=300
    local ready_timeout="$READY_TIMEOUT" ready_poll="$READY_POLL"
    local submit_timeout="$SUBMIT_TIMEOUT"
    local prompt_text="" sent brief_hash_value jitter_max jitter=0
    local ready_rc=0 submit_rc=0 pane refusal="" title_before
    while [ $# -gt 0 ]; do
        case "$1" in
            --issue) issue=${2:-}; shift 2 ;;
            --name) name=${2:-}; shift 2 ;;
            --branch) branch=${2:-}; shift 2 ;;
            --base) base=${2:-}; shift 2 ;;
            --task-file) task_file=${2:-}; shift 2 ;;
            --title) title=${2:-}; shift 2 ;;
            --url) url=${2:-}; shift 2 ;;
            --sdk-dir) sdk_dir=${2:-}; shift 2 ;;
            --auto-stop) autostop=1; shift ;;
            --idle-seconds) idle=${2:-}; idle_set=1; shift 2 ;;
            --poll) poll=${2:-}; poll_set=1; shift 2 ;;
            --ready-timeout) ready_timeout=${2:-}; shift 2 ;;
            --ready-poll) ready_poll=${2:-}; shift 2 ;;
            --submit-timeout) submit_timeout=${2:-}; shift 2 ;;
            --max-sessions) max_sessions=${2:-}; shift 2 ;;
            --wait-slot)
                wait_slot=1
                case "${2:-}" in
                    ''|*[!0-9]*) shift ;;
                    *) slot_wait=$2; shift 2 ;;
                esac
                ;;
            --dry-run) dry=1; shift ;;
            --no-start) nostart=1; shift ;;
            --prompt) prompt_text=${2:-}; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            *) die "start: unsupported argument: $1" ;;
        esac
    done

    case "$issue" in
        ''|*[!0-9]*) die "start: --issue must be a number" ;;
    esac
    name=${name:-"issue-$issue"}
    branch=${branch:-"issue/$issue"}
    valid_name "$name" || die "start: name may only contain letters, digits, _ and -"
    [ -n "$branch" ] || die "start: branch is empty"
    is_num "$idle" || die "start: --idle-seconds must be a number"
    is_num "$poll" || die "start: --poll must be a number"
    is_num "$ready_timeout" || die "start: --ready-timeout must be a number of seconds"
    [ "$ready_timeout" -ge 1 ] || die "start: --ready-timeout must be at least 1 second"
    is_duration "$ready_poll" || die "start: --ready-poll must be a positive number of seconds"
    is_num "$submit_timeout" || die "start: --submit-timeout must be a number of seconds"
    [ "$submit_timeout" -ge 1 ] || die "start: --submit-timeout must be at least 1 second"
    if [ "$autostop" = 0 ] && { [ "$idle_set" = 1 ] || [ "$poll_set" = 1 ]; }; then
        die "start: --idle-seconds and --poll require --auto-stop"
    fi
    is_num "$max_sessions" || die "start: --max-sessions must be a number"
    if [ "$max_sessions" = 0 ] && [ "$wait_slot" = 1 ]; then
        die "start: --wait-slot needs --max-sessions N (nothing to wait for otherwise)"
    fi

    local slug wt session result
    slug=$(repo_slug || true)
    wt="$ROOT/.worktrees/$name"
    session="fb-$name"
    result="$wt/$RESULT_FILE"
    # The brief and its identity are known before anything is created, so a
    # duplicate is a hard error rather than a spent worktree and a strike.
    sent=$(compose_brief "$name" "$branch" "$wt" "$issue" "$prompt_text")
    brief_hash_value=$(brief_hash "$sent")
    jitter_max=$(brief_jitter_max "$max_sessions")

    if [ -z "$title" ] || [ -z "$url" ]; then
        if [ -n "$slug" ] && command -v "${GH_BIN:-gh}" >/dev/null 2>&1; then
            local meta
            meta=$("${GH_BIN:-gh}" issue view "$issue" -R "$slug" \
                --json title,url --jq '[.title,.url]|@tsv' 2>/dev/null || true)
            if [ -n "$meta" ]; then
                title=${title:-${meta%%$'\t'*}}
                url=${url:-${meta#*$'\t'}}
            fi
        fi
        title=${title:-"issue #$issue"}
        url=${url:-"https://github.com/${slug:-owner/repo}/issues/$issue"}
    fi

    if [ "$dry" = 1 ]; then
        note "worktree=$wt"
        note "branch=$branch"
        note "base=$base"
        note "session=$session"
        note "task=$wt/.task.md"
        note "result=$result"
        note "brief_hash=$brief_hash_value"
        note "brief_chars=${#sent}"
        [ "$jitter_max" = 0 ] || note "jitter_max=${jitter_max}s"
        note "ready_timeout=${ready_timeout}s ready_poll=${ready_poll}s"
        note "submit_timeout=${submit_timeout}s"
        note "tmux=${FREEBUFF_TMUX:-tmux} -x $COLS -y $ROWS -c $wt"
        if [ "$autostop" = 1 ]; then
            note "autostop=yes idle_seconds=$idle poll=$poll"
        fi
        if [ "$max_sessions" -gt 0 ]; then
            note "max_sessions=$max_sessions live=$(live_session_count) wait_slot=$wait_slot"
        fi
        return 0
    fi

    # Every session shares one account, so a launch is pointless while the
    # limit is reached: the pane stops on the overlay and never takes input.
    # Check before spending a worktree, and wait for a slot if asked.
    if [ "$max_sessions" -gt 0 ]; then
        local live deadline
        live=$(live_session_count)
        if [ "$live" -ge "$max_sessions" ]; then
            if [ "$wait_slot" = 0 ]; then
                die "start: $live fb-* session(s) already live (--max-sessions $max_sessions); stop one or pass --wait-slot"
            fi
            deadline=$(( $(date +%s) + slot_wait ))
            note "waiting-for-slot=yes live=$live max=$max_sessions timeout=${slot_wait}s"
            while [ "$live" -ge "$max_sessions" ]; do
                if [ "$(date +%s)" -ge "$deadline" ]; then
                    die "start: still $live fb-* session(s) after ${slot_wait}s; nothing was created"
                fi
                sleep 5
                live=$(live_session_count)
                note "waiting-for-slot=yes live=$live"
            done
            note "slot-free=yes live=$live"
        fi
    fi

    if [ -e "$wt" ]; then
        die "start: worktree already exists: $wt (try status $name)"
    fi
    if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
        die "start: branch already exists: $branch"
    fi
    if ! git -C "$ROOT" rev-parse --verify "$base^{commit}" >/dev/null 2>&1; then
        die "start: base ref not found: $base"
    fi

    # A brief already sent inside the ledger window is a hard error: the
    # vendor reads it as scripted use and answers with a strike. --no-start
    # sends nothing, so it has nothing to refuse.
    [ "$nostart" = 1 ] || refuse_sent_brief "$brief_hash_value"

    ensure_excludes
    mkdir -p "$ROOT/.worktrees"
    git -C "$ROOT" worktree add -b "$branch" "$wt" "$base" >/dev/null

    if [ -n "$sdk_dir" ]; then
        printf 'sdk.dir=%s\n' "$sdk_dir" >"$wt/local.properties"
    elif [ -f "$ROOT/local.properties" ]; then
        cp "$ROOT/local.properties" "$wt/local.properties"
    fi

    if [ -n "$task_file" ]; then
        [ -f "$task_file" ] || die "start: task file not found: $task_file"
        cp "$task_file" "$wt/.task.md"
    else
        write_task "$wt/.task.md" "$slug" "$issue" "$title" "$url" "$branch" "$base"
    fi

    note "created=$wt"
    note "branch=$branch"
    note "task=$wt/.task.md"
    note "result=$result"

    if [ "$nostart" = 1 ]; then
        return 0
    fi

    local tmux fb cmd held
    tmux=$(tmux_bin) || die "start: tmux not found; install tmux or set FREEBUFF_TMUX"
    fb=$(freebuff_bin) || die "start: freebuff not found; set FREEBUFF_BIN"
    printf -v cmd 'TERM=xterm-256color %q --cwd %q --trust-agents' "$fb" "$wt"
    "$tmux" new-session -d -s "$session" -x "$COLS" -y "$ROWS" -c "$wt" "$cmd"

    wait_ready "$tmux" "$session" "$wt" "$ready_timeout" "$ready_poll" || ready_rc=$?
    if [ "$ready_rc" -eq 2 ]; then
        # The overlay is a refusal, not a slow start. Its Enter key takes over
        # another live session, so no keys are typed at all; the worktree and
        # the sentence are kept so status reports refused until stop.
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        refusal=$(refusal_sentence "$pane")
        [ -n "$refusal" ] || refusal='Freebuff refused the launch'
        refusal_record "$wt" "$refusal"
        "$tmux" kill-session -t "$session" 2>/dev/null || true
        note "session=$session"
        note 'refused=yes'
        note "refusal=$refusal"
        note 'sent=no'
        # A concurrent-session refusal is about live TUIs, not runs, and the
        # overlay names neither. Name the finished sessions that hold the slots
        # and the one command that frees them, so the next step is not a guess:
        # each of them has already reported its result, so nothing is lost.
        if printf '%s\n' "$refusal" | grep -qiE "$REFUSAL_OVERLAY_RE"; then
            held=$(finished_live_names "$tmux")
            if [ -n "$held" ]; then
                note "holding_slot=$held"
                note "hint=free them with: $(basename "$0") gc"
            fi
        fi
        die "start: Freebuff refused the launch before the brief was sent: $refusal (no keys typed; worktree kept at $wt)"
    fi
    if [ "$ready_rc" -ne 0 ]; then
        printf '%s\n' '--- last pane lines ---'
        "$tmux" capture-pane -p -t "$session" -S -15 2>/dev/null || true
        # A pane that never reached raw input can never accept the brief, so it
        # is dead weight. Kill only the session; the worktree and branch stay.
        "$tmux" kill-session -t "$session" 2>/dev/null || true
        ready_note "$wt" "ready=timeout elapsed=${READY_ELAPSED}s timeout=${ready_timeout}s poll=${ready_poll}s session=$session"
        die "start: TUI did not reach raw input in $session after ${READY_ELAPSED}s (--ready-timeout $ready_timeout, --ready-poll $ready_poll); stopped it, worktree kept ($wt). A cold first launch can need a larger --ready-timeout."
    fi

    # A brief that is byte-identical across sessions reads as scripted use to
    # the vendor, which refuses the message and counts a strike. `sent` was
    # composed from the session, branch, worktree and issue, and its hash
    # cleared the ledger above, so this exact text has not been sent recently.
    if [ "$jitter_max" -gt 0 ]; then
        jitter=$((RANDOM % (jitter_max + 1)))
        note "jitter=${jitter}s max=${jitter_max}s"
        sleep "$jitter"
    fi
    # The chat title before the send is the baseline the proof compares
    # against; `Chat: New chat` becoming the task's name is one of the two
    # ways a swallowed Enter is told apart from an accepted one.
    title_before=$(chat_title "$("$tmux" capture-pane -p -t "$session" -S -12 2>/dev/null || true)")
    "$tmux" send-keys -t "$session" -l "$sent"
    sleep 0.5
    "$tmux" send-keys -t "$session" C-m

    # The Enter is not proof. A pane that is ready can still swallow it: the
    # composer clears and the session sits at the idle prompt with no turn,
    # which used to print started=yes. Wait for the input line to clear and
    # for the turn to begin (or the title to change), bounded by
    # --submit-timeout. Nothing is retyped: a brief that cannot be proven is
    # reported, not doubled.
    await_submission "$tmux" "$session" "$title_before" \
        "$submit_timeout" "$ready_poll" || submit_rc=$?
    if [ "$submit_rc" -eq 2 ]; then
        # The vendor's anti-automation answer arrives as a finished turn, not
        # as chrome: the sentence is above the resting prompt and the session
        # looks idle. Check the turn text before claiming the launch succeeded.
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
        refusal=$(refusal_sentence "$pane")
        [ -n "$refusal" ] || refusal='Freebuff refused the brief'
        refusal_record "$wt" "$refusal"
        # Reuse the #48 ledger: this exact text was refused, so it must never
        # be typed again, even after it would have aged out of the window.
        brief_ledger_mark_refused "$brief_hash_value" "$name" "$branch"
        note "session=$session"
        note 'refused=yes'
        note "refusal=$refusal"
        note 'resent=no'
        die "start: Freebuff refused the brief: $refusal (not resent; worktree kept at $wt)"
    fi
    if [ "$submit_rc" -ne 0 ]; then
        # The brief was typed but never submitted. A session that looks alive
        # and does nothing is the failure this tool exists to prevent, so say
        # sent=no, show the pane the check read, stop the session and fail.
        # The worktree and branch stay, like every other failed launch.
        pane=$("$tmux" capture-pane -p -t "$session" -S -15 2>/dev/null || true)
        ready_note "$wt" "submit=no elapsed=${SUBMIT_ELAPSED}s timeout=${submit_timeout}s poll=${ready_poll}s session=$session"
        "$tmux" kill-session -t "$session" 2>/dev/null || true
        note "session=$session"
        note 'sent=no'
        note 'submit_proof=none'
        note "submit_elapsed=${SUBMIT_ELAPSED}s timeout=${submit_timeout}s"
        note 'resent=no'
        printf '%s\n' '--- pane lines the check read ---'
        printf '%s\n' "$pane"
        die "start: the brief did not prove submission in $session after ${SUBMIT_ELAPSED}s (--submit-timeout $submit_timeout, --ready-poll $ready_poll): the turn never began and the chat title did not change. No keys were retyped, stopped it, worktree kept ($wt)."
    fi

    # Recorded only once the send is proven, so a launch that was swallowed
    # (text nobody saw) never blocks a deliberate retry with that text.
    brief_ledger_record "$brief_hash_value" "$name" "$branch"
    ready_note "$wt" "submit=yes proof=${SUBMIT_PROOF} elapsed=${SUBMIT_ELAPSED}s timeout=${submit_timeout}s poll=${ready_poll}s session=$session"
    note "session=$session"
    note 'sent=yes'
    note "submit_proof=${SUBMIT_PROOF} elapsed=${SUBMIT_ELAPSED}s"
    note "started=yes"
    "$tmux" capture-pane -p -t "$session" -S -8 2>/dev/null || true

    if [ "$autostop" = 1 ]; then
        local script log watcher_pid
        case "$0" in
            */*) script=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") ;;
            *) script=$(command -v "$0" 2>/dev/null || printf '%s' "$0") ;;
        esac
        log="$wt/.supervisor.log"
        # setsid puts the watcher in its own session, so tearing down the
        # caller's process group (a closed terminal, a finished CI step) no
        # longer takes the watcher with it. It is optional; without it nohup
        # still ignores SIGHUP, but the watcher stays in the caller's group.
        if command -v setsid >/dev/null 2>&1; then
            setsid "$script" --root "$ROOT" autostop "$name" \
                --idle-seconds "$idle" --poll "$poll" </dev/null >>"$log" 2>&1 &
        else
            nohup "$script" --root "$ROOT" autostop "$name" \
                --idle-seconds "$idle" --poll "$poll" </dev/null >>"$log" 2>&1 &
        fi
        watcher_pid=$!
        # watcher_state greps .supervisor.log; a note on stdout would never be
        # seen by sessions or status.
        printf 'autostop=pid:%s\n' "$watcher_pid" >>"$log"
        note "autostop=pid:$watcher_pid"
        note "log=$log"
    fi
}

print_explanation() {
    # print_explanation BLOCK -> the classifier's decision as `explain:` lines,
    # including every marker that was checked and the pane it looked at.
    local block="$1" line win='' in_pane=0 rule
    while IFS= read -r line; do
        case "$line" in
            state=*) ;;
            rule=*)
                rule=${line#rule=}
                printf 'explain: rule=%s\n' "$rule"
                [ "$rule" != no-rule-matched ] ||
                    printf 'explain: no rule matched the window\n'
                ;;
            matched=*)
                [ -z "${line#matched=}" ] ||
                    printf 'explain: matched=%s\n' "${line#matched=}"
                ;;
            window_lines=*) win=${line#window_lines=} ;;
            window_sha256=*)
                [ -z "${line#window_sha256=}" ] ||
                    printf 'explain: window=%s lines sha256=%s\n' \
                        "$win" "${line#window_sha256=}"
                ;;
            stable_scans=*) printf 'explain: stable_scans=%s\n' "${line#stable_scans=}" ;;
            check:*) printf 'explain: %s\n' "$line" ;;
            pane_begin) in_pane=1; printf 'explain: pane:\n' ;;
            pane_end) in_pane=0 ;;
            *) [ "$in_pane" = 0 ] || printf '  | %s\n' "$line" ;;
        esac
    done <<<"$block"
}

status() {
    # status NAME -> key=value lines by default, one JSON object with --json.
    # Both views come from the same fields: the JSON is a serialization of the
    # human output, not a second detection path. --explain adds the classifier's
    # decision line by line, from the same evidence block as --json.
    local name="" lines=25 no_gh=0 json=0 explain=0 window="$REFUSAL_WINDOW"
    while [ $# -gt 0 ]; do
        case "$1" in
            --lines) lines=${2:-}; shift 2 ;;
            --window) window=${2:-}; shift 2 ;;
            --no-gh) no_gh=1; shift ;;
            --json) json=1; shift ;;
            --explain) explain=1; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "status: unsupported argument: $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "status: NAME is required"
    valid_name "$name" || die "status: invalid name"
    case "$lines" in
        ''|*[!0-9]*) die "status: --lines must be a number" ;;
    esac
    is_num "$window" || die "status: --window must be a number"

    local wt="$ROOT/.worktrees/$name" branch session tmux running=0 tty mode=unknown
    local state rstate="" pane="" idle="" sstate="" last_commit dirty=no watcher=""
    local result_pr="" result_commit="" result_tests="" prs="" pr_json=null
    local evidence="" ev_rule="" ev_matched="" ev_lines="" ev_sha="" ev_scans=""
    [ -d "$wt" ] || die "status: no worktree at $wt"
    branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
    session="fb-$name"
    tmux=$(tmux_bin 2>/dev/null || true)

    if [ "$json" = 0 ]; then
        printf 'name=%s\nbranch=%s\nworktree=%s\nsession=%s\n' \
            "$name" "$branch" "$wt" "$session"
    fi

    state=$(result_state "$wt")
    [ -n "$state" ] || state=unknown
    watcher=$(watcher_state "$wt")
    if [ "$json" = 0 ]; then
        printf 'state=%s\n' "$state"
        printf 'watcher=%s\n' "$watcher"
    fi
    if [ -f "$wt/$RESULT_FILE" ]; then
        rstate=$state
        result_pr=$(result_key "$wt/$RESULT_FILE" pr)
        result_commit=$(result_key "$wt/$RESULT_FILE" commit)
        result_tests=$(result_key "$wt/$RESULT_FILE" tests)
        if [ "$json" = 0 ]; then
            [ -z "$result_pr" ] || printf 'result_pr=%s\n' "$result_pr"
            [ -z "$result_commit" ] || printf 'result_commit=%s\n' "$result_commit"
            [ -z "$result_tests" ] || printf 'result_tests=%s\n' "$result_tests"
        fi
    fi

    if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
        running=1
        tty=$("$tmux" display-message -p -t "$session" '#{pane_tty}' 2>/dev/null || true)
        if [ -n "$tty" ] && stty -a -F "$tty" 2>/dev/null | grep -q -- '-icanon'; then
            mode=raw
        else
            mode=canonical
        fi
        evidence=$(classify_state "$name" "$window")
        sstate=$(evidence_field "$evidence" state)
        # Only a session that can still be idle has an idle time. The result
        # file outranks the pane, so `state` is the terminal answer even while
        # the TUI process stays alive; `session_state` carries the same verdict
        # on a branch that reports blocked and failed distinctly (#32).
        if ! state_is_terminal "$state" && ! state_is_terminal "$sstate"; then
            idle=$(idle_seconds "$name" || true)
        fi
        pane=$("$tmux" capture-pane -p -t "$session" -S "-$lines" 2>/dev/null || true)
        if [ "$json" = 0 ]; then
            printf 'running=yes\ninput=%s\n' "$mode"
            printf 'session_state=%s\n' "$sstate"
            [ "$explain" = 0 ] || print_explanation "$evidence"
            [ -z "$idle" ] || printf 'idle_seconds=%s\n' "$idle"
        fi
    else
        local sentence
        sstate=missing
        sentence=$(refusal_recorded "$wt")
        # A recorded refusal outlives the session: start stops a refused
        # launch, but status must keep saying refused until stop clears it.
        if [ -n "$sentence" ]; then
            sstate=refused
            printf -v evidence 'state=%s\nrule=recorded-refusal\nmatched=%s\nwindow_lines=0\nwindow_sha256=\nstable_scans=0\ncheck: session (fb-%s): no\ncheck: recorded-refusal (%s): yes\npane_begin\npane_end\n' \
                "$sstate" "$sentence" "$name" "$REFUSAL_FILE"
        else
            printf -v evidence 'state=missing\nrule=no-session\nmatched=\nwindow_lines=0\nwindow_sha256=\nstable_scans=0\ncheck: session (fb-%s): no\npane_begin\npane_end\n' \
                "$name"
        fi
        if [ "$json" = 0 ]; then
            printf 'running=no\nsession_state=%s\n' "$sstate"
            [ "$explain" = 0 ] || print_explanation "$evidence"
        fi
    fi

    last_commit=$(git -C "$wt" log -1 --oneline 2>/dev/null || true)
    if [ -n "$(git -C "$wt" status --short 2>/dev/null || true)" ]; then
        dirty=yes
    else
        dirty=no
    fi
    if [ "$json" = 0 ]; then
        printf 'commit=%s\n' "$last_commit"
        printf 'dirty=%s\n' "$dirty"
    fi

    if [ "$no_gh" = 0 ]; then
        local slug
        slug=$(repo_slug || true)
        if [ -n "$slug" ] && command -v "${GH_BIN:-gh}" >/dev/null 2>&1; then
            prs=$("${GH_BIN:-gh}" pr list -R "$slug" --head "$branch" --state open \
                --json number,url,title \
                --jq '.[] | "pr=#\(.number) \(.url) \(.title)"' 2>/dev/null || true)
            if [ -n "$prs" ]; then
                if [ "$json" = 0 ]; then
                    printf '%s\n' "$prs"
                else
                    pr_json=$(pr_json_array "$prs")
                fi
            else
                if [ "$json" = 0 ]; then
                    printf 'pr=none\n'
                else
                    pr_json='[]'
                fi
            fi
        fi
    fi

    if [ "$json" = 0 ]; then
        # --explain already dumped the classified window, so the tail is not
        # repeated; without it the human view is unchanged.
        [ "$explain" = 1 ] || [ -z "$pane" ] || printf '%s\n' "$pane"
        return 0
    fi

    # The evidence object is additive: `rule` names the decision, `matched`
    # the line behind it, and the hash names the window, so an unknown pane can
    # be compared across scans. `unknown` remains the `state` placeholder for
    # "no result file" as before; the pane classifier's unknown is
    # `session_state`.
    ev_rule=$(evidence_field "$evidence" rule)
    ev_matched=$(evidence_field "$evidence" matched)
    ev_lines=$(evidence_field "$evidence" window_lines)
    ev_sha=$(evidence_field "$evidence" window_sha256)
    ev_scans=$(evidence_field "$evidence" stable_scans)

    # `state` mirrors the human `state=` line, including its `unknown`
    # placeholder; `result_state` is null when there is no result file at all,
    # so a consumer can tell "nothing written yet" from "unusable state".
    printf '{\n'
    printf '  "name": %s,\n' "$(json_str "$name")"
    printf '  "branch": %s,\n' "$(json_str "$branch")"
    printf '  "worktree": %s,\n' "$(json_str "$wt")"
    printf '  "session": %s,\n' "$(json_str "$session")"
    printf '  "state": %s,\n' "$(json_str "$state")"
    printf '  "result_state": %s,\n' "$(json_nullable_str "$rstate")"
    printf '  "result_pr": %s,\n' "$(json_nullable_str "$result_pr")"
    printf '  "result_commit": %s,\n' "$(json_nullable_str "$result_commit")"
    printf '  "result_tests": %s,\n' "$(json_nullable_str "$result_tests")"
    printf '  "running": %s,\n' "$([ "$running" = 1 ] && printf true || printf false)"
    printf '  "input": %s,\n' "$(json_str "$mode")"
    printf '  "session_state": %s,\n' "$(json_str "$sstate")"
    printf '  "idle_seconds": %s,\n' "$(json_nullable_num "$idle")"
    printf '  "watcher": %s,\n' "$(json_nullable_str "$watcher")"
    printf '  "commit": %s,\n' "$(json_nullable_str "$last_commit")"
    printf '  "dirty": %s,\n' "$([ "$dirty" = yes ] && printf true || printf false)"
    printf '  "pr": %s,\n' "$pr_json"
    printf '  "evidence": {\n'
    printf '    "rule": %s,\n' "$(json_nullable_str "$ev_rule")"
    printf '    "matched": %s,\n' "$(json_nullable_str "$ev_matched")"
    printf '    "window_lines": %s,\n' "$(json_nullable_num "$ev_lines")"
    printf '    "window_sha256": %s,\n' "$(json_nullable_str "$ev_sha")"
    printf '    "stable_scans": %s\n' "$(json_nullable_num "$ev_scans")"
    printf '  },\n'
    printf '  "pane": %s\n' "$(json_nullable_str "$pane")"
    printf '}\n'
}

list_agents() {
    local wt name branch session tmux running state idle activity now idle_secs
    local orphans="" orphan
    # Sessions with no worktree are not in the table below; name them so they
    # cannot be reaped by gc --all without ever having been seen.
    while IFS= read -r orphan; do
        [ -n "$orphan" ] || continue
        orphan=${orphan#fb-}
        [ -d "$ROOT/.worktrees/$orphan" ] ||
            orphans="${orphans:+$orphans }$orphan"
    done <<<"$(live_sessions)"

    if [ ! -d "$ROOT/.worktrees" ]; then
        note "no worktrees"
        [ -z "$orphans" ] || note "orphans=$orphans (no worktree; see sessions)"
        return 0
    fi
    tmux=$(tmux_bin 2>/dev/null || true)
    now=$(date +%s)
    printf '%-22s %-30s %-26s %-8s %-10s %s\n' \
        NAME BRANCH SESSION RUNNING STATE IDLE
    for wt in "$ROOT"/.worktrees/*; do
        [ -d "$wt" ] || continue
        name=$(basename "$wt")
        branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')
        session="fb-$name"
        running=no
        state=unknown
        idle=-
        if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
            running=yes
            state=$(session_state "$name")
            if ! state_is_terminal "$state"; then
                activity=$(session_activity "$name" 2>/dev/null || true)
                if is_num "$activity"; then
                    idle_secs=$((now - activity))
                    [ "$idle_secs" -ge 0 ] || idle_secs=0
                    idle="${idle_secs}s"
                fi
            fi
        else
            state=$(result_state "$wt")
            [ -n "$state" ] || state=unknown
            [ -z "$(refusal_recorded "$wt")" ] || state=refused
        fi
        printf '%-22s %-30s %-26s %-8s %-10s %s\n' \
            "$name" "$branch" "$session" "$running" "$state" "$idle"
    done

    [ -z "$orphans" ] || note "orphans=$orphans (no worktree; see sessions)"
}

watcher_state() {
    # watcher_state WORKTREE -> pid:N when the recorded autostop is alive,
    # dead when it was recorded but has gone, - when no watcher ever started
    local wt="$1" pid
    pid=$(grep -o 'autostop=pid:[0-9]*' "$wt/.supervisor.log" 2>/dev/null |
        tail -n 1 | cut -d: -f2 || true)
    [ -n "$pid" ] || {
        printf '%s' '-'
        return 0
    }
    if kill -0 "$pid" 2>/dev/null; then
        printf 'pid:%s' "$pid"
    else
        printf 'dead'
    fi
}

live_sessions() {
    # live_sessions -> fb-* session names, one per line, none when tmux is gone
    local tmux
    tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$tmux" ] || return 0
    "$tmux" list-sessions -F '#{session_name}' 2>/dev/null | grep '^fb-' || true
}

live_session_count() {
    # live_session_count -> number of live fb-* sessions (0 when none)
    local count
    count=$(live_sessions | grep -c . || true)
    printf '%s' "${count:-0}"
}

finished_live() {
    # finished_live NAME [TMUX] -> 0 when the TUI is alive but its run is over.
    # The vendor counts live sessions against the concurrent-session limit, not
    # runs, so a done, blocked or failed session holds a slot that buys nothing.
    # `refused` is not in that set: stop is what clears a refusal, and the pane
    # may still be live under it.
    local name=$1 tmux=${2:-} state
    [ -n "$tmux" ] || tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$tmux" ] || return 1
    "$tmux" has-session -t "fb-$name" 2>/dev/null || return 1
    state=$(session_state "$name")
    state_is_terminal "$state"
}

finished_live_names() {
    # finished_live_names [TMUX] -> the names of finished-but-live sessions,
    # comma-separated, empty when none. `sessions` counts them and a refused
    # `start` names them: the overlay says only that the limit was reached, and
    # the next step is `gc`, not guessing which session to stop.
    local tmux=${1:-} wt name out=''
    [ -n "$tmux" ] || tmux=$(tmux_bin 2>/dev/null || true)
    [ -n "$tmux" ] || return 0
    for wt in "$ROOT"/.worktrees/*; do
        [ -d "$wt" ] || continue
        name=$(basename "$wt")
        finished_live "$name" "$tmux" || continue
        out="${out:+$out,}$name"
    done
    printf '%s' "$out"
}

sessions() {
    # sessions -> one table over every fb-* session and every worktree, so a
    # session with no worktree is visible before gc --all reaps it. --json is a
    # serialization of the same rows: one array of objects, `[]` when empty.
    local no_gh=0 json=0 name wt worktree running state idle activity now idle_secs
    local watcher result branch pr prs="" slug="" tmux total=0 live=0 trees=0
    local finished=no finished_count=0
    local names=() x first=1
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) json=1; shift ;;
            --no-gh) no_gh=1; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "sessions: unsupported argument: $1" ;;
        esac
    done
    tmux=$(tmux_bin 2>/dev/null || true)
    now=$(date +%s)

    while IFS= read -r name; do
        [ -n "$name" ] || continue
        names+=("$name")
    done <<<"$(live_sessions | sed 's/^fb-//')"

    for wt in "$ROOT"/.worktrees/*; do
        [ -d "$wt" ] || continue
        name=$(basename "$wt")
        for x in ${names[@]+"${names[@]}"}; do
            [ "$x" = "$name" ] && continue 2
        done
        names+=("$name")
    done

    if [ ${#names[@]} -eq 0 ]; then
        if [ "$json" = 1 ]; then
            printf '[]\n'
        else
            note 'no sessions'
        fi
        return 0
    fi
    mapfile -t names < <(printf '%s\n' "${names[@]}" | LC_ALL=C sort)

    # One gh call for every branch, instead of one per row.
    if [ "$no_gh" = 0 ]; then
        slug=$(repo_slug || true)
        if [ -n "$slug" ] && command -v "${GH_BIN:-gh}" >/dev/null 2>&1; then
            prs=$("${GH_BIN:-gh}" pr list -R "$slug" --state open \
                --json headRefName,url --jq '.[] | "\(.headRefName) \(.url)"' \
                2>/dev/null || true)
        fi
    fi

    if [ "$json" = 1 ]; then
        printf '[\n'
    elif [ -n "$prs" ]; then
        printf '%-22s %-9s %-8s %-9s %-9s %-9s %-24s %s\n' \
            NAME STATE IDLE WATCHER WORKTREE RESULT BRANCH PR
    else
        printf '%-22s %-9s %-8s %-9s %-9s %-9s %s\n' \
            NAME STATE IDLE WATCHER WORKTREE RESULT BRANCH
    fi

    for name in "${names[@]}"; do
        wt="$ROOT/.worktrees/$name"
        total=$((total + 1))
        idle_secs=""
        pr=""
        if [ -d "$wt" ]; then
            worktree=yes
            trees=$((trees + 1))
            branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || printf '?')
            result=$(result_state "$wt")
            [ -n "$result" ] || result=-
            watcher=$(watcher_state "$wt")
        else
            worktree=missing
            branch=-
            result=-
            watcher=-
        fi
        running=no
        idle=-
        finished=no
        if [ -n "$tmux" ] && "$tmux" has-session -t "fb-$name" 2>/dev/null; then
            running=yes
            live=$((live + 1))
            state=$(session_state "$name")
            # A finished run whose TUI is still alive holds a vendor slot. The
            # count is what a refused start points at; `gc` is what frees it.
            if state_is_terminal "$state"; then
                finished=yes
                finished_count=$((finished_count + 1))
            fi
            # A finished run has no idle time, even while its TUI process is
            # still alive: null in JSON, `-` in the table, no idle on the card.
            if ! state_is_terminal "$state"; then
                activity=$(session_activity "$name" 2>/dev/null || true)
                if is_num "$activity"; then
                    idle_secs=$((now - activity))
                    [ "$idle_secs" -ge 0 ] || idle_secs=0
                    idle="${idle_secs}s"
                fi
            fi
        elif [ "$worktree" = yes ]; then
            state=$(result_state "$wt")
            [ -n "$state" ] || state=stopped
            [ -z "$(refusal_recorded "$wt")" ] || state=refused
        else
            state=-
        fi

        if [ -n "$prs" ] && [ "$branch" != '-' ]; then
            pr=$(printf '%s\n' "$prs" |
                awk -v b="$branch" '$1 == b { print $2; exit }')
        fi

        if [ "$json" = 1 ]; then
            [ "$first" = 1 ] || printf ',\n'
            first=0
            printf '  {\n'
            printf '    "name": %s,\n' "$(json_str "$name")"
            printf '    "state": %s,\n' "$(json_nullable_str "$state")"
            printf '    "idle_seconds": %s,\n' "$(json_nullable_num "$idle_secs")"
            if [ "$finished" = yes ]; then
                printf '    "finished": true,\n'
            else
                printf '    "finished": false,\n'
            fi
            printf '    "watcher": %s,\n' "$(json_nullable_str "$watcher")"
            printf '    "worktree": %s,\n' "$(json_str "$worktree")"
            printf '    "result": %s,\n' "$(json_nullable_str "$result")"
            printf '    "branch": %s,\n' "$(json_nullable_str "$branch")"
            printf '    "pr": %s\n' "$(json_nullable_str "$pr")"
            printf '  }'
        elif [ -n "$prs" ] && [ "$branch" != '-' ]; then
            [ -n "$pr" ] || pr=-
            printf '%-22s %-9s %-8s %-9s %-9s %-9s %-24s %s\n' \
                "$name" "$state" "$idle" "$watcher" "$worktree" "$result" \
                "$branch" "$pr"
        else
            printf '%-22s %-9s %-8s %-9s %-9s %-9s %s\n' \
                "$name" "$state" "$idle" "$watcher" "$worktree" "$result" \
                "$branch"
        fi
    done

    if [ "$json" = 1 ]; then
        printf '\n]\n'
    else
        printf 'sessions=%s running=%s worktrees=%s orphans=%s finished=%s\n' \
            "$total" "$live" "$trees" "$((total - trees))" "$finished_count"
    fi
}

reap() {
    # reap NAME REASON [EXTRA] -> record evidence under .worktrees, then kill
    local name="$1" reason="$2" extra="${3:-}" session="fb-$name"
    local wt="$ROOT/.worktrees/$name" log branch="" tmux pr=unknown slug dirty=no
    local pane=""
    tmux=$(tmux_bin 2>/dev/null || true)
    log="$wt/.supervisor.log"
    if [ ! -d "$wt" ]; then
        log="$ROOT/.worktrees/.orphans.log"
    fi
    mkdir -p "$(dirname "$log")"

    if [ -d "$wt" ]; then
        branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    fi
    slug=$(repo_slug || true)
    if [ -n "$branch" ] && [ -n "$slug" ] &&
        command -v "${GH_BIN:-gh}" >/dev/null 2>&1; then
        pr=$("${GH_BIN:-gh}" pr list -R "$slug" --head "$branch" --state open \
            --json url --jq '.[0].url // "none"' 2>/dev/null || true)
        [ -n "$pr" ] || pr=unknown
    fi
    if [ -d "$wt" ] && [ -n "$(git -C "$wt" status --short 2>/dev/null || true)" ]; then
        dirty=yes
    fi

    if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
        pane=$("$tmux" capture-pane -p -t "$session" -S -120 2>/dev/null || true)
    fi

    {
        printf '\n=== %s stop name=%s reason=%s session=%s ===\n' \
            "$(date -u +%FT%TZ)" "$name" "$reason" "$session"
        [ -z "$branch" ] || printf 'branch=%s\n' "$branch"
        printf 'commit=%s\n' "$(git -C "$wt" log -1 --oneline 2>/dev/null || true)"
        printf 'dirty=%s\n' "$dirty"
        printf 'pr=%s\n' "$pr"
        [ -z "$extra" ] || printf '%s\n' "$extra"
        if [ -n "$pane" ]; then
            printf '%s\n' 'pane:'
            printf '%s\n' "$pane"
        fi
    } >>"$log"

    if [ -n "$tmux" ] && "$tmux" has-session -t "$session" 2>/dev/null; then
        "$tmux" kill-session -t "$session"
        note "stopped=$session reason=$reason log=$log"
    else
        note "stopped=no (session already gone) reason=$reason log=$log"
    fi
    # The stop is what ends a refusal; the sentence stays in the log above.
    clear_refusal "$wt"
}

watch_run() {
    # watch_run NAME IDLE_SECONDS POLL TIMEOUT -> 0 done/idle, 1 timeout,
    # 2 missing, 3 blocked, 4 failed. The result file's own state is the
    # contract; a killed watcher's exit is not read as the run's outcome.
    local name="$1" idle_limit="$2" poll="$3" timeout="$4"
    local tmux session start now state last_state="" pane hash last_hash=""
    local idle_since="" elapsed
    tmux=$(tmux_bin) || die "watch: tmux not found"
    session="fb-$name"
    start=$(date +%s)

    while :; do
        now=$(date +%s)
        if [ "$timeout" -gt 0 ] && [ $((now - start)) -ge "$timeout" ]; then
            note "state=timeout elapsed=$((now - start))s"
            return 1
        fi
        state=$(session_state "$name")
        case "$state" in
            done)
                note 'state=done'
                return 0
                ;;
            blocked)
                note 'state=blocked'
                return 3
                ;;
            failed)
                note 'state=failed'
                return 4
                ;;
            missing)
                note 'state=missing'
                return 2
                ;;
        esac
        if [ "$state" != "$last_state" ]; then
            note "state=$state"
            last_state=$state
        fi
        if [ "$state" = idle ]; then
            pane=$("$tmux" capture-pane -p -t "$session" 2>/dev/null || true)
            hash=$(printf '%s' "$pane" | cksum | cut -d' ' -f1)
            if [ "$hash" != "$last_hash" ]; then
                last_hash=$hash
                idle_since=$now
            fi
            [ -n "$idle_since" ] || idle_since=$now
            elapsed=$((now - idle_since))
            note "state=idle idle_seconds=$elapsed"
            if [ "$elapsed" -ge "$idle_limit" ]; then
                return 0
            fi
        else
            idle_since=""
            last_hash=""
        fi
        sleep "$poll"
    done
}

watch() {
    local name="" idle=120 poll=5 timeout=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --idle-seconds) idle=${2:-}; shift 2 ;;
            --poll) poll=${2:-}; shift 2 ;;
            --timeout) timeout=${2:-}; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) die "watch: unsupported argument: $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "watch: NAME is required"
    valid_name "$name" || die "watch: invalid name"
    is_num "$idle" || die "watch: --idle-seconds must be a number"
    is_num "$poll" || die "watch: --poll must be a number"
    is_num "$timeout" || die "watch: --timeout must be a number"
    watch_run "$name" "$idle" "$poll" "$timeout"
}

autostop() {
    local name="" idle=120 poll=5 timeout=0 rc=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --idle-seconds) idle=${2:-}; shift 2 ;;
            --poll) poll=${2:-}; shift 2 ;;
            --timeout) timeout=${2:-}; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) die "autostop: unsupported argument: $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "autostop: NAME is required"
    valid_name "$name" || die "autostop: invalid name"
    is_num "$idle" || die "autostop: --idle-seconds must be a number"
    is_num "$poll" || die "autostop: --poll must be a number"
    is_num "$timeout" || die "autostop: --timeout must be a number"

    watch_run "$name" "$idle" "$poll" "$timeout" || rc=$?
    case "$rc" in
        # 0 is done or the idle window; 3 and 4 are the result file's blocked
        # and failed. All three end the run, so the watcher still stops the
        # session; the exit status keeps the outcome distinguishable.
        0|3|4) reap "$name" "$(session_state "$name")" ;;
    esac
    return "$rc"
}

gc() {
    local idle_hours=12 dry=0 all=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --idle-hours) idle_hours=${2:-}; shift 2 ;;
            --dry-run) dry=1; shift ;;
            --all) all=1; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "gc: unsupported argument: $1" ;;
        esac
    done
    is_num "$idle_hours" || die "gc: --idle-hours must be a number"

    local tmux now wt name session state idle_secs branch stopped
    local names=() orphans=() listed
    tmux=$(tmux_bin) || die "gc: tmux not found"
    now=$(date +%s)

    for wt in "$ROOT"/.worktrees/*; do
        [ -d "$wt" ] || continue
        names+=("$(basename "$wt")")
    done
    listed=$("$tmux" list-sessions -F '#{session_name}' 2>/dev/null || true)
    while IFS= read -r session; do
        case "$session" in
            fb-*)
                name=${session#fb-}
                [ -d "$ROOT/.worktrees/$name" ] || orphans+=("$name")
                ;;
        esac
    done <<<"$listed"

    for name in ${names[@]+"${names[@]}"}; do
        stopped=0
        state=$(session_state "$name")
        case "$state" in
            missing)
                continue
                ;;
            done|blocked|failed)
                # All three are a finished agent: blocked and failed still stop
                # the session, and the reason names the result state.
                if [ "$dry" = 1 ]; then
                    note "would-stop name=$name reason=$state"
                else
                    note "stop name=$name reason=$state"
                    reap "$name" "$state"
                    stopped=1
                fi
                ;;
            refused)
                if [ "$dry" = 1 ]; then
                    note "would-stop name=$name reason=refused"
                else
                    note "stop name=$name reason=refused"
                    reap "$name" refused
                    stopped=1
                fi
                ;;
            idle)
                idle_secs=$(idle_seconds "$name" 2>/dev/null || true)
                is_num "$idle_secs" || idle_secs=0
                if [ "$idle_secs" -ge $((idle_hours * 3600)) ]; then
                    if [ "$dry" = 1 ]; then
                        note "would-stop name=$name reason=idle idle_seconds=$idle_secs"
                    else
                        note "stop name=$name reason=idle"
                        reap "$name" idle
                        stopped=1
                    fi
                else
                    note "skip name=$name reason=idle idle_seconds=$idle_secs"
                fi
                ;;
            unknown)
                # No rule matched, so nothing is known about this pane. Skipping
                # it is the same safe choice as a busy pane: gc never reaps a
                # session it cannot read.
                note "skip name=$name reason=unknown"
                ;;
            *)
                note "skip name=$name reason=busy"
                ;;
        esac
        if [ "$dry" = 0 ] && [ "$stopped" = 1 ]; then
            branch=$(git -C "$ROOT/.worktrees/$name" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
            [ -z "$branch" ] ||
                note "cleanup=git worktree remove .worktrees/$name && git branch -d $branch"
        fi
    done

    for name in ${orphans[@]+"${orphans[@]}"}; do
        if [ "$all" = 1 ]; then
            if [ "$dry" = 1 ]; then
                note "would-stop name=$name reason=orphan"
            else
                note "stop name=$name reason=orphan"
                reap "$name" orphan
            fi
        else
            note "skip name=$name reason=orphan (use --all)"
        fi
    done
}

gui() {
    # Two modes over the same inventory:
    #   --snapshot FILE [--watch N] [--no-gh]      write one page
    #   --serve [--port N] [--host H] [--token T]  serve that page and the API
    # The server itself is gui/server.py; python3 stays optional so the rest
    # of the CLI works on a host that does not have it.
    local snapshot='' watch='' no_gh=0 serve=0 first=1 json args py dir
    local links='' note_text='' ttyd=0 interactive=0
    local form_nonce='' flash_file='' flash_text=''
    local passthrough=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --snapshot) snapshot=${2:-}; shift 2 ;;
            --watch) watch=${2:-}; shift 2 ;;
            --no-gh) no_gh=1; shift ;;
            --serve) serve=1; shift ;;
            --ttyd) ttyd=1; passthrough+=(--ttyd); shift ;;
            --interactive) interactive=1; passthrough+=(--interactive); shift ;;
            --terminal-links) links=/tty/; shift ;;
            --terminal-note) note_text=${2:-}; shift 2 ;;
            --form-nonce) form_nonce=${2:-}; shift 2 ;;
            --flash-file) flash_file=${2:-}; shift 2 ;;
            --port|--host|--token|--allow-host)
                [ $# -ge 2 ] || die "gui: $1 needs a value"
                passthrough+=("$1" "$2"); shift 2 ;;
            --read-only) passthrough+=(--read-only); shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "gui: unsupported argument: $1" ;;
        esac
    done

    if [ "$serve" = 0 ] && { [ "$ttyd" = 1 ] || [ "$interactive" = 1 ]; }; then
        die "gui: --ttyd and --interactive belong to --serve"
    fi

    if [ "$serve" = 1 ]; then
        [ -z "$snapshot" ] ||
            die "gui: --serve and --snapshot are separate modes"
        py=$(command -v python3 2>/dev/null || true)
        [ -n "$py" ] ||
            die "gui: --serve needs python3 (pkg install python on Termux); the rest of the CLI works without it"
        case "$0" in
            */*) dir=$(cd "$(dirname "$0")" && pwd) ;;
            *) dir=$(cd "$(dirname "$(command -v "$0" 2>/dev/null || printf '%s' "$0")")" && pwd) ;;
        esac
        [ -f "$dir/gui/server.py" ] ||
            die "gui: gui/server.py is missing next to the tool"
        exec "$py" "$dir/gui/server.py" --root "$ROOT" \
            ${passthrough[@]+"${passthrough[@]}"}
    fi

    [ -n "$snapshot" ] || die "gui: --snapshot FILE or --serve is required"
    if [ -n "$watch" ]; then
        is_num "$watch" || die "gui: --watch must be a number"
        [ "$watch" -ge 1 ] || die "gui: --watch must be at least 1 second"
    fi
    mkdir -p "$(dirname "$snapshot")"
    while :; do
        args=(--json)
        if [ "$no_gh" = 1 ]; then
            args+=(--no-gh)
        fi
        json=$(sessions "${args[@]}")
        flash_text=''
        if [ -n "$flash_file" ] && [ -f "$flash_file" ]; then
            flash_text=$(cat "$flash_file")
        fi
        snapshot_html "$snapshot" "$json" "$watch" "$links" "$note_text" \
            "$form_nonce" "$flash_text"
        if [ "$first" = 1 ]; then
            note "snapshot=$snapshot"
            [ -z "$watch" ] || note "watch_seconds=$watch"
            first=0
        fi
        [ -n "$watch" ] || return 0
        sleep "$watch"
    done
}

attach() {
    local name=${1:-} tmux
    [ -n "$name" ] || die "attach: NAME is required"
    valid_name "$name" || die "attach: invalid name"
    [ -t 0 ] && [ -t 1 ] || die "attach: needs a terminal"
    tmux=$(tmux_bin) || die "attach: tmux not found"
    exec "$tmux" attach -t "fb-$name"
}

send() {
    local name=${1:-} text=${2:-} tmux pane
    [ -n "$name" ] || die "send: NAME is required"
    valid_name "$name" || die "send: invalid name"
    [ -n "$text" ] || die "send: TEXT is required"
    tmux=$(tmux_bin) || die "send: tmux not found"
    "$tmux" has-session -t "fb-$name" 2>/dev/null ||
        die "send: session fb-$name is not running"
    # The overlay's Enter takes over and stops another live session. Never
    # type into it: a follow-up is not worth killing a sibling agent.
    pane=$("$tmux" capture-pane -p -t "fb-$name" -S "-$REFUSAL_WINDOW" 2>/dev/null || true)
    if printf '%s\n' "$pane" | grep -qiE "$REFUSAL_OVERLAY_RE"; then
        die "send: fb-$name is on the concurrent-session overlay; no keys were sent (Enter would take over another session; stop it first)"
    fi
    "$tmux" send-keys -t "fb-$name" -l "$text"
    sleep 0.2
    "$tmux" send-keys -t "fb-$name" C-m
}

stop() {
    local name="" tmux graceful=0 wait=20 initial state deadline interrupted=no
    while [ $# -gt 0 ]; do
        case "$1" in
            --graceful) graceful=1; shift ;;
            --wait) wait=${2:-}; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) die "stop: unsupported argument: $1" ;;
            *) name=$1; shift ;;
        esac
    done
    [ -n "$name" ] || die "stop: NAME is required"
    valid_name "$name" || die "stop: invalid name"
    is_num "$wait" || die "stop: --wait must be a number"
    tmux=$(tmux_bin) || die "stop: tmux not found"

    if ! "$tmux" has-session -t "fb-$name" 2>/dev/null; then
        # The session may already be gone after a refused launch; stop is
        # still the action that clears the recorded refusal.
        clear_refusal "$ROOT/.worktrees/$name"
        note "stopped=no (fb-$name not running)"
        return 0
    fi

    if [ "$graceful" = 0 ]; then
        "$tmux" kill-session -t "fb-$name"
        clear_refusal "$ROOT/.worktrees/$name"
        note "stopped=fb-$name"
        return 0
    fi

    # Graceful: end the turn with Escape, then wait for the resting prompt, so
    # a kill cannot land between an edit and its commit unnoticed.
    initial=$(session_state "$name")
    case "$initial" in
        working|unknown)
            # An unknown pane is unreadable, not finished: interrupt it like a
            # busy turn and refuse the kill below if it never settles.
            "$tmux" send-keys -t "fb-$name" Escape
            interrupted=yes
            note 'graceful=escape'
            ;;
        *) note "graceful=already-$initial" ;;
    esac
    deadline=$(( $(date +%s) + wait ))
    while :; do
        state=$(session_state "$name")
        case "$state" in
            done|blocked|failed|idle|refused|missing) break ;;
        esac
        if [ "$(date +%s)" -ge "$deadline" ]; then
            break
        fi
        sleep 1
    done
    if [ "$state" = working ] || [ "$state" = unknown ]; then
        note "graceful=no state=$state waited=${wait}s"
        note "still busy: nothing was stopped; use plain 'stop $name' to kill it"
        return 1
    fi
    reap "$name" graceful \
        "pane_state=$state interrupted=$interrupted waited=${wait}s"
}

# --root is accepted before the subcommand so tests can point at a temp repo.
ROOT="${FREEBUFF_SUPERVISOR_ROOT:-}"
args=("$@")
while [ ${#args[@]} -gt 0 ]; do
    case "${args[0]}" in
        --root)
            [ ${#args[@]} -ge 2 ] || die "--root needs a directory"
            ROOT=${args[1]}
            args=("${args[@]:2}")
            ;;
        *) break ;;
    esac
done
set -- "${args[@]}"

# Help is about the tool, not about a checkout: answer it before the root
# lookup, so `--help` works from any directory (and the suites can run from
# anywhere, not only from inside the repo).
case "${1:-}" in
    -h|--help|help) usage; exit 0 ;;
esac

if [ -z "$ROOT" ]; then
    ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
fi
[ -n "$ROOT" ] || die "not inside a git repository"
[ -d "$ROOT" ] || die "root does not exist: $ROOT"

cmd=${1:-}
if [ $# -gt 0 ]; then
    shift
fi
case "$cmd" in
    start) start "$@" ;;
    status) status "$@" ;;
    list|ls) list_agents "$@" ;;
    sessions|ps) sessions "$@" ;;
    gui) gui "$@" ;;
    attach) attach "$@" ;;
    send) send "$@" ;;
    watch) watch "$@" ;;
    autostop) autostop "$@" ;;
    gc) gc "$@" ;;
    stop) stop "$@" ;;
    -h|--help|help) usage ;;
    '') usage; exit 2 ;;
    *) die "unknown command: $cmd (try --help)" ;;
esac
